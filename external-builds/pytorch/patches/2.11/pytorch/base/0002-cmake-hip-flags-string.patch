From 11c2dad98bf88a68c60f033b0e4483d767311641 Mon Sep 17 00:00:00 2001
From: TheRock <dev@therock>
Date: Sat, 25 Jul 2026 01:48:12 -0400
Subject: [PATCH] Make CMAKE_HIP_FLAGS a space-separated string for native HIP
 (2.11)

---
 cmake/Dependencies.cmake | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/cmake/Dependencies.cmake b/cmake/Dependencies.cmake
index a0e920b..0988a76 100644
--- a/cmake/Dependencies.cmake
+++ b/cmake/Dependencies.cmake
@@ -1060,7 +1060,11 @@ if(USE_ROCM)
     list(APPEND HIP_HIPCC_FLAGS -fclang-abi-compat=17)
 
     set(HIP_CLANG_FLAGS ${HIP_CXX_FLAGS})
-    set(CMAKE_HIP_FLAGS ${HIP_HIPCC_FLAGS})
+    # TheRock: CMAKE_HIP_FLAGS must be a space-separated string, not a CMake ;-list,
+    # otherwise the entire list is passed to clang as a single argument and breaks
+    # native-HIP compiles (e.g. gloo/torch_hip) once HIP is a CMake language.
+    # See ROCm/TheRock#6102.
+    string(REPLACE ";" " " CMAKE_HIP_FLAGS "${HIP_HIPCC_FLAGS}")
     # Ask hcc to generate device code during compilation so we can use
     # host linker to link.
     list(APPEND HIP_CLANG_FLAGS -fno-gpu-rdc)
-- 
2.34.1

