#!/usr/bin/env python3
"""
GPG shim for remote RPM signing.

This script acts as a drop-in replacement for gpg, intercepting signing requests
from rpmsign and forwarding them to a remote signing server via REST API.

The shim minimizes data transfer by:
- Only sending the digest/hash to be signed (not the full RPM)
- Deduplicating any repeated data in the signing process
- Using standard library modules for zero additional dependencies
"""

import sys
import os
import hashlib
import json
import time
import random
import tempfile
import argparse
import logging
from urllib.error import HTTPError, URLError
from base64 import b64encode, b64decode

# _signing_client.py is a sibling file in this same directory — gpgshim is
# always invoked from its checked-out location in CI (never copied to a
# separate install path), so this import is reliable. See _signing_client.py
# for why the SigV4/HTTP logic lives there rather than duplicated here.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _signing_client


class GPGShim:
    def __init__(self):
        # Transport configuration (direct-HTTP vs SigV4/API-Gateway, TLS,
        # timeout) is shared with repo_utils.py's metadata signing — see
        # _signing_client.py. gpgshim-specific config (key_id, tier, retry
        # policy) stays here.
        self.config = _signing_client.SigningClientConfig.from_env()
        self.key_id = os.environ.get("GPG_KEY_ID", "")

        # Retry configuration
        self.max_retries = int(os.environ.get("GPG_MAX_RETRIES", "5"))
        self.initial_backoff = float(os.environ.get("GPG_INITIAL_BACKOFF", "0.1"))
        self.max_backoff = float(os.environ.get("GPG_MAX_BACKOFF", "10.0"))

        # Simplified API: GPG_TIER maps to tier in authorization.json key_aliases.
        # If set, the request uses {"tier": ..., "artifact": "rpm"} instead of
        # {"key_id": ...}. GPG_KEY_ID is still supported as a fallback.
        self.tier = os.environ.get("GPG_TIER", "")

        # Cache for deduplication (session-based)
        self.data_cache = {}

        # Setup logging - GPG_SHIM_DEBUG should be a filename
        self.logger = logging.getLogger("gpgshim")
        debug_file = os.environ.get("GPG_SHIM_DEBUG")
        if debug_file:
            self.logger.setLevel(logging.DEBUG)
            handler = logging.FileHandler(debug_file, mode="a")
            handler.setFormatter(logging.Formatter("+ %(message)s"))
            self.logger.addHandler(handler)
        else:
            self.logger.setLevel(logging.CRITICAL)  # Effectively disabled

    def parse_args(self, args):
        """Parse gpg command line arguments using argparse."""
        parser = argparse.ArgumentParser(add_help=False)

        # Flags we care about
        parser.add_argument(
            "-b", "--detach-sign", "-s", action="store_true", dest="detach_sign"
        )
        parser.add_argument("-a", "--armor", action="store_true")
        parser.add_argument("--batch", "--no-tty", action="store_true", dest="batch")
        parser.add_argument("-u", "--local-user", dest="local_user")
        parser.add_argument("-o", "--output", dest="output")
        parser.add_argument("--digest-algo", default="SHA256", dest="digest_algo")
        parser.add_argument("--passphrase-fd", dest="passphrase_fd")
        parser.add_argument("--status-fd", dest="status_fd")

        # Parse known args, ignore unknown (GPG has many flags we don't care about)
        parsed_args, unknown = parser.parse_known_args(args)

        # Convert to dict for backward compatibility
        result = {
            "detach_sign": parsed_args.detach_sign,
            "armor": parsed_args.armor,
            "batch": parsed_args.batch,
            "local_user": parsed_args.local_user,
            "output": parsed_args.output,
            "digest_algo": (
                parsed_args.digest_algo.upper() if parsed_args.digest_algo else "SHA256"
            ),
            "passphrase_fd": parsed_args.passphrase_fd,
            "status_fd": parsed_args.status_fd,
            "unknown_args": unknown,
        }

        return result

    def _extract_plaintext_arg(self, raw_args):
        """Return the RPM-GPG plaintext-filename positional argument — the
        single argument after the last '--' separator in the raw argv — or
        None if that shape isn't present. Operates on the raw args (not
        argparse's parsed output) since this is specifically about what RPM
        put after '--', independent of which flags we recognize."""
        if "--" not in raw_args:
            return None
        last_sep = len(raw_args) - 1 - raw_args[::-1].index("--")
        trailing = raw_args[last_sep + 1 :]
        if len(trailing) != 1:
            return None
        return trailing[0]

    def read_stdin_data(self):
        """Read data from stdin (binary mode)."""
        # stdin might be text mode, get the underlying binary buffer
        if hasattr(sys.stdin, "buffer"):
            return sys.stdin.buffer.read()
        else:
            return sys.stdin.read().encode("latin1")

    def compute_hash(self, data):
        """Compute hash of data for deduplication."""
        return hashlib.sha256(data).hexdigest()

    def compute_digest(self, data, algo):
        """Compute digest of data using specified algorithm."""
        algo = algo.upper()

        # Map GPG digest names to hashlib names
        algo_map = {
            "SHA256": "sha256",
            "SHA384": "sha384",
            "SHA512": "sha512",
            "SHA1": "sha1",
            "MD5": "md5",
            "SHA224": "sha224",
        }

        hashlib_algo = algo_map.get(algo, "sha256")

        try:
            h = hashlib.new(hashlib_algo)
            h.update(data)
            return h.digest()
        except ValueError:
            # Fallback to SHA256 if algorithm not supported
            h = hashlib.sha256()
            h.update(data)
            return h.digest()

    def sign_remote(self, data, options):
        """Send signing request to remote server with exponential backoff retry."""
        digest_algo = options.get("digest_algo", "SHA256")

        # Compute hash for deduplication cache
        data_hash = self.compute_hash(data)

        # Check if we've already signed this exact data
        if data_hash in self.data_cache:
            return self.data_cache[data_hash]

        # Prepare request payload.
        # Simplified API: use tier+artifact when GPG_TIER is set.
        # Legacy API: use key_id directly (GPG_KEY_ID or --local-user arg).
        # artifact is always 'rpm' for gpgshim — it only handles rpmsign calls.
        if self.tier:
            payload = {
                "data": b64encode(data).decode("ascii"),
                "tier": self.tier,
                "artifact": "rpm",
            }
        else:
            payload = {
                "data": b64encode(data).decode("ascii"),
                "key_id": options.get("local_user") or self.key_id,
                "digest_algo": digest_algo,
                "armor": options.get("armor", False),
            }

        # Retry with exponential backoff
        backoff = self.initial_backoff
        last_error = None

        for attempt in range(self.max_retries):
            try:
                return self._make_signing_request(payload, options, data_hash)

            except HTTPError as e:
                if e.code == 503:
                    # Server busy - retry with exponential backoff
                    if attempt < self.max_retries - 1:
                        # Add jitter to prevent thundering herd
                        jitter = random.uniform(0, backoff * 0.1)
                        sleep_time = backoff + jitter

                        self.logger.debug(
                            "Server busy (503), retrying in {:.2f}s (attempt {}/{})".format(
                                sleep_time, attempt + 1, self.max_retries
                            )
                        )

                        time.sleep(sleep_time)
                        backoff = min(backoff * 2, self.max_backoff)
                        continue
                    else:
                        last_error = "Server busy after {} retries".format(
                            self.max_retries
                        )
                        break
                elif e.code == 401:
                    # Authentication failed - don't retry
                    last_error = "Authentication failed: Invalid or missing token"
                    try:
                        error_detail = json.loads(e.read().decode("utf-8"))
                        if "error" in error_detail:
                            last_error = "Authentication failed: {}".format(
                                error_detail["error"]
                            )
                    except:
                        pass
                    break
                elif e.code == 403:
                    # Authorization failed - don't retry
                    last_error = "Authorization failed: Access denied"
                    try:
                        error_detail = json.loads(e.read().decode("utf-8"))
                        if "error" in error_detail:
                            last_error = "Authorization failed: {}".format(
                                error_detail["error"]
                            )
                    except:
                        pass
                    break
                elif e.code == 429:
                    # Rate limited - could retry with backoff, but treat as error for now
                    last_error = "Rate limit exceeded"
                    try:
                        error_detail = json.loads(e.read().decode("utf-8"))
                        if "error" in error_detail:
                            last_error = "Rate limit exceeded: {}".format(
                                error_detail["error"]
                            )
                    except:
                        pass
                    break
                else:
                    # Other HTTP error - don't retry
                    last_error = "HTTP error: {} {}".format(e.code, e.reason)
                    try:
                        error_detail = e.read().decode("utf-8")
                        last_error += "\n{}".format(error_detail)
                    except:
                        pass
                    break

            except (URLError, Exception) as e:
                # Network error or other exception
                if attempt < self.max_retries - 1:
                    # Retry network errors with backoff
                    jitter = random.uniform(0, backoff * 0.1)
                    sleep_time = backoff + jitter

                    self.logger.debug(
                        "Network error: {}, retrying in {:.2f}s (attempt {}/{})".format(
                            str(e), sleep_time, attempt + 1, self.max_retries
                        )
                    )

                    time.sleep(sleep_time)
                    backoff = min(backoff * 2, self.max_backoff)
                    continue
                else:
                    last_error = "Network error after {} retries: {}".format(
                        self.max_retries, str(e)
                    )
                    break

        # All retries exhausted
        if last_error:
            self.error(last_error)
        return None

    def _make_signing_request(self, payload, options, digest_hash):
        """Make a single signing request to the server.

        Delegates the actual transport (direct-HTTP or SigV4/API-Gateway,
        chosen by self.config) to _signing_client.send_signing_request() —
        see that module for the one shared implementation. This method keeps
        the gpgshim-specific concerns: signature caching and GPG status-fd
        output.
        """
        result = _signing_client.send_signing_request(
            self.config, payload, user_agent="gpgshim/2.0"
        )

        if "signature" not in result:
            raise ValueError(
                "Invalid response from signing server: missing 'signature' field"
            )

        signature = b64decode(result["signature"])

        # Cache the result
        self.data_cache[digest_hash] = signature

        # Write status information if requested
        if options.get("status_fd"):
            self.write_status(options["status_fd"], result.get("key_id", ""))

        return signature

    def write_status(self, fd, key_id):
        """Write GPG status messages to the specified file descriptor."""
        try:
            import time

            fd_num = int(fd)
            status_file = os.fdopen(fd_num, "w")
            # Mimic GPG status output
            status_file.write(
                "[GNUPG:] SIG_CREATED D 1 8 00 {0} {1}\n".format(
                    int(time.time()), key_id
                )
            )
            status_file.flush()
        except:
            pass  # Ignore status write errors

    def error(self, message):
        """Write error message to stderr."""
        sys.stderr.write("gpgshim: {}\n".format(message))
        sys.stderr.flush()

    # ------------------------------------------------------------------
    # ppid-based signature cache
    #
    # rpmsign's header-sign and payload-sign calls share one parent PID,
    # which is what makes ppid a useful correlation key across the two
    # separate gpgshim invocations. But ppid alone is NOT a safe cache
    # key: PIDs are reused by the OS, and rpmsign can legitimately ask
    # for a signature over genuinely different bytes under the same
    # ppid (e.g. a header-only signature vs. a header+payload
    # signature). A cache keyed purely on ppid would then silently
    # return a signature that is valid for different data than what's
    # actually being signed. Every cache entry is therefore tagged with
    # an identity (data digest + key/tier + digest algorithm) and is
    # only ever used when that identity matches exactly — a mismatch
    # (stale entry, PID reuse, or genuinely different data) always falls
    # back to a fresh, correct signing request instead of reusing the
    # wrong bytes.
    # ------------------------------------------------------------------

    def _cache_file_path(self):
        """Path for this invocation's cache entry, in a private,
        owner-only directory — or None if that directory can't be
        trusted (wrong owner/permissions), in which case caching is
        simply disabled for this run rather than risking a shared or
        tampered location.
        """
        cache_dir = os.path.join(
            tempfile.gettempdir(), "gpgshim-cache-{}".format(os.getuid())
        )
        try:
            os.makedirs(cache_dir, mode=0o700, exist_ok=True)
            st = os.stat(cache_dir)
            if st.st_uid != os.getuid() or (st.st_mode & 0o777) != 0o700:
                self.logger.debug(
                    "cache dir {} has unexpected owner/permissions — "
                    "disabling caching for this invocation".format(cache_dir)
                )
                return None
        except OSError as e:
            self.logger.debug(
                "could not prepare cache dir {}: {} — disabling caching".format(
                    cache_dir, e
                )
            )
            return None
        return os.path.join(cache_dir, "{}.sig".format(os.getppid()))

    def _cache_identity(self, data, options, digest_algo):
        """Everything that must match for a cached signature to be
        valid for the current call: the exact bytes being signed, and
        the key/tier and digest algorithm requested.
        """
        key = self.tier if self.tier else (options.get("local_user") or self.key_id)
        return "{}:{}:{}".format(self.compute_hash(data), key, digest_algo)

    def _read_cache(self, cache_file, identity):
        """Return the cached signature only if its stored identity
        matches exactly; otherwise None — never a partial or guessed
        match. Always consumes (deletes) the entry, so a mismatched or
        corrupt file can't be misread by a later, unrelated invocation
        that happens to reuse this PID.
        """
        try:
            with open(cache_file, "rb") as f:
                header = f.readline()
                signature = f.read()
        except (IOError, OSError):
            return None

        try:
            os.unlink(cache_file)
        except OSError:
            pass

        try:
            cached_identity = header.decode("utf-8").rstrip("\n")
        except UnicodeDecodeError:
            cached_identity = None

        if cached_identity != identity:
            self.logger.debug(
                "cache entry found but identity does not match (stale "
                "entry or PID reuse) — ignoring, will sign fresh"
            )
            return None

        self.logger.debug("cache hit: identity matches, reusing signature")
        return signature

    def _write_cache(self, cache_file, identity, signature):
        """Write the (identity, signature) pair atomically — a
        temp file plus rename, so a reader can never observe a
        partially-written entry.
        """
        tmp_path = "{}.tmp{}".format(cache_file, os.getpid())
        try:
            fd = os.open(tmp_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write("{}\n".format(identity).encode("utf-8"))
                f.write(signature)
            os.replace(tmp_path, cache_file)
            self.logger.debug("cached signature to: {}".format(cache_file))
        except OSError as e:
            self.logger.debug("failed to cache signature: {}".format(e))
            try:
                os.unlink(tmp_path)
            except OSError:
                pass

    def run(self, args):
        """Main entry point."""
        self.logger.debug(
            "gpgshim invoked (pid={}, ppid={})".format(os.getpid(), os.getppid())
        )
        self.logger.debug("args: {}".format(args))

        # Handle --version probe: rpmsign calls 'gpg --version' before signing
        # to verify the binary exists and is functional. Return a minimal gpg-
        # compatible version string and exit immediately without reading stdin.
        if args and args[0] in ("--version", "-v"):
            sys.stdout.write("gpg (GnuPG) 2.2.0 [gpgshim]\n")
            sys.stdout.flush()
            return 0

        options = self.parse_args(args)

        self.logger.debug("parsed options:")
        for key, value in options.items():
            self.logger.debug("  {}: {}".format(key, value))

        # RPM's %__gpg_sign_cmd invokes us with the plaintext-to-sign as the
        # last positional argument, after a '--' separator. Debian/Ubuntu's
        # packaged rpm (what CI's build-runner image uses) sets that
        # argument to a literal '-' — GPG's own convention for "read from
        # stdin" — so RPM itself pipes the data into our stdin rather than
        # passing a real file/FIFO path. This was verified live against a
        # real signing server and rpm --checksig (see
        # signing_infrastructure/docs/signing-server-review.md, B1/B2).
        #
        # That '-' convention is a property of this specific RPM packaging,
        # not of RPM in general — a future base-image change could switch
        # %__plaintext_filename to a real path instead. Check for that
        # explicitly and fail loudly rather than silently reading the wrong
        # (likely empty) stdin and producing a signature over nothing.
        plaintext_arg = self._extract_plaintext_arg(args)
        if plaintext_arg != "-":
            self.error(
                "Unsupported RPM/GPG invocation: expected the plaintext "
                "argument to be '-' (read from stdin), got {!r} instead. "
                "This usually means the RPM packaging on this host changed "
                "%__plaintext_filename to a real file/FIFO path — gpgshim "
                "needs to be updated to read that path directly instead of "
                "stdin.".format(plaintext_arg)
            )
            return 1

        output_file = options.get("output")
        cache_file = self._cache_file_path() if output_file else None

        self.logger.debug("reading data from stdin...")

        data = self.read_stdin_data()

        if not data:
            self.error("No data received on stdin")
            return 1

        self.logger.debug("read {} bytes from stdin".format(len(data)))

        # A cache hit is only ever a hit if the stored identity (data
        # digest + key/tier + digest algorithm) matches this exact call —
        # see _read_cache()'s docstring for why ppid alone is unsafe.
        digest_algo = options.get("digest_algo", "SHA256")
        cache_identity = self._cache_identity(data, options, digest_algo)
        cached_signature = (
            self._read_cache(cache_file, cache_identity) if cache_file else None
        )

        if cached_signature is not None:
            self.logger.debug(
                "using cached signature (not sending {} bytes to server)".format(
                    len(data)
                )
            )
            signature = cached_signature
        else:
            # No valid cache entry - perform remote signing
            self.logger.debug(
                "calling sign_remote() with {} bytes...".format(len(data))
            )

            signature = self.sign_remote(data, options)

            if signature is None:
                self.logger.debug("sign_remote() returned None (failed)")
                return 1

            self.logger.debug("received signature ({} bytes)".format(len(signature)))

            # Cache signature for potential second call from rpmsign
            if cache_file:
                self._write_cache(cache_file, cache_identity, signature)

        # Write signature to output file or stdout (both as binary)
        if output_file:
            self.logger.debug("writing signature to file: {}".format(output_file))
            # Write to specified file
            try:
                with open(output_file, "wb") as f:
                    f.write(signature)
                self.logger.debug(
                    "successfully wrote {} bytes to {}".format(
                        len(signature), output_file
                    )
                )
            except IOError as e:
                self.error("Failed to write to {}: {}".format(output_file, str(e)))
                return 1
        else:
            self.logger.debug("writing signature to stdout")
            # Write to stdout (binary)
            sys.stdout.buffer.write(signature)
            sys.stdout.buffer.flush()

        self.logger.debug("gpgshim completed successfully (exit 0)")

        return 0


def main():
    shim = GPGShim()
    exit_code = shim.run(sys.argv[1:])
    sys.exit(exit_code)


if __name__ == "__main__":
    main()
