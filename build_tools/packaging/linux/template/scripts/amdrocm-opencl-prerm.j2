#!/bin/bash
set -e

do_unregister_icd() {
    local icd_dir="/etc/OpenCL/vendors"
    local icd_file

    # Must match the name generated by amdrocm-opencl-postinst.j2.
    icd_file="${icd_dir}/amdocl64_$(printf '%d%02d' \
        {{ version_major }} {{ version_minor }}).icd"

    rm -f "$icd_file"
}

{% if target == "deb" %}

case "$1" in
    remove|upgrade)
        # On upgrade the outgoing prerm runs before the incoming package is
        # unpacked and configured, so the new postinst re-creates the
        # registration afterwards.
        do_unregister_icd
        ;;
    *)
        exit 0
        ;;
esac

{% else %}

# RPM %preun receives 0 on a final erase and 1 on an upgrade
if [ "${1:-0}" -eq 0 ]; then
    do_unregister_icd
fi

{% endif %}