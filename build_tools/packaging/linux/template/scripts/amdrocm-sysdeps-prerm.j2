#!/bin/bash
{% include "template/scripts/_alternatives_lib.j2" %}
{% if target == "deb" %}
case "$1" in
    (remove|upgrade) alt_remove ;;
    (*) : ;;
esac
{% else %}
# rpm: $1 is the remaining-install count; remove only on true uninstall.
if [ "${1:-0}" = "0" ]; then alt_remove; fi
{% endif %}
exit 0
