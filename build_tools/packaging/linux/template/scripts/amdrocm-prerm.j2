#!/bin/bash

is_debian_like() {
    local id_like="$1"

    case " $id_like " in
        (*" debian "*|*" ubuntu "*)
            return 0
            ;;
        (*)
            return 1
            ;;
    esac
}

do_remove_alternatives() {
    # Skip update if update-alternatives does not exist.
    command -v update-alternatives >/dev/null || return 0

{% if target == "deb" %}
    PKG_INSTALL_PREFIX={{ install_prefix }}
{% else %}
    PKG_INSTALL_PREFIX="$RPM_INSTALL_PREFIX0"
{% endif %}

    # Remove package-specific binary alternatives first.
{% for binary in binaries %}
    update-alternatives --remove \
        "{{ binary }}" \
        "$PKG_INSTALL_PREFIX/bin/{{ binary }}" \
        || true
{% endfor %}

{% if core_symlinks %}
    # Remove /opt/rocm/core and /opt/rocm/core-<major>.
    update-alternatives --remove \
        "core" \
        "$PKG_INSTALL_PREFIX" \
        || true

    update-alternatives --remove \
        "core-{{ version_major }}" \
        "$PKG_INSTALL_PREFIX" \
        || true

    # Remove /opt/rocm/bin, /opt/rocm/lib, and /opt/rocm/include.
    update-alternatives --remove \
        "rocm-bin" \
        "$PKG_INSTALL_PREFIX/bin" \
        || true

    update-alternatives --remove \
        "rocm-lib" \
        "$PKG_INSTALL_PREFIX/lib" \
        || true

    update-alternatives --remove \
        "rocm-include" \
        "$PKG_INSTALL_PREFIX/include" \
        || true

    # Remove /opt/rocm/libexec and /opt/rocm/share.
    update-alternatives --remove \
        "rocm-libexec" \
        "$PKG_INSTALL_PREFIX/libexec" \
        || true

    update-alternatives --remove \
        "rocm-share" \
        "$PKG_INSTALL_PREFIX/share" \
        || true
{% endif %}

{% if llvm_symlinks %}
    # Remove /opt/rocm/llvm and /opt/rocm/amdgcn.
    update-alternatives --remove \
        "rocm-llvm" \
        "$PKG_INSTALL_PREFIX/llvm" \
        || true

    update-alternatives --remove \
        "rocm-amdgcn" \
        "$PKG_INSTALL_PREFIX/amdgcn" \
        || true
{% endif %}
}

{% if opencl_icd %}
do_unregister_icd() {
    local icd_dir="/etc/OpenCL/vendors"
    local icd_file

    # Must match the name generated by amdrocm-postinst.j2.
    icd_file="${icd_dir}/amdocl64_$(printf '%d%02d' \
        {{ version_major }} {{ version_minor }}).icd"

    rm -f "$icd_file"
}
{% endif %}

if [ -e /etc/os-release ] &&
   source /etc/os-release &&
   is_debian_like "${ID_LIKE:-$ID}"
then
    case "$1" in
        remove|upgrade)
            do_remove_alternatives
{% if opencl_icd %}
            # On upgrade the outgoing prerm runs before the incoming package
            # is unpacked and configured, so the new postinst re-creates the
            # registration afterwards.
            do_unregister_icd
{% endif %}
            ;;

        purge)
            # Nothing to do.
            ;;

        *)
            exit 0
            ;;
    esac
else
    do_remove_alternatives
{% if opencl_icd %}
    # RPM %preun receives 0 on a final erase and 1 on an upgrade.
    if [ "${1:-0}" -eq 0 ]; then
        do_unregister_icd
    fi
{% endif %}
fi
