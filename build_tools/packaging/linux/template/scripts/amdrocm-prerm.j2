#!/bin/bash

is_debian_like() {
    local id_like="$1"

    case " $id_like " in
        (*" debian "*|*" ubuntu "*)
            return 0
            ;;
        (*)
            return 1
            ;;
    esac
}

do_remove_alternatives() {
    # Skip update if update-alternatives does not exist.
    command -v update-alternatives >/dev/null || return 0

{% if target == "deb" %}
    PKG_INSTALL_PREFIX={{ install_prefix }}
{% else %}
    PKG_INSTALL_PREFIX="$RPM_INSTALL_PREFIX0"
{% endif %}

    # Remove package-specific binary alternatives first.
{% for binary in binaries %}
    update-alternatives --remove \
        "{{ binary }}" \
        "$PKG_INSTALL_PREFIX/bin/{{ binary }}" \
        || true
{% endfor %}

{% if core_symlinks %}
    # Remove /opt/rocm/core and /opt/rocm/core-<major>.
    update-alternatives --remove \
        "core" \
        "$PKG_INSTALL_PREFIX" \
        || true

    update-alternatives --remove \
        "core-{{ version_major }}" \
        "$PKG_INSTALL_PREFIX" \
        || true

    # Remove /opt/rocm/bin, /opt/rocm/lib, and /opt/rocm/include.
    update-alternatives --remove \
        "rocm-bin" \
        "$PKG_INSTALL_PREFIX/bin" \
        || true

    update-alternatives --remove \
        "rocm-lib" \
        "$PKG_INSTALL_PREFIX/lib" \
        || true

    update-alternatives --remove \
        "rocm-include" \
        "$PKG_INSTALL_PREFIX/include" \
        || true

    # Remove /opt/rocm/libexec and /opt/rocm/share.
    update-alternatives --remove \
        "rocm-libexec" \
        "$PKG_INSTALL_PREFIX/libexec" \
        || true

    update-alternatives --remove \
        "rocm-share" \
        "$PKG_INSTALL_PREFIX/share" \
        || true
{% endif %}

{% if llvm_symlinks %}
    # Remove /opt/rocm/llvm and /opt/rocm/amdgcn.
    update-alternatives --remove \
        "rocm-llvm" \
        "$PKG_INSTALL_PREFIX/llvm" \
        || true

    update-alternatives --remove \
        "rocm-amdgcn" \
        "$PKG_INSTALL_PREFIX/amdgcn" \
        || true
{% endif %}
}

do_unregister_icd() {
    # Remove OpenCL ICD vendor files registered by the postinst script.
    #
    # Called only on final removal, never on upgrade: the replacement
    # package's postinst rewrites the file, and deleting it mid-upgrade
    # would leave a window where OpenCL is unavailable.
    #
    # No install prefix is needed here -- the vendor file always lives in
    # the system-wide /etc/OpenCL/vendors/ directory.
{% for icd in icd_files | default([]) %}
    rm -f "/etc/OpenCL/vendors/{{ icd.name }}-{{ version_major }}.{{ version_minor }}.icd"
{% endfor %}

    true
}

if [ -e /etc/os-release ] &&
   source /etc/os-release &&
   is_debian_like "${ID_LIKE:-$ID}"
then
    case "$1" in
        remove)
            do_remove_alternatives
            do_unregister_icd
            ;;

        upgrade)
            do_remove_alternatives
            ;;

        purge)
            # Nothing to do.
            ;;

        *)
            exit 0
            ;;
    esac
else
    do_remove_alternatives
    # RPM %preun passes the number of remaining installations in $1;
    # 0 means this is a final removal rather than an upgrade.
    if [ "${1:-0}" = "0" ]; then
        do_unregister_icd
    fi
fi
