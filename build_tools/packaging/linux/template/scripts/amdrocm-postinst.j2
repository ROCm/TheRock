#!/bin/bash

is_debian_like() {
    local id_like="$1"

    case " $id_like " in
        (*" debian "*|*" ubuntu "*)
            return 0
            ;;
        (*)
            return 1
            ;;
    esac
}

do_update_alternatives() {
    # Skip update if update-alternatives does not exist.
    command -v update-alternatives >/dev/null || return 0

    local altscore now
    now=$(date -u +%s)          # Number of seconds since 1 Jan 1970

    # The reason for this approach rather than using the build number
    # is to allow for jobs from different builds. In one build job the
    # job number might be at 1200, whilst in a release job the number
    # may be only 1. This approach assumes that if you install a build
    # with a different semantic version then the highest is the
    # desired one, but if you install two with the same semver then
    # the newest is the desired version.

    # Build up a score. It needs to fit in 32 bits
    altscore=$(({{ version_major }} - 3))
    altscore=$((altscore * 14 + {{ version_minor }})) # Allow up to 14 minor
    altscore=$((altscore * 14 + {{ version_patch }})) # Allow up to 14 patch

    # So far if the version is 10.x we have a number (altscore)
    # that is at most 1567.  2**31/1567 is about 1.37 million. So
    # multiply altscore by 1,000,000 and add in a factor of how many
    # minutes have passed from an arbitrary point in time (1,600,000,000
    # seconds after 1 Jan 1970 or Sep 13 12:26:40 2020) on the
    # basis that no one is going to be installing a new version more
    # often than every minute. This does get things wrong if a million
    # minutes pass and you are downgrading, but the chances of someone
    # waiting almost 2 years between installing a version and the
    # previous patch level is small.
    # Note: altscore must stay below about 2140 to fit in 32 bits, so
    # this overflows from ROCm 14 (14.0.0 gives 2156).
    altscore=$((altscore * 1000000 + (now - 1600000000) / 60))

{% if target == "deb" %}
    PKG_INSTALL_PREFIX={{ install_prefix }}
{% else %}
    PKG_INSTALL_PREFIX="$RPM_INSTALL_PREFIX0"
{% endif %}

{% if core_symlinks %}
    # Install /opt/rocm/core and /opt/rocm/core-<major>.
    update-alternatives --install \
        "/opt/rocm/core" \
        "core" \
        "$PKG_INSTALL_PREFIX" \
        "$altscore"

    update-alternatives --install \
        "/opt/rocm/core-{{ version_major }}" \
        "core-{{ version_major }}" \
        "$PKG_INSTALL_PREFIX" \
        "$altscore"

    # Install /opt/rocm/bin, /opt/rocm/lib, and /opt/rocm/include.
    update-alternatives --install \
        "/opt/rocm/bin" \
        "rocm-bin" \
        "$PKG_INSTALL_PREFIX/bin" \
        "$altscore"

    update-alternatives --install \
        "/opt/rocm/lib" \
        "rocm-lib" \
        "$PKG_INSTALL_PREFIX/lib" \
        "$altscore"

    update-alternatives --install \
        "/opt/rocm/include" \
        "rocm-include" \
        "$PKG_INSTALL_PREFIX/include" \
        "$altscore"

    # Install /opt/rocm/libexec and /opt/rocm/share.
    update-alternatives --install \
        "/opt/rocm/libexec" \
        "rocm-libexec" \
        "$PKG_INSTALL_PREFIX/libexec" \
        "$altscore"

    update-alternatives --install \
        "/opt/rocm/share" \
        "rocm-share" \
        "$PKG_INSTALL_PREFIX/share" \
        "$altscore"
{% endif %}

{% if llvm_symlinks %}
    # Install /opt/rocm/llvm and /opt/rocm/amdgcn.
    update-alternatives --install \
        "/opt/rocm/llvm" \
        "rocm-llvm" \
        "$PKG_INSTALL_PREFIX/llvm" \
        "$altscore"

    update-alternatives --install \
        "/opt/rocm/amdgcn" \
        "rocm-amdgcn" \
        "$PKG_INSTALL_PREFIX/amdgcn" \
        "$altscore"
{% endif %}

    # Install package-specific binary alternatives.
{% for binary in binaries %}
    if [ -e "$PKG_INSTALL_PREFIX/bin/{{ binary }}" ]; then
        update-alternatives --install \
            "/usr/bin/{{ binary }}" \
            "{{ binary }}" \
            "$PKG_INSTALL_PREFIX/bin/{{ binary }}" \
            "$altscore"
    else
        echo "$PKG_INSTALL_PREFIX/bin/{{ binary }} not found, but that is OK" >&2
    fi
{% endfor %}

    true
}

{% if opencl_icd %}
do_register_icd() {
    # Deliberately independent of do_update_alternatives: registering an ICD
    # does not need update-alternatives, which that function requires.
    local pkg_install_prefix
    local lib_dir
    local lib_path=""
    local candidate
    local icd_dir="/etc/OpenCL/vendors"
    local icd_file

{% if target == "deb" %}
    pkg_install_prefix="{{ install_prefix }}"
{% else %}
    # Fall back to the build-time prefix
    pkg_install_prefix="${RPM_INSTALL_PREFIX0:-{{ install_prefix }}}"
{% endif %}

    lib_dir="${pkg_install_prefix}/lib/opencl"

    # Prefer the SONAME-versioned runtime library. The unversioned symlink may
    # be absent from runtime packages. [0-9] also excludes "libamdocl64.so.".
    for candidate in "${lib_dir}"/libamdocl64.so.[0-9]* "${lib_dir}/libamdocl64.so"; do
        if [ -e "$candidate" ]; then
            lib_path="$candidate"
            break
        fi
    done

    # Qualified by major.minor only, matching the granularity of the install
    icd_file="${icd_dir}/amdocl64_$(printf '%d%02d' \
        {{ version_major }} {{ version_minor }}).icd"

    if [ -z "$lib_path" ]; then
        echo "error: OpenCL runtime not found in ${lib_dir}" >&2
        return 1
    fi

    install -d -m 0755 "$icd_dir"

    # Use an absolute path so OpenCL discovery does not depend on ld.so.conf.d
    # or the system linker search path. See docs/packaging/native_packaging.md.
    printf '%s\n' "$lib_path" > "$icd_file"
    chmod 0644 "$icd_file"
}
{% endif %}

if [ -e /etc/os-release ] &&
   source /etc/os-release &&
   is_debian_like "${ID_LIKE:-$ID}"
then
    case "$1" in
        configure)
            do_update_alternatives
{% if opencl_icd %}
            # Non-fatal: a missing OpenCL runtime must not fail the whole
            # postinst and leave the other alternatives unregistered.
            do_register_icd || true
{% endif %}
            ;;

        abort-upgrade|abort-remove|abort-deconfigure)
            echo "$1"
            ;;

        *)
            exit 0
            ;;
    esac
else
    do_update_alternatives
{% if opencl_icd %}
    do_register_icd || true
{% endif %}
fi
