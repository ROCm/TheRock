#!/bin/bash

{% import data_template as data with context %}

is_debian_like() {
    local id_like="$1"

    case " $id_like " in
        (*" debian "*|*" ubuntu "*)
            return 0
            ;;
        (*)
            return 1
            ;;
    esac
}

do_update_alternatives() {
    # Skip update if update-alternatives does not exist.
    command -v update-alternatives >/dev/null || return 0

    local altscore now
    now=$(date -u +%s)

    # Build the alternatives priority from the ROCm version.
    altscore=$(({{ version_major }} - 3))
    altscore=$((altscore * 14 + {{ version_minor }}))
    altscore=$((altscore * 14 + {{ version_patch }}))

    # Prefer the newest installation when semantic versions are equal.
    altscore=$((altscore * 1000000 + (now - 1600000000) / 60))

{% if target == "deb" %}
    PKG_INSTALL_PREFIX={{ install_prefix }}
{% else %}
    PKG_INSTALL_PREFIX="$RPM_INSTALL_PREFIX0"
{% endif %}

    # Install directory and symbolic-link alternatives.
{% for alternative in data.alternatives %}
    update-alternatives --install \
        "{{ alternative.link }}" \
        "{{ alternative.name }}" \
        "$PKG_INSTALL_PREFIX{{ alternative.target_suffix }}" \
        "$altscore"
{% endfor %}

    # Install binary alternatives only when the binary exists.
{% for binary in data.binaries %}
    if [ -e "$PKG_INSTALL_PREFIX/bin/{{ binary }}" ]; then
        update-alternatives --install \
            "/usr/bin/{{ binary }}" \
            "{{ binary }}" \
            "$PKG_INSTALL_PREFIX/bin/{{ binary }}" \
            "$altscore"
    else
        echo "$PKG_INSTALL_PREFIX/bin/{{ binary }} not found, but that is OK" >&2
    fi
{% endfor %}

    true
}

if [ -e /etc/os-release ] &&
   source /etc/os-release &&
   is_debian_like "${ID_LIKE:-$ID}"
then
    case "$1" in
        configure)
            do_update_alternatives
            ;;

        abort-upgrade|abort-remove|abort-deconfigure)
            echo "$1"
            ;;

        *)
            exit 0
            ;;
    esac
else
    do_update_alternatives
fi

