# Matched experiment hook: append only the two candidate project options.
if(NOT "$ENV{PERF_MODE}" MATCHES "^(baseline|joint)$")
  message(FATAL_ERROR "Missing full-cohort mode")
endif()
if("$ENV{STAGE_NAME}" STREQUAL "math-libs")
  foreach(_option ROCSOLVER_SHARD_GETF2_SMALL ROCSOLVER_SPLIT_GETRI_Z)
    foreach(_arg IN LISTS rocSOLVER_CMAKE_ARGS)
      if(_arg MATCHES "^-D${_option}(:[^=]+)?=(.*)$")
        message(FATAL_ERROR "Unexpected pre-existing candidate option: ${_arg}")
      endif()
    endforeach()
    if("$ENV{PERF_MODE}" STREQUAL "joint")
      list(APPEND rocSOLVER_CMAKE_ARGS "-D${_option}:BOOL=ON")
    endif()
  endforeach()
  if("$ENV{PERF_MODE}" STREQUAL "joint")
    set(rocSOLVER_CMAKE_ARGS "${rocSOLVER_CMAKE_ARGS}" CACHE STRING "Matched joint solver experiment" FORCE)
  endif()
endif()
