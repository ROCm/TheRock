@PACKAGE_INIT@

# Preserve FFTW's legacy variables as well as its upstream imported targets.
set(FFTW3_CONFIG_FILE "${CMAKE_CURRENT_LIST_FILE}")
set(FFTW3@PREC_SUFFIX@_LIBRARIES fftw3@PREC_SUFFIX@)
set(FFTW3@PREC_SUFFIX@_LIBRARY_DIRS "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(FFTW3@PREC_SUFFIX@_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")

include("${CMAKE_CURRENT_LIST_DIR}/FFTW3LibraryDepends.cmake")
