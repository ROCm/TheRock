     """A QEMU or vfio-user launch requirement was not satisfied."""
 
 
+def open_pidfd(pid: int) -> int:
+    """Open a pidfd even when Python was built against older Linux headers."""
+    native = getattr(os, "pidfd_open", None)
+    if native is not None:
+        return native(pid)
+    # Linux 5.3 added this syscall; manylinux Python may lack its wrapper even
+    # when the running kernel supports it. These architectures share number 434.
+    if sys.platform != "linux" or platform.machine() not in (
+        "x86_64", "aarch64", "ppc64", "ppc64le"
+    ):
+        raise GuestRunError("pidfd_open is unavailable on this Python/platform")
+    syscall = ctypes.CDLL(None, use_errno=True).syscall
+    syscall.restype = ctypes.c_long
+    syscall.argtypes = (ctypes.c_long, ctypes.c_int, ctypes.c_uint)
+    fd = syscall(434, pid, 0)
+    if fd < 0:
+        error = ctypes.get_errno()
+        raise OSError(error, os.strerror(error))
+    return fd
+
