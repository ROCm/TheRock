+TEST(ValuFpModeHelpers, F16BinaryNanPreservesFirstSourceSignAndPayload) {
+  using amdgpu::fp_mode::Arithmetic;
+  struct Case {
+    uint16_t lhs, rhs, expected;
+  };
+  constexpr Case cases[] = {
+      {0x7e11, 0xfe22, 0x7e11}, {0xfe22, 0x7e11, 0xfe22},
+      {0x7c11, 0xfe22, 0x7e11}, {0xfc22, 0x7e11, 0xfe22},
+      {0x3c00, 0x7e11, 0x7e11}, {0x3c00, 0xfc22, 0xfe22},
+      {0x7e11, 0x3c00, 0x7e11}, {0xfc22, 0x3c00, 0xfe22},
+  };
+  const auto check = [&]<Arithmetic operation>() {
+    for (const auto &test : cases)
+      for (uint32_t mode = 0; mode < 4; ++mode) {
+        SCOPED_TRACE(::testing::Message() << test.lhs << ':' << test.rhs << ':' << mode);
+        const double value = amdgpu::fp_mode::arithmetic_f16<operation>(
+            util::f16_to_f32(test.lhs), util::f16_to_f32(test.rhs), 0.0f, mode);
+        EXPECT_EQ(amdgpu::fp_mode::finish_arithmetic_f16(value, mode, 3, false),
+                  test.expected);
+      }
+  };
+  check.template operator()<Arithmetic::ADD>();
+  check.template operator()<Arithmetic::MUL>();
+}
