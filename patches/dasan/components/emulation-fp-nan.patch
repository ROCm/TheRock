--- a/emulation/rocjitsu/lib/rocjitsu/src/rocjitsu/isa/arch/amdgpu/shared/fp_mode.h
+++ b/emulation/rocjitsu/lib/rocjitsu/src/rocjitsu/isa/arch/amdgpu/shared/fp_mode.h
@@ -931,6 +931,15 @@ inline uint32_t mullit_f32(uint32_t s0, uint32_t s1, uint32_t s2, uint32_t round
 /// inside a region that already owns it.
 template <Arithmetic operation>
 inline double arithmetic_f16_unscoped(float lhs, float rhs, float addend) {
+  if constexpr (operation == Arithmetic::ADD || operation == Arithmetic::MUL) {
+    // Preserve guest source order for NaN sign/payload selection. Host ADD/MUL
+    // may commute operands, so relying on host arithmetic makes scalar and SIMD
+    // repair paths disagree. Widening also quiets a selected signaling NaN.
+    if (std::isnan(lhs))
+      return static_cast<double>(lhs);
+    if (std::isnan(rhs))
+      return static_cast<double>(rhs);
+  }
   return detail::evaluate_arithmetic<operation>(static_cast<double>(lhs), static_cast<double>(rhs),
                                                 static_cast<double>(addend));
 }
