+  // Propagates NaN, matching maximum() and torch.max.
+  // Uses VSX vec_max for pairwise reduction, then checks for NaN.
+  float reduce_max() const {
+    // Reduce the two 4-wide halves into one
+    vfloat32 v = vec_max(_vec0, _vec1);
+    // Reduce 4 -> 2: rotate by 2 elements and max
+    vfloat32 v1 = vec_sld(v, v, 8);
+    v = vec_max(v, v1);
+    // Reduce 2 -> 1: rotate by 1 element and max
+    v1 = vec_sld(v, v, 4);
+    v = vec_max(v, v1);
+    // Check for NaN in the original vectors: NaN != NaN
+    vbool32 nan0 = vec_cmpeq(_vec0, _vec0);
+    vbool32 nan1 = vec_cmpeq(_vec1, _vec1);
+    if (!vec_all_eq(nan0, (vbool32)vec_splats((unsigned int)-1)) ||
+        !vec_all_eq(nan1, (vbool32)vec_splats((unsigned int)-1))) {
+      return std::numeric_limits<float>::quiet_NaN();
+    }
+    return vec_extract(v, 0);
+  }
