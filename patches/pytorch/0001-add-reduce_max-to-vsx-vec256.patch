+  // Propagates NaN, matching maximum() and torch.max.
+  // Uses VSX vec_max for pairwise reduction, then checks for NaN.
+  double reduce_max() const {
+    // Reduce the two 2-wide halves into one
+    vfloat64 v = vec_max(_vec0, _vec1);
+    // Reduce 2 -> 1: rotate by 1 element and max
+    vfloat64 v1 = vec_sld(v, v, 8);
+    v = vec_max(v, v1);
+    // Check for NaN in the original vectors: NaN != NaN
+    vbool64 nan0 = vec_cmpeq(_vec0, _vec0);
+    vbool64 nan1 = vec_cmpeq(_vec1, _vec1);
+    if (!vec_all_eq(nan0, (vbool64)vec_splats((unsigned long long)-1)) ||
+        !vec_all_eq(nan1, (vbool64)vec_splats((unsigned long long)-1))) {
+      return std::numeric_limits<double>::quiet_NaN();
+    }
+    return vec_extract(v, 0);
+  }
