+
+    static Elf_Xword padded_size( Elf_Word size )
+    {
+        constexpr Elf_Xword alignment = sizeof( Elf_Word );
+        return ( static_cast<Elf_Xword>( size ) + alignment - 1 ) / alignment *
+               alignment;
+    }
 
