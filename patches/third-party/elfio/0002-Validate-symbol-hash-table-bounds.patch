-                    break;
-                }
+        const Elf_Xword     hash_size   = hash_section->get_size();
+        constexpr Elf_Xword header_size = 4 * sizeof( uint32_t );
+        if ( hash_size < header_size ||
+             bloom_size > ( hash_size - header_size ) / sizeof( T ) ) {
+            return false;
+        }

-                if ( chain_hash & 1 )
