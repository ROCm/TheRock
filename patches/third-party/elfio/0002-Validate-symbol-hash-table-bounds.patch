+        const Elf_Xword buckets_offset =
+            header_size + static_cast<Elf_Xword>( bloom_size ) * sizeof( T );
+        if ( nbuckets > ( hash_size - buckets_offset ) / sizeof( uint32_t ) ) {
+            return false;
+        }
+
+        const Elf_Xword chains_offset =
