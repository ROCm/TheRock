From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AMD TheRock <noreply@amd.com>
Date: Fri, 20 Nov 2026 00:00:00 +0000
Subject: [PATCH] Make the installed FFTW3Config.cmake relocatable

Upstream's FFTW3Config.cmake.in bakes @CMAKE_INSTALL_FULL_LIBDIR@ and
@CMAKE_INSTALL_FULL_INCLUDEDIR@ -- absolute, build-machine-specific
paths -- directly into the installed config file. Once the staged
install is copied to another machine or build location, those paths
no longer exist and consumers fail with "fftw3.h file not found"
(ROCm/TheRock#7781).

Replaces the template with one that derives the install prefix
relative to the config file's own location (three directories up from
lib/cmake/<name>/FFTW3Config.cmake), the same way TheRock's other
relocatable CMake packages work. Also adds the Windows IMPORTED_IMPLIB/
DLL-location branch rocFFT's own FindFFTW-style consumer code expects
on that platform (upstream's template only ever covered the single
IMPORTED_LOCATION case, which is Linux's .so layout).

_package_name and _library_name are now set explicitly in
CMakeLists.txt before configure_file() runs, instead of being
implicitly available from earlier in the file -- makes the substituted
tokens' source obvious at the template's only remaining configure_file
call site.

See-also: https://github.com/ROCm/TheRock/issues/7781
See-also: https://github.com/ROCm/TheRock/pull/9753
---
 CMakeLists.txt        |  2 +
 FFTW3Config.cmake.in  | 73 +++++++++++++++++++++++++++++++++++---------
 2 files changed, 59 insertions(+), 16 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -419,6 +419,8 @@ install (FILES

 # cmake file
 set (FFTW3_LIBRARIES "FFTW3::${fftw3_lib}")
+set (_package_name FFTW3${PREC_SUFFIX})
+set (_library_name ${fftw3_lib})
 configure_file (FFTW3Config.cmake.in FFTW3${PREC_SUFFIX}Config.cmake @ONLY)
 configure_file (FFTW3ConfigVersion.cmake.in FFTW3${PREC_SUFFIX}ConfigVersion.cmake @ONLY)
 install (FILES
diff --git a/FFTW3Config.cmake.in b/FFTW3Config.cmake.in
--- a/FFTW3Config.cmake.in
+++ b/FFTW3Config.cmake.in
@@ -1,17 +1,57 @@
-# defined since 2.8.3
-if (CMAKE_VERSION VERSION_LESS 2.8.3)
-  get_filename_component (CMAKE_CURRENT_LIST_DIR ${CMAKE_CURRENT_LIST_FILE} PATH)
-endif ()
-
-# Allows loading FFTW3 settings from another project
-set (FFTW3_CONFIG_FILE "${CMAKE_CURRENT_LIST_FILE}")
+# Replaces upstream's FFTW3Config.cmake.in, which bakes the build machine's
+# absolute install prefix into @CMAKE_INSTALL_FULL_LIBDIR@/
+# @CMAKE_INSTALL_FULL_INCLUDEDIR@ (ROCm/TheRock#7781). Derives the prefix
+# relative to this file's own install location instead, so a copied or
+# relocated install still resolves correctly.
+#
+# configure_file() substitutions (set in CMakeLists.txt before this file is
+# configured): @_package_name@ is FFTW3 or FFTW3f, @_library_name@ is fftw3
+# or fftw3f.
 
-set (FFTW3@PREC_SUFFIX@_LIBRARIES fftw3@PREC_SUFFIX@)
-set (FFTW3@PREC_SUFFIX@_LIBRARY_DIRS @CMAKE_INSTALL_FULL_LIBDIR@)
-set (FFTW3@PREC_SUFFIX@_INCLUDE_DIRS @CMAKE_INSTALL_FULL_INCLUDEDIR@)
+get_filename_component (_fftw_import_prefix "${CMAKE_CURRENT_LIST_DIR}" PATH)
+get_filename_component (_fftw_import_prefix "${_fftw_import_prefix}" PATH)
+get_filename_component (_fftw_import_prefix "${_fftw_import_prefix}" PATH)
+if (_fftw_import_prefix STREQUAL "/")
+  set (_fftw_import_prefix "")
+endif ()
 
-include ("${CMAKE_CURRENT_LIST_DIR}/FFTW3LibraryDepends.cmake")
+set (@_package_name@_INCLUDE_DIRS "${_fftw_import_prefix}/include")
+set (@_package_name@_LIBRARY_DIRS "${_fftw_import_prefix}/lib")
 
-if (CMAKE_VERSION VERSION_LESS 2.8.3)
-  set (CMAKE_CURRENT_LIST_DIR)
+if (NOT TARGET FFTW3::@_library_name@)
+  add_library (FFTW3::@_library_name@ SHARED IMPORTED)
+  set_target_properties (FFTW3::@_library_name@ PROPERTIES
+    INTERFACE_INCLUDE_DIRECTORIES "${_fftw_import_prefix}/include"
+  )
+  if (WIN32)
+    set (_fftw_implib "${_fftw_import_prefix}/lib/${CMAKE_IMPORT_LIBRARY_PREFIX}@_library_name@${CMAKE_IMPORT_LIBRARY_SUFFIX}")
+    set (_fftw_runtime "${_fftw_import_prefix}/bin/${CMAKE_SHARED_LIBRARY_PREFIX}@_library_name@${CMAKE_SHARED_LIBRARY_SUFFIX}")
+    set_target_properties (FFTW3::@_library_name@ PROPERTIES
+      IMPORTED_LOCATION "${_fftw_runtime}"
+      IMPORTED_LOCATION_DEBUG "${_fftw_runtime}"
+      IMPORTED_LOCATION_MINSIZEREL "${_fftw_runtime}"
+      IMPORTED_LOCATION_RELEASE "${_fftw_runtime}"
+      IMPORTED_LOCATION_RELWITHDEBINFO "${_fftw_runtime}"
+      IMPORTED_IMPLIB "${_fftw_implib}"
+      IMPORTED_IMPLIB_DEBUG "${_fftw_implib}"
+      IMPORTED_IMPLIB_MINSIZEREL "${_fftw_implib}"
+      IMPORTED_IMPLIB_RELEASE "${_fftw_implib}"
+      IMPORTED_IMPLIB_RELWITHDEBINFO "${_fftw_implib}"
+    )
+    unset (_fftw_implib)
+    unset (_fftw_runtime)
+  else ()
+    set (_fftw_shared "${_fftw_import_prefix}/lib/${CMAKE_SHARED_LIBRARY_PREFIX}@_library_name@${CMAKE_SHARED_LIBRARY_SUFFIX}")
+    set_target_properties (FFTW3::@_library_name@ PROPERTIES
+      IMPORTED_LOCATION "${_fftw_shared}"
+      IMPORTED_LOCATION_DEBUG "${_fftw_shared}"
+      IMPORTED_LOCATION_MINSIZEREL "${_fftw_shared}"
+      IMPORTED_LOCATION_RELEASE "${_fftw_shared}"
+      IMPORTED_LOCATION_RELWITHDEBINFO "${_fftw_shared}"
+    )
+    unset (_fftw_shared)
+  endif ()
 endif ()
+
+set (@_package_name@_FOUND TRUE)
+unset (_fftw_import_prefix)

--
2.43.0
