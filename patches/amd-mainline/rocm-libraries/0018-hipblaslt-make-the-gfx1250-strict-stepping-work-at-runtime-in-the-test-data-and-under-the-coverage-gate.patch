+++ b/projects/hipblaslt/clients/tests/data/known_bugs.yaml
@@ -10,15 +10,18 @@
 
 Known bugs:
   # ROCM-1545: TF32 matmul with INF inputs returns NaN on gfx950 (MI355)
-  - { name: matmul_tf32_inf_ROCM1545, function: matmul, initialization: inf, known_bug_platforms: "gfx950, gfx1250" }
+  # gfx1250-strict is listed alongside gfx1250 because the match is an exact
+  # token comparison against the name the runtime reports, and a v0 part reports
+  # the revision; the defect is in silicon the revision shares.
+  - { name: matmul_tf32_inf_ROCM1545, function: matmul, initialization: inf, known_bug_platforms: "gfx950, gfx1250, gfx1250-strict" }
   # ROCM-1545 (same root cause): the special-FP sweep hits it on the TF32 (xf32)
   # compute type when the input is +Inf or -Inf -- the GPU returns -nan where the
   # CPU reference is +Inf, failing check_special_value_consistency(). Only the xf32
   # Inf/-Inf cases fail; the f16/bf16/f32/f64 Inf cases and the xf32 NaN case pass,
   # so scope the quarantine to compute_type xf32_r + inf/neg_inf. REMOVE once the
   # TF32 Inf fix lands so these re-activate as an enforced consistency gate.
-  - { name: matmul_special_fp_64x64, function: matmul, compute_type: c_xf32_r, initialization: inf, known_bug_platforms: "gfx950, gfx1250" }
-  - { name: matmul_special_fp_64x64, function: matmul, compute_type: c_xf32_r, initialization: neg_inf, known_bug_platforms: "gfx950, gfx1250" }
+  - { name: matmul_special_fp_64x64, function: matmul, compute_type: c_xf32_r, initialization: inf, known_bug_platforms: "gfx950, gfx1250, gfx1250-strict" }
+  - { name: matmul_special_fp_64x64, function: matmul, compute_type: c_xf32_r, initialization: neg_inf, known_bug_platforms: "gfx950, gfx1250, gfx1250-strict" }
   # ROCM-26455: bf16 matmul output-store address overflow -- an output element
   # offset > 2^31 (from an oversized output leading dimension ldc/ldd) wraps in the
   # 32-bit global-write address path and produces silent wrong results. The gate
