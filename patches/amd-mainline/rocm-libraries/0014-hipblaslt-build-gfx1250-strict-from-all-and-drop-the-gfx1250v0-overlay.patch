+    # a run would then take the shared parent as its own scratch directory.
+    stem = Path(outputPath).stem.upper() or "SCRATCH"
+    return buildTmpRoot(outputPath) / (f"{stem}-{steppings[0]}" if steppings else stem)
 
 
