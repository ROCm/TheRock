From: therockbot <therockbot@amd.com>
Date: Tue, 3 Nov 2026 18:17:17 +0000
Subject: [PATCH] fix(hipblaslt): guard -mno-avx behind x86 arch check

Cherry-pick of f44ee05862d from develop. The submodule pin has not
been bumped to include it yet.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../clients/samples/29_hipblaslt_gemm_w4a16/CMakeLists.txt    | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/projects/hipblaslt/clients/samples/29_hipblaslt_gemm_w4a16/CMakeLists.txt b/projects/hipblaslt/clients/samples/29_hipblaslt_gemm_w4a16/CMakeLists.txt
index 4ac74721fc2..fe5820a2d90 100644
--- a/projects/hipblaslt/clients/samples/29_hipblaslt_gemm_w4a16/CMakeLists.txt
+++ b/projects/hipblaslt/clients/samples/29_hipblaslt_gemm_w4a16/CMakeLists.txt
@@ -2,5 +2,7 @@
 # SPDX-License-Identifier:  MIT
 
 add_executable(sample_hipblaslt_gemm_w4a16 "${CMAKE_CURRENT_SOURCE_DIR}/sample_hipblaslt_gemm_w4a16.cpp")
-target_compile_options(sample_hipblaslt_gemm_w4a16 PRIVATE -mno-avx)
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
+    target_compile_options(sample_hipblaslt_gemm_w4a16 PRIVATE -mno-avx)
+endif()
 target_link_libraries(sample_hipblaslt_gemm_w4a16 PRIVATE sample-helper)
