From a40aa5d0b27c7cb6ab8aa4a16aafb8b5e400729f Mon Sep 17 00:00:00 2001
From: Ammar ELWazir <3832908+ammarwa@users.noreply.github.com>
Date: Sat, 12 Sep 2026 14:01:32 -0500
Subject: [PATCH] hipSPARSELt: preserve strict library selection

Rebased onto rocm-libraries 271344a472037d303d5220eea2b14fd2ac01c1e5. Device-library generation is now owned by the embedded hipBLASLt path covered by the preceding patch; retain the strict host-side library-key mapping.
---
 .../library/src/hcc_detail/rocsparselt/src/tensile_host.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/projects/hipsparselt/library/src/hcc_detail/rocsparselt/src/tensile_host.cpp b/projects/hipsparselt/library/src/hcc_detail/rocsparselt/src/tensile_host.cpp
index 6ed888b..43265a7 100644
--- a/projects/hipsparselt/library/src/hcc_detail/rocsparselt/src/tensile_host.cpp
+++ b/projects/hipsparselt/library/src/hcc_detail/rocsparselt/src/tensile_host.cpp
@@ -664,6 +664,10 @@ namespace
                     path += "/" + processor;
             }
 
+            // The directory retains the compiler target; metadata uses the numeric ISA.
+            if(processor == "gfx1250-strict")
+                processor = "gfx1250";
+
             // only load modules for the current architecture
             auto dir = path + "/*" + processor + "*co";
 #if ROCSPARSELT_TENSILE_LAZY_LOAD == 0
@@ -789,7 +793,7 @@ namespace
                 return 0;
             }();
 
-            static_cast<void>(adapter.initializeLazyLoading(processor, path));
+            static_cast<void>(adapter.initializeLazyLoading(rocsparselt_internal_get_arch_name(), path));
 
 
             if(!m_library && once != 0)
-- 
