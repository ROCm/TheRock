+# Large shapes with partial tiles in every dimension.
+# Runtime on gfx942: 8 cases, about 10 s.
+- name: matmul_fast_check_large
+  category: nightly
+  function:
+    matmul: *single_precision
+  matrix_size: *fast_check_large_sizes
+  transA_transB: *transA_transB_range
+  alpha: 2.0
+  beta: -2.0
+  initialization: integer_exact
+  unit_check: 0
+  fast_check: 1
+
+# Runtime on gfx942: 16 cases, about 15 s.
+- name: matmul_fast_check_large_16bit
+  category: nightly
+  function:
+    matmul:
+      - *hpa_half_precision
+      - *hpa_bf16_precision
+  matrix_size: *fast_check_large_16bit_sizes
+  transA_transB: *transA_transB_range
+  alpha: 2.0
+  beta: -2.0
+  initialization: integer_exact
+  unit_check: 0
+  fast_check: 1
+
+# ROCM-31016: kernels bound D's stores with num_records = 0xfffff000, and the
+# solution predicate used to compare a shape's store extent against 2^32. At
+# M = 8,388,607, N = 256 in bf16 with ldd = M, one MacroTile1 = 256 tile spans
+# all of D, 4,294,966,784 bytes, which lies between the two. Kernels admitted
+# there dropped the last stores without an error. Every offered solution runs,
+# because the defect is specific to kernels with MacroTile1 = 256. The D sentinel
+# reports the dropped stores as elements never written.
+# Runtime on gfx942: 1 case covering 1,093 solutions, about 144 s.
+- name: matmul_fast_check_store_extent_ROCM31016
+  category: nightly
+  function:
+    matmul: *hpa_bf16_precision
+  matrix_size:
+    - { M: 8388607, N: 256, K: 48 }
+  transA: N
+  transB: N
+  alpha: 2.0
