+      - *single_precision
+      - *hpa_bf16_precision
+  matrix_size:
+    - { M: 131, N: 67, K: 200, lda: 131, ldb: 211, ldc: 140, ldd: 151 }
+    - { M: 1031, N: 517, K: 256, lda: 1031, ldb: 1033, ldc: 1031, ldd: 1100 }
+  transA: N
+  transB: T
+  alpha_beta: *integer_exact_alpha_beta
+  bias_vector: 1
+  bias_type: f32_r
+  scaleAlpha_vector: 1
