+###############################################################################
+# fast_check: verification without a host reference GEMM.
+#
+# unit_check compares D against a host reference GEMM, which costs O(M*N*K) and
+# copies every padded buffer to pinned host memory. On gfx942 the ldd = 1049100
+# case above spends 12 s of its 14.4 s allocating pinned host memory and the
+# lda = 1049100 case spends 3.8 s in the reference. fast_check (fast_check.hpp)
+# instead checks every element of D with Freivalds' algorithm in O(M*K + K*N +
+# M*N) host work on unpadded copies, and checks the padding on the device:
+#   - A, B and C padding holds a poison value (40), so a kernel that reads
+#     padding produces a wrong D;
+#   - D is filled with a NaN sentinel before each solution runs, and afterwards
+#     every element outside the M x N x batch region must still hold it, so an
+#     out-of-bounds write fails the test, as does an element never written.
+# fast_check requires integer_exact. It also models the rounding of results too
+# large for a 16-bit output, so 16-bit types can use K above 256 here.
+#
+# Runtimes below were measured on gfx942 (MI300A) with all fast_check cases in one
+# process: about 75 s for the pre_checkin cases and 260 s for the nightly cases.
+# A large case run on its own can take several seconds longer, because its device
+# memory is allocated fresh instead of reused.
+###############################################################################
+
+# Both checks on the same results: they must agree. Covers every transpose, both
+# integer_exact alpha/beta pairs, padded leading dimensions and strided batches.
+# Runtime on gfx942: 48 cases, about 48 s.
+- name: matmul_fast_check_matches_unit_check
+  category: pre_checkin
+  function:
+    matmul:
+      - *single_precision
+      - *hpa_half_precision
+      - *hpa_bf16_precision
+  matrix_size: *fast_check_crosscheck_sizes
+  transA_transB: *transA_transB_range
+  alpha_beta: *integer_exact_alpha_beta
+  batch_count: 3
+  initialization: integer_exact
+  unit_check: 1
+  fast_check: 1
+
+# For real inputs, conjugate transpose has the same layout and values as transpose.
+# Unequal M, N and K expose a wrong transpose flag in the compact input copies.
+- name: matmul_fast_check_conjugate_transpose
+  category: pre_checkin
+  function:
+    matmul: *single_precision
+  matrix_size:
+    - { M: 13, N: 11, K: 17, lda: 19, ldb: 19, ldc: 17, ldd: 19 }
+    - { M: 13, N: 19, K: 7, lda: 17, ldb: 23, ldc: 17, ldd: 19 }
+  transA: [ N, T, C ]
+  transB: [ N, T, C ]
+  alpha: 2.0
+  beta: -2.0
+  batch_count: 3
+  initialization: integer_exact
+  unit_check: 1
+  fast_check: 1
+
+# Both checks with the epilogue fast_check supports (bias and scaleAlpha_vector),
+# and with C and D sharing memory, where D's padding must keep C's poison value.
+# lda equals A's row count here; see the padded-lda case below.
+# Runtime on gfx942: 8 cases, under 1 s.
+- name: matmul_fast_check_matches_unit_check_epilogue
