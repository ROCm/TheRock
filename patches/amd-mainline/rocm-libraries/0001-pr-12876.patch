+// Returns why fast_check cannot verify this configuration, or an empty string when it can.
+inline std::string fast_check_unsupported_reason(const Arguments&     arg,
+                                                 hipblasLtBatchMode_t batchMode,
+                                                 bool                 do_swizzle,
+                                                 hipDataType          TiA,
+                                                 hipDataType          TiB,
+                                                 hipDataType          To,
+                                                 hipDataType          Tc)
