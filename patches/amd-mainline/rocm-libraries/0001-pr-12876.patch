+# Output element offsets above 2^32 (32-bit unsigned wrap), and a batch base
+# offset above 2^32: 3 batches with stride 2^31 + 2 put batch 2 at element
+# 4,294,967,300.
+# Runtime on gfx942: 4 cases, about 1 s.
+- name: matmul_fast_check_offset_above_2_32
+  category: nightly
