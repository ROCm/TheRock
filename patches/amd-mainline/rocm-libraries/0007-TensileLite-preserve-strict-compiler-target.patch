diff --git a/projects/hipblaslt/tensilelite/Tensile/Common/Architectures.py b/projects/hipblaslt/tensilelite/Tensile/Common/Architectures.py
index da06f12..0b36eed 100644
--- a/projects/hipblaslt/tensilelite/Tensile/Common/Architectures.py
+++ b/projects/hipblaslt/tensilelite/Tensile/Common/Architectures.py
@@ -21,6 +21,7 @@
 ################################################################################
 
 import re
+import os
 import collections
 
 from pathlib import Path
@@ -72,6 +73,7 @@ architectureMap = {
     # shares gfx1250's ISA, so `all` -- built from SUPPORTED_ISA -- cannot name
     # it and it has to be asked for explicitly.
     "gfx1250v0": "gfx1250v0",
+    "gfx1250-strict": "gfx1250v0",
 }
 
 gfxVariantMap = {
@@ -102,6 +104,10 @@ ARCH_CAP_OVERRIDES = {
     },
 }
 
+# Strict uses the same A0 scheduling restrictions, but probes and compiles
+# against the distinct compiler target in its own generator process.
+ARCH_CAP_OVERRIDES["gfx1250-strict"] = ARCH_CAP_OVERRIDES["gfx1250v0"]
+
 # Compiler target for names that are not themselves valid targets. The compiler
 # does not model steppings, so gfx1250v0 has to reach `-mcpu` / `--offload-arch`
 # as gfx1250; otherwise clang fails with `unsupported HIP gpu architecture`.
@@ -200,6 +206,17 @@ def isaToGfx(arch: IsaVersion) -> str:
 SUPPORTED_GFX = [isaToGfx(isa) for isa in SUPPORTED_ISA]
 
 
+def configureCompilerTarget(archs):
