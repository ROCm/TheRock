+++ b/projects/hipblaslt/library/src/amd_detail/rocblaslt/src/tensile_host.cpp
@@ -2814,6 +2814,11 @@ namespace
 
             // The name of the current GPU platform
             std::string processor = rocblaslt_internal_get_arch_name();
+            // Library metadata is keyed by logical ISA. The directory below
+            // still comes from the exact device target, so strict devices only
+            // load the separately compiled strict code objects.
+            if(processor == "gfx1250-strict")
+                processor = "gfx1250";
 
             // ROCM-26729 / SEC-00896: use the privilege-aware accessor so a
             // process in a secure execution context cannot be redirected to an
@@ -3022,7 +3027,7 @@ namespace
                 return 0;
             }();
 
-            static_cast<void>(adapter.initializeLazyLoading(processor, path.string()));
+            static_cast<void>(adapter.initializeLazyLoading(rocblaslt_internal_get_arch_name(), path.string()));
 
             if(!m_library && once != 0)
             {
