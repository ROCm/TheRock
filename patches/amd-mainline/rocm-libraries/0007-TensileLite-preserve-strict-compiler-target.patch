 set(output_dir "${CMAKE_CURRENT_BINARY_DIR}")
-string(REGEX MATCHALL "gfx[a-z0-9]+" archs "${GPU_TARGETS}")
+string(REGEX MATCHALL "gfx[a-z0-9]+(-strict)?" archs "${GPU_TARGETS}")
 list(REMOVE_DUPLICATES archs)
 message(STATUS "Architectures to process: ${archs}")
 
@@ -17,7 +17,7 @@ foreach(arch IN LISTS archs)
         set(extop_xnack_args --xnack)
     endif()
     set(WAVEFRONT "-mwavefrontsize64")
-    if(arch MATCHES "^gfx1[12][0-9][0-9]$")
+    if(arch MATCHES "^gfx1[12][0-9][0-9](-strict)?$")
         set(WAVEFRONT "-mno-wavefrontsize64")
     endif()
     add_library(extop-obj-${arch} OBJECT)
diff --git a/projects/hipblaslt/device-library/matrix-transform/CMakeLists.txt b/projects/hipblaslt/device-library/matrix-transform/CMakeLists.txt
index 95046e5..8cba14e 100644
