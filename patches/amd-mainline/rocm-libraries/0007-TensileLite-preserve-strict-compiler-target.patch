diff --git a/projects/hipblaslt/CMakeLists.txt b/projects/hipblaslt/CMakeLists.txt
index 0e77bbf..3c9e6a2 100644
--- a/projects/hipblaslt/CMakeLists.txt
+++ b/projects/hipblaslt/CMakeLists.txt
@@ -521,6 +521,14 @@ if(HIPBLASLT_ENABLE_DEVICE OR HIPBLASLT_ENABLE_ROCROLLER)
         DESTINATION ${HIPBLASLT_TENSILE_LIBRARY_DIR}
         COMPONENT runtime
     )
+    get_property(_strict_library_dir GLOBAL PROPERTY HIPBLASLT_STRICT_LIBRARY_DIR)
+    if(_strict_library_dir)
+        rocm_install(
+            DIRECTORY "${_strict_library_dir}"
+            DESTINATION "${HIPBLASLT_TENSILE_LIBRARY_DIR}/library"
+            COMPONENT runtime
+        )
+    endif()
     # The gfx1250 v0 GEMM tree builds into its own directory (see
     # device-library/CMakeLists.txt) but installs as one more subdir of the same
     # library/ root. The property is only set when that tree is built.
diff --git a/projects/hipblaslt/cmake/HipBLASLtCodegen.cmake b/projects/hipblaslt/cmake/HipBLASLtCodegen.cmake
index bcef72a..daaa888 100644
--- a/projects/hipblaslt/cmake/HipBLASLtCodegen.cmake
+++ b/projects/hipblaslt/cmake/HipBLASLtCodegen.cmake
@@ -8,7 +8,7 @@ function(hipblaslt_create_device_library)
     set(_one
         TARGET LOGIC_PATH OUTPUT_DIR CXX_COMPILER OFFLOAD_BUNDLER JOBS LOGIC_FILTER
         ASAN YAML_FORMAT NO_COMPRESS EXPERIMENTAL LAZY_LOAD ASM_COMMENTS KEEP_BUILD_TMP ASM_DEBUG)
-    set(_multi ARCHES)
+    set(_multi ARCHES LOGIC_ARCHES)
     cmake_parse_arguments(_cdl "${_opts}" "${_one}" "${_multi}" ${ARGN})
 
     if(_cdl_UNPARSED_ARGUMENTS)
@@ -45,6 +45,11 @@ function(hipblaslt_create_device_library)
     file(MAKE_DIRECTORY "${_cdl_OUTPUT_DIR}/library")
 
     list(JOIN _cdl_ARCHES "$<SEMICOLON>" _arches_semi)
+    if(_cdl_LOGIC_ARCHES)
+        list(JOIN _cdl_LOGIC_ARCHES "$<SEMICOLON>" _logic_arches_semi)
+    else()
+        set(_logic_arches_semi "${_arches_semi}")
+    endif()
     set(_opts_list "--architecture=${_arches_semi}" "--cxx-compiler=${_cdl_CXX_COMPILER}")
     if(_cdl_OFFLOAD_BUNDLER)
         list(APPEND _opts_list "--offload-bundler=${_cdl_OFFLOAD_BUNDLER}")
@@ -91,7 +96,7 @@ function(hipblaslt_create_device_library)
             "${_codegen_dir}/Tensile/bin/TensileLogic"
             "${_cdl_LOGIC_PATH}"
             --architecture
-            "${_arches_semi}"
+            "${_logic_arches_semi}"
             --use-bundled-known-bugs
             --check-all
         COMMAND ${CMAKE_COMMAND} -E touch "${_logic_stamp}"
diff --git a/projects/hipblaslt/device-library/CMakeLists.txt b/projects/hipblaslt/device-library/CMakeLists.txt
index 8d7f54e..e33842e 100644
--- a/projects/hipblaslt/device-library/CMakeLists.txt
+++ b/projects/hipblaslt/device-library/CMakeLists.txt
@@ -32,6 +32,7 @@ endif()
 # only prunes which. GPU_TARGETS is untouched (it also feeds extops/transform/
 # validation on the base name); only the bare gfx1250 reaches here.
 set(_main_arches ${GPU_TARGETS})
+list(REMOVE_ITEM _main_arches gfx1250-strict)
 set(_build_gfx1250v0 OFF)
 if("gfx1250" IN_LIST GPU_TARGETS)
     if(HIPBLASLT_ASIC_REVISION STREQUAL "v0")
@@ -48,24 +49,52 @@ elseif(HIPBLASLT_ASIC_REVISION STREQUAL "v0")
                     "(${GPU_TARGETS}); nothing in this build is for the v0 revision.")
 endif()
 
-hipblaslt_create_device_library(
-    TARGET tensilelite-device-libraries
-    LOGIC_PATH "${HIPBLASLT_LIBLOGIC_PATH}"
-    OUTPUT_DIR "${HIPBLASLT_TENSILE_LIBPATH}"
-    ARCHES ${_main_arches}
-    CXX_COMPILER "${CMAKE_CXX_COMPILER}"
-    OFFLOAD_BUNDLER "${TENSILELITE_OFFLOADBUNDLER}"
-    JOBS "${TENSILELITE_BUILD_PARALLEL_LEVEL}"
-    LOGIC_FILTER "${TENSILELITE_LOGIC_FILTER}"
-    ASAN "${HIPBLASLT_ENABLE_ASAN}"
-    YAML_FORMAT "${HIPBLASLT_ENABLE_YAML}"
-    NO_COMPRESS "${TENSILELITE_NO_COMPRESS}"
-    EXPERIMENTAL "${TENSILELITE_EXPERIMENTAL}"
-    LAZY_LOAD "${HIPBLASLT_ENABLE_LAZY_LOAD}"
-    ASM_COMMENTS "${TENSILELITE_ENABLE_ASM_COMMENTS}"
-    KEEP_BUILD_TMP "${TENSILELITE_KEEP_BUILD_TMP}"
-    ASM_DEBUG "${TENSILELITE_ASM_DEBUG}"
-)
+if(_main_arches)
+    hipblaslt_create_device_library(
+        TARGET tensilelite-device-libraries
+        LOGIC_PATH "${HIPBLASLT_LIBLOGIC_PATH}"
+        OUTPUT_DIR "${HIPBLASLT_TENSILE_LIBPATH}"
+        ARCHES ${_main_arches}
+        CXX_COMPILER "${CMAKE_CXX_COMPILER}"
+        OFFLOAD_BUNDLER "${TENSILELITE_OFFLOADBUNDLER}"
+        JOBS "${TENSILELITE_BUILD_PARALLEL_LEVEL}"
+        LOGIC_FILTER "${TENSILELITE_LOGIC_FILTER}"
+        ASAN "${HIPBLASLT_ENABLE_ASAN}"
+        YAML_FORMAT "${HIPBLASLT_ENABLE_YAML}"
+        NO_COMPRESS "${TENSILELITE_NO_COMPRESS}"
+        EXPERIMENTAL "${TENSILELITE_EXPERIMENTAL}"
+        LAZY_LOAD "${HIPBLASLT_ENABLE_LAZY_LOAD}"
+        ASM_COMMENTS "${TENSILELITE_ENABLE_ASM_COMMENTS}"
+        KEEP_BUILD_TMP "${TENSILELITE_KEEP_BUILD_TMP}"
+        ASM_DEBUG "${TENSILELITE_ASM_DEBUG}"
+    )
+endif()
+
+if("gfx1250-strict" IN_LIST GPU_TARGETS)
+    set(_strict_output_dir "${HIPBLASLT_TENSILE_LIBPATH}-strict")
+    file(MAKE_DIRECTORY "${_strict_output_dir}/library/gfx1250-strict")
+    set_property(GLOBAL PROPERTY HIPBLASLT_STRICT_LIBRARY_DIR
+                 "${_strict_output_dir}/library/gfx1250-strict")
+    hipblaslt_create_device_library(
+        TARGET tensilelite-device-libraries-strict
+        LOGIC_PATH "${HIPBLASLT_LIBLOGIC_PATH}"
+        OUTPUT_DIR "${_strict_output_dir}"
+        ARCHES gfx1250-strict
+        LOGIC_ARCHES gfx1250v0
+        CXX_COMPILER "${CMAKE_CXX_COMPILER}"
+        OFFLOAD_BUNDLER "${TENSILELITE_OFFLOADBUNDLER}"
+        JOBS "${TENSILELITE_BUILD_PARALLEL_LEVEL}"
+        LOGIC_FILTER "${TENSILELITE_LOGIC_FILTER}"
+        ASAN "${HIPBLASLT_ENABLE_ASAN}"
+        YAML_FORMAT "${HIPBLASLT_ENABLE_YAML}"
+        NO_COMPRESS "${TENSILELITE_NO_COMPRESS}"
+        EXPERIMENTAL "${TENSILELITE_EXPERIMENTAL}"
+        LAZY_LOAD "${HIPBLASLT_ENABLE_LAZY_LOAD}"
+        ASM_COMMENTS "${TENSILELITE_ENABLE_ASM_COMMENTS}"
+        KEEP_BUILD_TMP "${TENSILELITE_KEEP_BUILD_TMP}"
+        ASM_DEBUG "${TENSILELITE_ASM_DEBUG}"
+    )
+endif()
 
 if(_build_gfx1250v0)
     # Needs its own OUTPUT_DIR: the two runs share a compiler target and each
