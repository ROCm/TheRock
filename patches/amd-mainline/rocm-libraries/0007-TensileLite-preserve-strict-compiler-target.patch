 set(matrix_transform_cpp "${CMAKE_CURRENT_SOURCE_DIR}/matrix_transform.cpp")
diff --git a/projects/hipblaslt/library/include/hipblaslt/hipblaslt_bfloat6.h b/projects/hipblaslt/library/include/hipblaslt/hipblaslt_bfloat6.h
index 822bd06..0f3786f 100644
