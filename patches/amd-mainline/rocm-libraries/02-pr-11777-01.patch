--- /dev/null
+++ b/shared/stinkytofu/tests/filecheck/gfx1250-strict/coissue_matrix_fmt_override_strict.stir
@@ -0,0 +1,26 @@
+# RUN: %stinkytofu-opt --arch gfx1250-strict %s --print-output
+#
+# gfx1250-strict shares the {12,5,0} ISA triple with gfx1250, so the triple alone
+# cannot pick a stepping -- the name has to. gfx1250-strict's costs are double
+# gfx1250's, so a lookup that fell through to gfx1250 would read 4 and 8 here
+# instead of 8 and 16.
+#
+# CHECK-LABEL: @override
+#
+# FP4xFP4: cost override -> latencyCycles = 8 (gfx1250 would be 4)
+# CHECK: v_wmma_f32_16x16x128_f8f6f4
+# CHECK-SAME: latencyCycles = 8
+# CHECK-SAME: fmtA = "MATRIX_FMT_FP4"
+# CHECK-SAME: fmtB = "MATRIX_FMT_FP4"
+#
+# FP8xFP8: base cost -> latencyCycles = 16 (gfx1250 would be 8)
+# CHECK: v_wmma_f32_16x16x128_f8f6f4
+# CHECK-SAME: latencyCycles = 16
+# CHECK-SAME: fmtA = "MATRIX_FMT_FP8"
+# CHECK-SAME: fmtB = "MATRIX_FMT_FP8"
+
+st.func @override() {
+^entry:
+  v[0:7] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[30:45], v[0:7]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP4, fmtB = MATRIX_FMT_FP4 } }
+  v[8:15] = "st.v_wmma_f32_16x16x128_f8f6f4"(v[20:35], v[30:45], v[8:15]) { mod.matrix_fmt = { fmtA = MATRIX_FMT_FP8, fmtB = MATRIX_FMT_FP8 } }
+}
