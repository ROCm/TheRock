-                                "gfx1200;gfx1201;gfx1250")
+                                "gfx1200;gfx1201;gfx1250;gfx1250-strict")
     else()
         set(DEFAULT_GPU_TARGETS "gfx803;gfx900;gfx906;gfx908")
     endif()
