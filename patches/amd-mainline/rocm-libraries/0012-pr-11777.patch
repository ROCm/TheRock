+GlobalParameters:
+  SyncsPerBenchmark: 0
+  NumElementsToValidate: -1
+  KernelTime: True
+  BoundsCheck: 0
+  PrintSolutionRejectionReason: True
+  PrintWinnersOnly: False
+  ValidationMaxToPrint: 4      # maximum number of mismatches to print
+  ValidationPrintValids: False # print matches too
+  # DataInitValueActivationArgs: [0.5, -1]
+  Architecture: gfx1250-strict
+  # DataInitTypeBeta: 0
+  # DataInitTypeAlpha: 1
+  # DataInitTypeBias: 0
+  # DataInitTypeA: 1
+  # DataInitTypeB: 8
+  # DataInitTypeScaleAlphaVec: 1
+  # PruneSparseMode: 1
+  # PrintTensorA: 1
+  # PrintTensorB: 1
+  # PrintTensorC: 0
+  # PrintTensorD: 1
+  # PrintTensorRef: 1
+  # GenerateSourcesAndExit: True
+
+BenchmarkProblems:
+  #######################################
+  # NN - standard
+  #######################################
+  -
+    - # ProblemType
+      OperationType: GEMM
+      DataType: b
+      DestDataType: b
+      ComputeDataType: s
+      HighPrecisionAccumulate:  True
+      TransposeA: False
+      TransposeB: False
+      UseBeta: True
+      UseBias: 3
+      Batched: True
+      Activation: True
+      ActivationType: all
+      UseScaleAlphaVec: 3
+      Sparse: 1
+
+    - # BenchmarkProblemSizeGroup - Standard
+      InitialSolutionParameters:
+      BenchmarkCommonParameters:
+        - KernelLanguage: ["Assembly"]
+      ForkParameters:
+        - MatrixInstruction:
+          # - [16, 16, 64, 1, 1, 1, 1, 1, 1] # m, n = 16, k = 64
+          # - [16, 16, 64, 1, 1, 1, 1, 2, 2] # m, n = 16, k = 64
+          # - [16, 16, 64, 1, 1, 2, 2, 1, 1] # m, n = 16, k = 64
+          # - [16, 16, 64, 1, 1, 2, 2, 2, 2] # m, n = 16, k = 64
+          # - [16, 16, 64, 1, 1, 1, 3, 2, 2] # m, n = 16, k = 64
+          # - [16, 16, 64, 1, 1, 3, 1, 2, 2] # m, n = 16, k = 64
+          - [16, 16, 64, 1, 1, 4, 4, 2, 2] # m, n = 16, k = 64
+          # - [16, 16, 64, 1, 1, 8, 8, 2, 2] # m, n = 16, k = 64
+        - PrefetchGlobalRead: [2]
+        - PrefetchLocalRead: [1]
+        - DepthU: [64, 128]
+        - WavefrontSize: [32] # from 64 -> 32 !!!
+        - ScheduleIterAlg: [3]
+        - TransposeLDS: [-1]
+        - SourceSwap: [false]
+        - LdsPadA: [-1]
+        - LdsPadB: [-1]
+        - LdsPadMetadata: [-1]
+        - GlobalSplitU: [1, 2]
+        - GlobalSplitUAlgorithm: [MultipleBuffer]
+        - 1LDSBuffer: [-1]
+        # - VectorWidthA: [1, 2, 4, 8]
+        # - VectorWidthB: [1, 2, 4, 8]
+        - GlobalReadVectorWidthA: [-1]
+        - GlobalReadVectorWidthB: [-1]
+        #- AssertSummationElementMultiple: [8]
+      BenchmarkForkParameters:
+      JoinParameters:
