+# Both tests stub the whole pipeline, so they need no toolchain and no GPU.
+# =========================================================================== #
+def _stub_iim():
+    """What `makeIsaInfoMap` returns for a gfx1250 build, minus the real probe."""
+    return {ISA_GFX1250: IsaInfo({"SupportedISA": True}, {}, {}, {})}
