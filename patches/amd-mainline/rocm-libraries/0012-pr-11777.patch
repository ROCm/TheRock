+    captured = []
+    monkeypatch.setattr(ComponentMod, "_getVersion", lambda *a, **k: None)
+    monkeypatch.setattr(ComponentMod, "_invoke", lambda args, desc: captured.append(args))
+    assembler = ComponentMod.Assembler(Path("amdclang++"), 5)
