+def _write_min_config(tmp_path, **globalParams):
+    import yaml
+
+    path = tmp_path / "config.yaml"
+    path.write_text(
+        yaml.safe_dump(
+            {
+                "GlobalParameters": {
+                    "MinimumRequiredVersion": "5.0.0",
+                    **globalParams,
+                },
+                "BenchmarkProblems": [],
+            }
+        ),
+        encoding="utf-8",
+    )
+    return str(path)
