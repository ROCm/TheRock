+    tasksPath = Path(__file__).resolve().parents[3] / "tasks.py"
+    spec = importlib.util.spec_from_file_location("tensilelite_tasks", tasksPath)
+    tasks = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(tasks)
