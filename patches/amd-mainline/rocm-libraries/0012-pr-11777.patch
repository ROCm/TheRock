+        "DataType": "F4",
+        "DestDataType": "s",
+        "ComputeDataType": "s",
+        "HighPrecisionAccumulate": True,
+        "TransposeA": True,  # TN
+        "TransposeB": False,
+        "UseBeta": True,
+        "Batched": True,
