diff --git a/shared/stinkytofu/tests/filecheck/gfx1250-strict/coissue_matrix_fmt_override_strict.stir b/shared/stinkytofu/tests/filecheck/gfx1250-strict/coissue_matrix_fmt_override_strict.stir
