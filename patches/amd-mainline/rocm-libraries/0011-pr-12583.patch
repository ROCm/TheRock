@@ -820,25 +820,28 @@ TEST_F(DAGSchedulerPassTest, WmmaHideBudgetCountsSplitBarrierGroupOnce) {
 }
 
 // ---------------------------------------------------------------------------
-// HWModel::Lds::wavesPerDsIssuePipe (the ds issue pipe shared between waves)
