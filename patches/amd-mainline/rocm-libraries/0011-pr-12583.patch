diff --git a/shared/stinkytofu/src/transforms/asm/dag/CDNA5.hpp b/shared/stinkytofu/src/transforms/asm/dag/CDNA5.hpp
index 31708565c6f0..0d9741f0b897 100644
--- a/shared/stinkytofu/src/transforms/asm/dag/CDNA5.hpp
