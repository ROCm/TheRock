diff --git a/shared/stinkytofu/src/hardware/HWModel.cpp b/shared/stinkytofu/src/hardware/HWModel.cpp
index 9e0fb7e59bf8..28fbc854ae91 100644
--- a/shared/stinkytofu/src/hardware/HWModel.cpp
