+###############################################################################
+# fast_check placement (AIHPBLAS-4994).
+#
+# Some address defects depend on where a buffer sits, not on problem size: a
+# kernel that drops the carry out of the low 32 bits of an address (ROCM-32046)
+# goes wrong only when a buffer crosses a 4 GiB boundary, and the wrong access
+# lands exactly 4 GiB away, outside every allocation. These cases place one
+# operand at a time across a 4 GiB virtual-address boundary (by default half of
+# it on each side) with poison memory mapped 4 GiB below and above it. A
+# dropped-carry read returns poison and fast_check reports a wrong D; a
+# dropped-carry write changes the poison and the test reports it. The defect
+# does not depend on size, so small shapes suffice, and every solution runs
+# because such defects are specific to a few kernels.
+###############################################################################
+
+# Every PR: each operand placed in turn, with the heuristic's first 16 solutions.
+# The workspace is placed only in the all-solutions cases below: at this shape
+# none of the first 16 f32 solutions uses one.
+# Runtime on gfx942: 8 cases, about 4 s.
+- name: matmul_fast_check_placement
+  category: pre_checkin
+  function:
+    matmul:
+      - *single_precision
+      - *hpa_bf16_precision
+  matrix_size:
+    - { M: 1031, N: 517, K: 263 }
+  transA: N
+  transB: N
+  alpha: 2.0
+  beta: -2.0
+  placement: [ a, b, c, d ]
+  requested_solution_num: 16
+  initialization: integer_exact
+  unit_check: 0
+  fast_check: 1
+
