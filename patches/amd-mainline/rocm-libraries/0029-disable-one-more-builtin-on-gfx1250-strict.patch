 projects/composablekernel/include/ck/utility/type_convert.hpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/projects/composablekernel/include/ck/utility/type_convert.hpp b/projects/composablekernel/include/ck/utility/type_convert.hpp
index 4d0b9a2a..38686de2 100644
--- a/projects/composablekernel/include/ck/utility/type_convert.hpp
+++ b/projects/composablekernel/include/ck/utility/type_convert.hpp
@@ -1293,7 +1293,7 @@ inline __host__ __device__ bhalf2_t type_convert<bhalf2_t, bf8x2_ocp_t>(bf8x2_oc
 {
 #if defined(__gfx950__)
     return __builtin_amdgcn_cvt_scalef32_pk_bf16_bf8(bit_cast<uint16_t>(x), /*scale*/ 1.f, 0);
