+    /// the bare ISA number (DsLoadDrainInputs::isaIssueCycles). Named
+    /// differently from that raw field, and computed once here, so no
+    /// consumer can read this and forget to apply the wave-sharing
+    /// multiplier.
+    int issueSpacing = 0;
