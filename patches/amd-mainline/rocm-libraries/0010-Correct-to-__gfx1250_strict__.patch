From 15202fe55292155fef2c78cd530e45eb65102113 Mon Sep 17 00:00:00 2001
From: Stanley Tsang <stanley.tsang@amd.com>
Date: Mon, 14 Sep 2026 16:44:05 -0600
Subject: [PATCH] Correct to __gfx1250_strict__

---
 projects/rocprim/rocprim/include/rocprim/config.hpp             | 2 +-
 .../include/rocprim/device/detail/lookback_scan_state.hpp       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/projects/rocprim/rocprim/include/rocprim/config.hpp b/projects/rocprim/rocprim/include/rocprim/config.hpp
index a7b2fb06..775cfec0 100644
--- a/projects/rocprim/rocprim/include/rocprim/config.hpp
+++ b/projects/rocprim/rocprim/include/rocprim/config.hpp
@@ -120,7 +120,7 @@
 #undef ROCPRIM_TARGET_UNKNOWN
 
 // See https://llvm.org/docs/AMDGPUUsage.html#instructions
-#if defined(__gfx1250__) || defined(__gfx1250-strict__)
+#if defined(__gfx1250__) || defined(__gfx1250_strict__)
     #define ROCPRIM_TARGET_CDNA5 1
 #elif defined(__gfx942__) || defined(__gfx9_4_generic__)
     #define ROCPRIM_TARGET_CDNA3 1
diff --git a/projects/rocprim/rocprim/include/rocprim/device/detail/lookback_scan_state.hpp b/projects/rocprim/rocprim/include/rocprim/device/detail/lookback_scan_state.hpp
index 836b9994..9f31f5af 100644
--- a/projects/rocprim/rocprim/include/rocprim/device/detail/lookback_scan_state.hpp
+++ b/projects/rocprim/rocprim/include/rocprim/device/detail/lookback_scan_state.hpp
@@ -47,7 +47,7 @@
 // cache.
 #ifndef ROCPRIM_DETAIL_LOOKBACK_SCAN_STATE_WITHOUT_SLOW_FENCES
     #if defined(__HIP_DEVICE_COMPILE__) && (defined(__gfx942__) || defined(__gfx950__) || defined(__gfx9_4_generic__) ||
-        defined(__gfx1250__) || defined(__gfx1250-strict__))
+        defined(__gfx1250__) || defined(__gfx1250_strict__))
         #define ROCPRIM_DETAIL_LOOKBACK_SCAN_STATE_WITHOUT_SLOW_FENCES 1
     #else
         #define ROCPRIM_DETAIL_LOOKBACK_SCAN_STATE_WITHOUT_SLOW_FENCES 0
-- 
2.43.0

