From 1fd57bf2760d7946b470b9bcec466b23cd8e2cc3 Mon Sep 17 00:00:00 2001
From: Stanley Tsang <stanley.tsang@amd.com>
Date: Thu, 3 Sep 2026 11:22:33 -0600
Subject: [PATCH] Add CDNA4 to atomic.hpp

---
 .../rocprim/rocprim/include/rocprim/device/config_types.hpp   | 4 ++--
 .../rocprim/rocprim/include/rocprim/intrinsics/atomic.hpp     | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/projects/rocprim/rocprim/include/rocprim/device/config_types.hpp b/projects/rocprim/rocprim/include/rocprim/device/config_types.hpp
index fe8cbbcc..c81239c6 100644
--- a/projects/rocprim/rocprim/include/rocprim/device/config_types.hpp
+++ b/projects/rocprim/rocprim/include/rocprim/device/config_types.hpp
@@ -211,7 +211,7 @@ enum class gen
     rdna1,
     rdna2,
     rdna3,
-    rdna4,
+    rdna4
 };
 
 enum class gpu
@@ -230,7 +230,7 @@ enum class gpu
     mi308x,
     mi325x,
     mi350x,
-    mi455x,
+    mi455x
 };
 
 constexpr gen gen_from_target_arch(target_arch i)
diff --git a/projects/rocprim/rocprim/include/rocprim/intrinsics/atomic.hpp b/projects/rocprim/rocprim/include/rocprim/intrinsics/atomic.hpp
index 8b962757..76796ee6 100644
--- a/projects/rocprim/rocprim/include/rocprim/intrinsics/atomic.hpp
+++ b/projects/rocprim/rocprim/include/rocprim/intrinsics/atomic.hpp
@@ -172,7 +172,7 @@ namespace detail
 #define ROCPRIM_ATOMIC_LOAD(inst, mod, wait, ptr) \
     asm volatile(inst " %0, %1 " mod "\t\n" wait : "=v"(result) : "v"(ptr) : "memory")
 
-#if ROCPRIM_TARGET_CDNA3
+#if ROCPRIM_TARGET_CDNA3 || ROCPRIM_TARGET_CDNA4
     #define ROCPRIM_ATOMIC_LOAD_FLAT(ptr) \
         ROCPRIM_ATOMIC_LOAD("flat_load_dwordx4", "sc1", "s_waitcnt vmcnt(0)", ptr)
     #define ROCPRIM_ATOMIC_LOAD_SHARED(ptr) \
@@ -289,7 +289,7 @@ namespace detail
 #define ROCPRIM_ATOMIC_STORE(inst, mod, wait, ptr) \
     asm volatile(inst " %0, %1 " mod "\t\n" wait : : "v"(ptr), "v"(value) : "memory")
 
-#if ROCPRIM_TARGET_CDNA3
+#if ROCPRIM_TARGET_CDNA3 || ROCPRIM_TARGET_CDNA4
     #define ROCPRIM_ATOMIC_STORE_FLAT(ptr) \
         ROCPRIM_ATOMIC_STORE("flat_store_dwordx4", "sc1", "s_waitcnt vmcnt(0)", ptr)
     #define ROCPRIM_ATOMIC_STORE_SHARED(ptr) \
-- 
2.43.0

