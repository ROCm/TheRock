+// gating, which is correct either way.
+#define HIP_ENABLE_GFX1250_PK8_SCALE_BUILTINS 0
+#endif
 #if !defined(__gfx950__) && !defined(__gfx1250__) && !defined(__gfx1250_strict__)
 #define HIP_ENABLE_HOST_OCP_CONVERSIONS 1
 #else
