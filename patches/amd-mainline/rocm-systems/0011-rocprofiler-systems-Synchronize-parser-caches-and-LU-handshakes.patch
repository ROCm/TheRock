From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sahil Faizal <sahil.faizal@amd.com>
Date: Wed, 11 Nov 2026 09:30:00 -0800
Subject: [PATCH] rocprofiler-systems: Synchronize parser caches and LU handshakes

CSAN reports a shared block ID increment and aggregate symbol cache reads
racing with parallel Dyninst parser updates. Use an atomic relaxed counter
for unique IDs and the aggregate's existing mutex for cached state reads.
Apply the pinned nested dependency patch during configure, accepting an
already patched tree and rejecting an unknown source version.

Replace LU's shared plain flags with release/acquire atomic handshakes so
its work publication and consumption have real synchronization. Preserve
the prepared CSAN, HSA and report initializer preload chain when the test
framework launches a child with its own profiler preload.

Source: ROCm/rocm-systems bd1130f9f838cfffd24f41fd3052968fb7cae4e0
Nested source: ROCm/dyninst f6adfaf155ab0de83f912efb5b8b3a44b14d20c7
Reproduction: https://github.com/ROCm/TheRock/actions/runs/43014650567
Validation: actual artifact Clang/CSAN builds the patched Dyninst. The exact
native Ubuntu CPU simulate-ls command reproduces the counter race before
this fix and passes after it with all twelve fresh diagnostic files, parsed
JSON/XML and no CSAN reports. It takes about 972 seconds; the earlier
300/900-second timeout results are retained. Actual LU reproduces the flag
race before the fix; fixed NAS class S passes numerical verification with
four threads and no CSAN reports. Both added pytest cases pass, and an
actual published-runtime child retains the profiler DSO and CSAN report
prefix. Nested patch apply/idempotence/unknown-base controls pass.
No instrumentation or test assertions are disabled.
Carry temporarily in TheRock pending upstream profiler/Dyninst review.
---
diff --git a/projects/rocprofiler-systems/cmake/Packages.cmake b/projects/rocprofiler-systems/cmake/Packages.cmake
index c22667c..cf030a6 100644
--- a/projects/rocprofiler-systems/cmake/Packages.cmake
+++ b/projects/rocprofiler-systems/cmake/Packages.cmake
@@ -458,6 +458,39 @@ if(ROCPROFSYS_BUILD_DYNINST)
         REPO_BRANCH dyninst_13
     )
 
+    # Keep the nested dependency's concurrent parser caches race-free. Accept
+    # an already-patched source tree, but never silently build an unknown base.
+    find_package(Git REQUIRED)
+    set(_dyninst_thread_patch "${CMAKE_CURRENT_LIST_DIR}/dyninst-thread-safety.patch")
+    # An unpacked dependency may live inside another repository's ignored
+    # directory. Stop discovery before that outer repository to prevent Git
+    # from silently skipping all patch paths relative to its worktree prefix.
+    set(_dyninst_patch_git "${CMAKE_COMMAND}" -E env
+        "GIT_CEILING_DIRECTORIES=${PROJECT_SOURCE_DIR}/external" "${GIT_EXECUTABLE}")
+    execute_process(
+        COMMAND ${_dyninst_patch_git} apply --check -- "${_dyninst_thread_patch}"
+        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}/external/dyninst"
+        RESULT_VARIABLE _dyninst_patch_check ERROR_VARIABLE _dyninst_patch_error
+    )
+    if(_dyninst_patch_check EQUAL 0)
+        execute_process(
+            COMMAND ${_dyninst_patch_git} apply -- "${_dyninst_thread_patch}"
+            WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}/external/dyninst"
+            RESULT_VARIABLE _dyninst_patch_result
+        )
+        if(NOT _dyninst_patch_result EQUAL 0)
+            message(FATAL_ERROR "Cannot apply Dyninst thread-safety patch")
+        endif()
+    endif()
+    execute_process(
+        COMMAND ${_dyninst_patch_git} apply --reverse --check -- "${_dyninst_thread_patch}"
+        WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}/external/dyninst"
+        RESULT_VARIABLE _dyninst_reverse_check ERROR_QUIET
+    )
+    if(NOT _dyninst_reverse_check EQUAL 0)
+        message(FATAL_ERROR "Unexpected Dyninst source for thread-safety patch: ${_dyninst_patch_error}")
+    endif()
+
     set(DYNINST_OPTION_PREFIX ON)
     set(DYNINST_BUILD_DOCS OFF)
     set(DYNINST_BUILD_RTLIB OFF)
