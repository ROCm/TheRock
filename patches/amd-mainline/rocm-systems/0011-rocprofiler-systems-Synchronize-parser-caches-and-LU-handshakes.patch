+diff --git a/symtabAPI/src/Aggregate.C b/symtabAPI/src/Aggregate.C
+index c0dbdb5..18dc3ec 100644
+--- a/symtabAPI/src/Aggregate.C
++++ b/symtabAPI/src/Aggregate.C
+@@ -74,7 +74,8 @@ Aggregate::Aggregate(Module *mod) :
+ }
+ 
+ Offset Aggregate::getOffset() const 
+-{ 
++{
++    dyncompat::unique_lock<dyn_mutex> l(lock_);
+ 	if (!firstSymbol)
+ 	{
+ 		return (Offset) 0L;
+@@ -83,7 +84,8 @@ Offset Aggregate::getOffset() const
+ }
+ 
+ unsigned Aggregate::getSize() const 
+-{ 
++{
++    dyncompat::unique_lock<dyn_mutex> l(lock_);
+ 	if (!firstSymbol)
+ 	{
+ 		return (unsigned) 0;
+@@ -103,14 +105,13 @@ Region * Aggregate::getRegion() const
+ }
+ 
+ bool Aggregate::addSymbol(Symbol *sym) {
++    dyncompat::unique_lock<dyn_mutex> l(lock_);
+ 
+     // We keep a "primary" module.
+     if (module_ == NULL) {
+         module_ = sym->getModule();
+     }
+ 
+-    dyncompat::unique_lock<dyn_mutex> l(lock_);
+-
+     // No need to re-add symbols.
+     for (unsigned i = 0; i < symbols_.size(); ++i)
+         if (sym == symbols_[i]) return true;
+@@ -142,12 +143,14 @@ bool Aggregate::removeSymbolInt(Symbol *sym) {
+ 
+ bool Aggregate::getSymbols(std::vector<Symbol *> &syms) const 
+ {
++    dyncompat::unique_lock<dyn_mutex> l(lock_);
+     syms = symbols_;
+     return true;
+ }
+ 
+ Symbol * Aggregate::getFirstSymbol() const
+ {
++    dyncompat::unique_lock<dyn_mutex> l(lock_);
+     return firstSymbol;
+ }
+ 
+diff --git a/symtabAPI/h/Aggregate.h b/symtabAPI/h/Aggregate.h
+index da078ae..9c0a2f5 100644
+--- a/symtabAPI/h/Aggregate.h
++++ b/symtabAPI/h/Aggregate.h
+@@ -74,7 +74,7 @@ class SYMTAB_EXPORT Aggregate
+ 
+       virtual Offset   getOffset() const;
+       virtual unsigned getSize() const;
+-      Module * getModule() const { return module_; }
++      Module * getModule() const { dyncompat::unique_lock<dyn_mutex> l(lock_); return module_; }
+       Region * getRegion() const;
+ 
+       /***** Symbol Collection Management *****/
