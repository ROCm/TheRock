             {
 #pragma omp flush
                 ;
@@ -441,7 +443,7 @@ blts(int /*nx*/, int /*ny*/, int /*nz*/, int k, double omega,
         }
         if(j != jend - 1)
         {
-            while(flag[j] == 1)
+            while(flag[j].load(std::memory_order_acquire) == 1)
             {
 #pragma omp flush
                 ;
@@ -560,8 +562,8 @@ blts(int /*nx*/, int /*ny*/, int /*nz*/, int k, double omega,
             v[k][j][i][0] = tv[0] / tmat[0][0];
         }
 
-        if(j != jend - 1) flag[j] = 1;
-        if(j != jst) flag[j - 1] = 0;
+        if(j != jend - 1) flag[j].store(1, std::memory_order_release);
