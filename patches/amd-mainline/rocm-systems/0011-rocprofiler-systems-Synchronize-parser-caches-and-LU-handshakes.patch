diff --git a/projects/rocprofiler-systems/tests/pytest/rocprofsys/environment.py b/projects/rocprofiler-systems/tests/pytest/rocprofsys/environment.py
index fea670a..59bf00a 100644
--- a/projects/rocprofiler-systems/tests/pytest/rocprofsys/environment.py
+++ b/projects/rocprofiler-systems/tests/pytest/rocprofsys/environment.py
@@ -33,6 +33,7 @@ The following environment variables are excluded from the user layer overrides:
 from __future__ import annotations
 
 import os
+import re
 from dataclasses import dataclass, field
 from enum import Enum
 from typing import TYPE_CHECKING
@@ -131,6 +132,21 @@ class TestEnvironment:
         merged = self.merge()[0]
         for key, value in derived_defaults(config).items():
             merged.setdefault(key, value)
+        if os.environ.get("CSAN_REPORT_PREFIX"):
+            prepared = re.split(r"[:\s]+", os.environ.get("LD_PRELOAD", ""))
+            required = [
+                os.environ.get("CSAN_RUNTIME_PATH", ""),
+                os.environ.get("CSAN_HSA_RUNTIME_PATH", ""),
+                os.environ.get("CSAN_REPORT_PRELOAD_PATH", ""),
+            ]
+            if not all(required) or prepared[:3] != required:
+                raise ValueError("Missing prepared CSAN runtime:HSA:report preload chain")
+            # Keep sanitizer interception/reporting ahead of the profiler's own
+            # loader, including tests that explicitly override LD_PRELOAD.
+            additional = re.split(r"[:\s]+", merged.get("LD_PRELOAD", ""))
+            merged["LD_PRELOAD"] = ":".join(
+                dict.fromkeys(filter(None, prepared + additional))
+            )
         return merged
 
     def format_layers(self) -> list[str]:
diff --git a/projects/rocprofiler-systems/tests/pytest/test_pytest_impl.py b/projects/rocprofiler-systems/tests/pytest/test_pytest_impl.py
index bb95533..55dd43c 100644
--- a/projects/rocprofiler-systems/tests/pytest/test_pytest_impl.py
+++ b/projects/rocprofiler-systems/tests/pytest/test_pytest_impl.py
@@ -36,6 +36,56 @@ from rocprofsys.runners import (
 pytestmark = [pytest.mark.pytest_impl]
 
 
+def test_csan_child_retains_runtime_hsa_report_and_test_preload(monkeypatch):
+    import subprocess
+    import sys
+    from rocprofsys.environment import TestEnvironment
+
+    chain = "/missing/csan.so:/missing/hsa.so:/missing/report.so:/missing/caller.so"
+    for key, value in {
+        "CSAN_REPORT_PREFIX": "/tmp/csan-report",
+        "CSAN_RUNTIME_PATH": "/missing/csan.so",
+        "CSAN_HSA_RUNTIME_PATH": "/missing/hsa.so",
+        "CSAN_REPORT_PRELOAD_PATH": "/missing/report.so",
+        "LD_PRELOAD": chain,
+    }.items():
+        monkeypatch.setenv(key, value)
+    environment = TestEnvironment()
+    environment.set_user_environment()
+    environment.set_test_environment(
+        {"LD_PRELOAD": "/missing/profiler.so:/missing/csan.so"}
+    )
+    config = MagicMock()
+    config.rocm_path = None
+    merged = environment.get_merged_environment(config)
+    expected = chain + ":/missing/profiler.so"
+    assert merged["LD_PRELOAD"] == expected
+    merged["EXPECTED_PRELOAD"] = expected
+    subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            "import os; assert os.environ['LD_PRELOAD'] == os.environ['EXPECTED_PRELOAD']",
+        ],
+        env=merged,
+        check=True,
+    )
+    monkeypatch.setenv("LD_PRELOAD", "/missing/csan.so")
+    with pytest.raises(ValueError, match="prepared CSAN"):
+        environment.get_merged_environment(config)
+
+
+def test_ordinary_preload_override_is_unchanged(monkeypatch):
+    from rocprofsys.environment import TestEnvironment
+
+    monkeypatch.delenv("CSAN_REPORT_PREFIX", raising=False)
+    environment = TestEnvironment()
+    environment.set_test_environment({"LD_PRELOAD": "test-owned.so"})
+    config = MagicMock()
+    config.rocm_path = None
+    assert environment.get_merged_environment(config)["LD_PRELOAD"] == "test-owned.so"
+
+
