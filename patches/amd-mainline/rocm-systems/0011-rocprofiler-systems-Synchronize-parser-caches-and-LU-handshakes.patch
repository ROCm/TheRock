@@ -620,7 +622,7 @@ buts(int /*nx*/, int /*ny*/, int /*nz*/, int k, double omega,
         }
         if(j != jst)
         {
-            while(flag2[j] == 1)
+            while(flag2[j].load(std::memory_order_acquire) == 1)
             {
 #pragma omp flush
