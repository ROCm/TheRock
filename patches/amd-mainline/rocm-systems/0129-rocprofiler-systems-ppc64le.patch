diff --git a/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main.c b/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main.c
index 31b58bdf6b..3c42418839 100644
--- a/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main.c
+++ b/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main.c
@@ -38,19 +38,6 @@
 //
 typedef int (*main_func_t)(int, char**, char**);
 typedef void (*init_func_t)(void);
-typedef int (*start_main_t)(int (*)(int, char**, char**), int, char**, void (*)(void),
-                            void (*)(void), void (*)(void), void*);
-
-//
-// local function declarations
-//
-int
-rocprofsys_libc_start_main(int (*)(int, char**, char**), int, char**, void (*)(void),
-                           void (*)(void), void (*)(void), void*) ROCPROFSYS_INTERNAL_API;
-
-int
-__libc_start_main(int (*)(int, char**, char**), int, char**, void (*)(void),
-                  void (*)(void), void (*)(void), void*) ROCPROFSYS_PUBLIC_API;
 
 //
 // external function declarations
@@ -90,6 +77,85 @@ rocprofsys_main_init(void) ROCPROFSYS_INTERNAL_API;
 extern int
 rocprofsys_main(int argc, char** argv, char** envp) ROCPROFSYS_INTERNAL_API;
 
+#if defined(__powerpc64__)
+
+// On ppc64le (ELFv2 ABI), _start passes arguments to __libc_start_main via
+// a startup_info structure pointer in r8 and the original stack pointer in r9.
+// The main function pointer lives at offset 8 in the startup_info struct.
+// Registers r3-r7 are NOT initialised by _start.
+//
+// Strategy: we interpose __libc_start_main, read r8 to get the startup_info
+// pointer, swap the main function pointer in the struct, then tail-call the
+// real __libc_start_main with all original register values preserved.
+
+struct startup_info
+{
+    void* sda_base;
+    int (*main)(int, char**, char**, void*);
+    int (*init)(int, char**, char**, void*);
+    void (*fini)(void);
+};
+
+// Resolved lazily by the patch function (constructors have not run yet
+// when _start calls __libc_start_main)
+void (*_real_libc_start_main)(void) = NULL;
+
+// The startup_info struct is in read-only memory, so we cannot modify it
+// in-place.  Instead we create a writable copy, patch the main pointer in
+// the copy, and return the copy's address.  The asm trampoline writes the
+// returned pointer back into r8 before tail-calling the real __libc_start_main.
+//
+// Called from the asm trampoline with stinfo in r3.
+// Returns the (possibly new) stinfo pointer to use.
+struct startup_info*
+rocprofsys_ppc64_patch_stinfo(struct startup_info* stinfo) ROCPROFSYS_INTERNAL_API;
+
+static struct startup_info _patched_stinfo;
+
+struct startup_info*
+rocprofsys_ppc64_patch_stinfo(struct startup_info* stinfo)
+{
+    if(!_real_libc_start_main)
+    {
+        _real_libc_start_main = dlvsym(RTLD_NEXT, "__libc_start_main", "GLIBC_2.34");
+        if(!_real_libc_start_main)
+            _real_libc_start_main = dlvsym(RTLD_NEXT, "__libc_start_main", "GLIBC_2.17");
+        if(!_real_libc_start_main)
+        {
+            fputs("[rocprof-sys] FATAL: cannot resolve real __libc_start_main\n", stderr);
+            _exit(127);
+        }
+    }
+
+    int _preload = rocprofsys_preload_library();
+
+    rocprofsys_set_main((main_func_t) stinfo->main);
+
+    setenv("ROCPROFSYS_PRELOAD", "0", 1);
+
+    if(_preload != 0)
+    {
+        // Copy the read-only struct and patch the copy
+        _patched_stinfo = *stinfo;
+        _patched_stinfo.main = (int (*)(int, char**, char**, void*)) rocprofsys_main;
+        return &_patched_stinfo;
+    }
+    return stinfo;
+}
+
+#else /* x86_64 / other architectures */
+
+typedef int (*start_main_t)(int (*)(int, char**, char**), int, char**, void (*)(void),
+                            void (*)(void), void (*)(void), void*);
+
+int
+rocprofsys_libc_start_main(int (*)(int, char**, char**), int, char**, void (*)(void),
+                           void (*)(void), void (*)(void), void*) ROCPROFSYS_INTERNAL_API;
+
+int
+__libc_start_main(int (*)(int, char**, char**), int, char**, void (*)(void),
+                  void (*)(void), void (*)(void), void*) ROCPROFSYS_PUBLIC_API;
+
 int
 rocprofsys_libc_start_main(int (*_main)(int, char**, char**), int _argc, char** _argv,
                            void (*_init)(void), void (*_fini)(void),
@@ -124,10 +190,6 @@ rocprofsys_libc_start_main(int (*_main)(int, char**, char**), int _argc, char**
         }
         else
         {
-            // return user_main(rocprofsys_main, _argc, _argv,
-            //                  rocprofsys_main_init, _fini,
-            //                  _rtld_fini, _stack_end);
-
             // call rocprof-sys main function wrapper
             return user_main(rocprofsys_main, _argc, _argv, _init, _fini, _rtld_fini,
                              _stack_end);
@@ -149,3 +211,5 @@ __libc_start_main(int (*_main)(int, char**, char**), int _argc, char** _argv,
     return rocprofsys_libc_start_main(_main, _argc, _argv, _init, _fini, _rtld_fini,
                                       _stack_end);
 }
+
+#endif /* __powerpc64__ */
diff --git a/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main_ppc64le.S b/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main_ppc64le.S
new file mode 100644
index 0000000000..397a62b0b8
--- /dev/null
+++ b/projects/rocprofiler-systems/source/lib/rocprof-sys-dl/main_ppc64le.S
@@ -0,0 +1,85 @@
+// Copyright (c) Advanced Micro Devices, Inc.
+// SPDX-License-Identifier: MIT
+
+#if defined(__powerpc64__)
+
+    .abiversion 2
+    .section ".text"
+    .align 2
+
+    .globl __libc_start_main
+    .type  __libc_start_main, @function
+__libc_start_main:
+0:  addis 2, 12, .TOC.-0b@ha
+    addi  2, 2,  .TOC.-0b@l
+    .localentry __libc_start_main, .-__libc_start_main
+
+    mflr    0
+    std     0,  16(1)
+    std     31, -8(1)
+    std     30, -16(1)
+    std     29, -24(1)
+    std     28, -32(1)
+    std     27, -40(1)
+    std     26, -48(1)
+    std     25, -56(1)
+    std     2,  24(1)
+    stdu    1, -128(1)
+
+    // Save all argument registers
+    mr      25, 3
+    mr      26, 4
+    mr      27, 5
+    mr      28, 6
+    mr      29, 7
+    mr      30, 8           // startup_info*
+    mr      31, 9           // stack_on_entry
+
+    // Call C function: new_stinfo = rocprofsys_ppc64_patch_stinfo(stinfo)
+    mr      3, 8
+    bl      rocprofsys_ppc64_patch_stinfo
+    nop
+    ld      2, 24+128(1)    // restore TOC
+
+    // r3 now has the (possibly new) stinfo pointer — use it as r8
+    mr      30, 3
+
+    // Restore argument registers
+    mr      3, 25
+    mr      4, 26
+    mr      5, 27
+    mr      6, 28
+    mr      7, 29
+    mr      8, 30           // patched stinfo (from return value)
+    mr      9, 31
+
+    // Load the real __libc_start_main address
+    addis   12, 2, .LC_real_start@toc@ha
+    ld      12, .LC_real_start@toc@l(12)
+    ld      12, 0(12)
+
+    // Epilogue
+    addi    1, 1, 128
+    ld      0,  16(1)
+    mtlr    0
+    ld      31, -8(1)
+    ld      30, -16(1)
+    ld      29, -24(1)
+    ld      28, -32(1)
+    ld      27, -40(1)
+    ld      26, -48(1)
+    ld      25, -56(1)
+
+    // Tail-call the real __libc_start_main
+    mtctr   12
+    bctr
+
+    .size __libc_start_main, .-__libc_start_main
+
+    .section ".toc","aw"
+.LC_real_start:
+    .tc _real_libc_start_main[TC], _real_libc_start_main
+
+#endif
+
+.section .note.GNU-stack,"",@progbits
