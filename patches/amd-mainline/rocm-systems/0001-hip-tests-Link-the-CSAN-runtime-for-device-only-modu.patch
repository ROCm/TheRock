From 67acbeb1ed14b3eadd54b2010931062dd3838b1b Mon Sep 17 00:00:00 2001
From: Sahil Faizal <sahil.faizal@amd.com>
Date: Wed, 11 Nov 2026 08:08:20 +0000
Subject: [PATCH 1/2] hip-tests: Link the CSAN runtime for device-only modules

Device-only HIP commands bypass the linker wrapper that normally supplies the CSAN device runtime. Link it only for device-only commands and propagate explicit code-object versions to runtime LTO generation. Mixed HIP targets and SPIR-V keep their existing flags.

Temporary integration patch until the compiler handles CSAN device-only runtime linkage. Reproduced using CI run https://github.com/ROCm/TheRock/actions/runs/42977786346 and validated the full runtime-tests build plus 8 packaging tests in the pinned CI container.
---
 projects/hip-tests/catch/CMakeLists.txt       | 28 ++++++++++
 .../hip-tests/catch/multiproc/CMakeLists.txt  |  2 +-
 .../catch/unit/callback/CMakeLists.txt        |  2 +-
 .../catch/unit/deviceLib/CMakeLists.txt       |  8 +--
 .../catch/unit/dynamicLoading/CMakeLists.txt  |  2 +-
 .../hip-tests/catch/unit/graph/CMakeLists.txt |  4 +-
 .../catch/unit/library/CMakeLists.txt         |  4 +-
 .../catch/unit/module/CMakeLists.txt          | 54 +++++++++----------
 .../catch/unit/occupancy/CMakeLists.txt       |  2 +-
 .../hip-tests/catch/unit/oob/CMakeLists.txt   |  4 +-
 .../catch/unit/synchronization/CMakeLists.txt |  2 +-
 .../catch/unit/texture/CMakeLists.txt         |  2 +-
 12 files changed, 71 insertions(+), 43 deletions(-)

diff --git a/projects/hip-tests/catch/CMakeLists.txt b/projects/hip-tests/catch/CMakeLists.txt
index fab85cbf..a0e6c7a4 100644
--- a/projects/hip-tests/catch/CMakeLists.txt
+++ b/projects/hip-tests/catch/CMakeLists.txt
@@ -335,6 +335,34 @@ if(ENABLE_SPIRV)
   set(HIP_DEVICE_BUILD_FLAGS_NO_ARCH ${HIP_DEVICE_BUILD_FLAGS_NO_ARCH_NO_ASAN})
 endif()
 
+set(HIP_DEVICE_ONLY_BUILD_FLAGS_NO_ARCH ${HIP_DEVICE_BUILD_FLAGS_NO_ARCH})
+set(HIP_DEVICE_CODE_OBJECT_V5_FLAGS -mcode-object-version=5)
+set(HIP_DEVICE_CODE_OBJECT_V6_FLAGS -mcode-object-version=6)
+
+# Device-only module commands use the legacy HIP device linker, which does not
+# add CSAN's runtime. Mixed host/device targets already link it automatically,
+# so extend only the custom-command flags and leave SPIR-V flags unchanged.
+if(THEROCK_SANITIZER STREQUAL "CSAN" AND NOT ENABLE_SPIRV)
+  execute_process(COMMAND "${CMAKE_HIP_COMPILER}" --print-resource-dir
+    OUTPUT_VARIABLE _hip_csan_resource_dir
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    COMMAND_ERROR_IS_FATAL ANY)
+  set(_hip_csan_device_runtime
+    "${_hip_csan_resource_dir}/lib/amdgcn-amd-amdhsa/libclang_rt.csan.a")
+  if(NOT EXISTS "${_hip_csan_device_runtime}")
+    message(FATAL_ERROR "CSAN device runtime not found: ${_hip_csan_device_runtime}")
+  endif()
+  list(APPEND HIP_DEVICE_ONLY_BUILD_FLAGS_NO_ARCH
+    "-Xoffload-linker=amdgcn-amd-amdhsa" "${_hip_csan_device_runtime}")
+  # The runtime is bitcode. Match its LTO code generation to each fixture's
+  # explicit native code object version instead of the linker's default.
+  foreach(_version 5 6)
+    list(APPEND HIP_DEVICE_CODE_OBJECT_V${_version}_FLAGS
+      "-Xoffload-linker=amdgcn-amd-amdhsa"
+      "-mllvm=-amdhsa-code-object-version=${_version}")
+  endforeach()
+endif()
+
 # get hip-tests commit short hash
 execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD
   WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
