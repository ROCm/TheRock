From 77fe695600ea06aebae5055b8e967db171a9582d Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Mon, 23 Nov 2026 20:24:43 +0000
Subject: [PATCH] fix(hip-tests): probe g++ for __bf16/_Float16 before building
 fp_headers test

The g++ header-hygiene test compiles the HIP fp8/ocp headers with the host
g++. Those headers (amd_hip_ocp_types.h via hip_fp8.h) use __bf16 and
_Float16, and the test was gated only on g++ >= 13, assuming any such g++
supports those types. That holds on x86_64/aarch64 but not on ppc64le, where
g++ 13+ still reports "_Float16 is not supported on this target", which breaks
the hip-tests build.

Replace the version-only gate with an actual capability probe: try to compile
a tiny TU using __bf16/_Float16 with GXX_EXEC and only build the fp_headers
test (and its source) when that succeeds. On unsupported targets such as
ppc64le the test is skipped; behavior on x86_64/aarch64 is unchanged.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 .../hip-tests/catch/unit/g++/CMakeLists.txt    | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/projects/hip-tests/catch/unit/g++/CMakeLists.txt b/projects/hip-tests/catch/unit/g++/CMakeLists.txt
index 78975903ced..e74868b8b25 100644
--- a/projects/hip-tests/catch/unit/g++/CMakeLists.txt
+++ b/projects/hip-tests/catch/unit/g++/CMakeLists.txt
@@ -30,10 +30,26 @@ if(HIP_PLATFORM MATCHES "amd" AND UNIX AND GXX_EXEC)
     set(GPP_LIBS malloc_gpp half_types)
     set(GPP_DEPS malloc_custom half_custom)
 
-    # Low precision headers need __bf16/_Float16, which g++ supports from 13.
+    # Low precision headers need __bf16/_Float16. g++ provides these from v13
+    # on architectures that implement them (e.g. x86_64, aarch64), but NOT on
+    # others such as ppc64le, where g++ 13+ still rejects them with
+    # "_Float16 is not supported on this target". Probe the host compiler for
+    # the types instead of assuming the version implies support.
     execute_process(COMMAND ${GXX_EXEC} -dumpversion
                     OUTPUT_VARIABLE GXX_VERSION OUTPUT_STRIP_TRAILING_WHITESPACE)
+    set(GXX_HAS_LOW_PRECISION_FP OFF)
     if(GXX_VERSION VERSION_GREATER_EQUAL 13)
+        file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/gpp_fp_probe.cpp
+             "int main() { __bf16 b{}; _Float16 h{}; return (int)(sizeof(b) + sizeof(h)); }\n")
+        execute_process(
+            COMMAND ${GXX_EXEC} -std=c++17 -fsyntax-only
+                    ${CMAKE_CURRENT_BINARY_DIR}/gpp_fp_probe.cpp
+            RESULT_VARIABLE GXX_FP_PROBE_RESULT OUTPUT_QUIET ERROR_QUIET)
+        if(GXX_FP_PROBE_RESULT EQUAL 0)
+            set(GXX_HAS_LOW_PRECISION_FP ON)
+        endif()
+    endif()
+    if(GXX_HAS_LOW_PRECISION_FP)
         list(APPEND TEST_SRC fp_headers.cc)
         add_custom_command(OUTPUT ${CMAKE_CURRENT_BINARY_DIR}/fp_headers.o
             COMMAND ${GXX_EXEC} -c -std=c++17 -Wall -Wextra -Werror
