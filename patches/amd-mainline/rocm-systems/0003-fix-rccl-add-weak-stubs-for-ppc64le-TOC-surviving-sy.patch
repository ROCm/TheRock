From 6d8fd94939a3b64b6771c906b449fe31ae7c4b0c Mon Sep 17 00:00:00 2001
From: therockbot <therockbot@amd.com>
Date: Mon, 2 Nov 2026 15:57:14 +0000
Subject: [PATCH] fix(rccl): add weak stubs for ppc64le TOC-surviving symbols
 in host tests

On ppc64le, TOC references to extern symbols survive --gc-sections even
when the code path referencing them is dead. Add weak stub definitions
for topoPathTypeStr, network device-count functions, and GIN plugin
functions so host-only test binaries link without GPU/network libraries.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 projects/rccl/test/host/fakes/nccl_fakes.cc   | 10 +++++++
 .../rccl/test/host/fakes/transport_stubs.cc   | 26 +++++++++++++++++++
 2 files changed, 36 insertions(+)

diff --git a/projects/rccl/test/host/fakes/nccl_fakes.cc b/projects/rccl/test/host/fakes/nccl_fakes.cc
index 9a876ffd1b3..ecefaca0f93 100644
--- a/projects/rccl/test/host/fakes/nccl_fakes.cc
+++ b/projects/rccl/test/host/fakes/nccl_fakes.cc
@@ -646,3 +646,13 @@ void ResetNcclFakes()
     g_commGraphDeregister          = DefaultCommGraphDeregister;
     g_ncclSetThreadName            = DefaultSetThreadName;
 }
+
+// ppc64le TOC references survive --gc-sections, so rome_models.cc's
+// extern topoPathTypeStr[] needs a definition even when the code path is dead.
+// Weak so that tests linking topo_stubs.cc (which has a strong definition) win.
+#if defined(__powerpc64__) || defined(__PPC64__)
+#ifndef RCCL_NCCL_FAKES_OMIT_GRAPH
+#include "graph.h"
+__attribute__((weak)) const char* topoPathTypeStr[] = {"LOC", "XGMI", "NVB", "C2C", "PIX", "PXB", "P2C", "PXN", "PHB", "SYS", "NET", "DIS"};
+#endif
+#endif
diff --git a/projects/rccl/test/host/fakes/transport_stubs.cc b/projects/rccl/test/host/fakes/transport_stubs.cc
index 09835366996..25ea86b8d11 100644
--- a/projects/rccl/test/host/fakes/transport_stubs.cc
+++ b/projects/rccl/test/host/fakes/transport_stubs.cc
@@ -372,3 +372,29 @@ ncclResult_t ncclTransportP2pSetup(struct ncclComm* comm, struct ncclTopoGraph*
 #include "transport.h"
 struct ncclTransport netTransport = {};
 
+// ppc64le TOC references survive --gc-sections, so plugin device-count
+// functions referenced as function pointers in topo.cc need definitions
+// even though the code path that stores them is dead.  Use weak symbols
+// so tests that supply their own strong definitions (e.g. gin-plugin-init-test)
+// win without a duplicate-symbol error.
+#if defined(__powerpc64__) || defined(__PPC64__)
+#include "gin.h"
+#include "net.h"
+extern "C" {
+__attribute__((weak)) int ncclNetIb_devices(int* ndev) { *ndev = 0; return 0; }
+__attribute__((weak)) int ncclNetGdrCopy_devices(int* ndev) { *ndev = 0; return 0; }
+__attribute__((weak)) int ncclNetSocket_devices(int* ndev) { *ndev = 0; return 0; }
+__attribute__((weak)) int ncclGinDeviceCount(void) { return 0; }
+__attribute__((weak)) int ncclGinCustomAllReduceDeviceCount(void) { return 0; }
+}
+// topo.cc stores ncclNetGetDevCount / ncclGinGetDevCount / etc. as function
+// pointers in netInfo; the TOC entry survives --gc-sections on POWER even
+// when the code path is dead.  Weak stubs let MicroGraph (which links the
+// real topo.cc but not graph_fakes.cc) resolve them.
+__attribute__((weak)) ncclResult_t ncclNetGetDevCount(int, int* p, int* v) { if (p) *p = 0; if (v) *v = 0; return ncclSuccess; }
+__attribute__((weak)) ncclResult_t ncclCollNetGetDevCount(int, int* p, int* v) { if (p) *p = 0; if (v) *v = 0; return ncclSuccess; }
+__attribute__((weak)) ncclResult_t ncclGinGetDevCount(int, int* p, int* v) { if (p) *p = 0; if (v) *v = 0; return ncclSuccess; }
+__attribute__((weak)) ncclResult_t ncclRmaGetDevCount(int, int* p, int* v) { if (p) *p = 0; if (v) *v = 0; return ncclSuccess; }
+__attribute__((weak)) ncclResult_t ncclNetSetVirtDevCount(int, int) { return ncclSuccess; }
+__attribute__((weak)) ncclResult_t ncclCollNetSetVirtDevCount(int, int) { return ncclSuccess; }
+#endif
-- 
