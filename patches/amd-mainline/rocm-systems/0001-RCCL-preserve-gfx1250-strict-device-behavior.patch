From bee9789283be8745cbb9e7f5070b926c607a853b Mon Sep 17 00:00:00 2001
From: Ammar ELWazir <3832908+ammarwa@users.noreply.github.com>
Date: Fri, 11 Sep 2026 18:08:03 -0500
Subject: [PATCH] RCCL: preserve gfx1250 device behavior for strict target

---
 projects/rccl/cmake/DeviceLinker.cmake        |  5 ++--
 .../all_gather/all_gather_dda_fabric_ll128.h  |  2 +-
 projects/rccl/src/device/all_gather.h         |  2 +-
 projects/rccl/src/device/all_reduce.h         |  6 ++---
 projects/rccl/src/device/broadcast.h          |  2 +-
 projects/rccl/src/device/generate.py          | 10 ++++----
 projects/rccl/src/device/prims_ll.h           |  2 +-
 projects/rccl/src/device/prims_ll128.h        |  4 ++--
 projects/rccl/src/device/prims_simple.h       |  8 +++----
 projects/rccl/src/device/reduce.h             |  2 +-
 projects/rccl/src/device/reduce_scatter.h     |  2 +-
 projects/rccl/src/device/sendrecv.h           |  8 +++----
 projects/rccl/src/device/tdm/asyncCopy.h      |  4 ++--
 projects/rccl/src/device/tdm/tdmCopy.h        |  2 +-
 projects/rccl/src/include/device.h            |  4 ++--
 .../rccl/src/include/nccl_device/hip_compat.h |  2 +-
 .../rccl/src/include/nccl_device/rccl_ptr.h   |  6 ++---
 projects/rccl/src/include/rccl_float8.h       | 24 +++++++++----------
 18 files changed, 48 insertions(+), 47 deletions(-)

diff --git a/projects/rccl/cmake/DeviceLinker.cmake b/projects/rccl/cmake/DeviceLinker.cmake
index a0473529f9..3a2d8b8968 100644
--- a/projects/rccl/cmake/DeviceLinker.cmake
+++ b/projects/rccl/cmake/DeviceLinker.cmake
@@ -192,14 +192,15 @@ function(dl_evaluate_guard GUARD GPU_TARGET RESULT_VAR)
     set(${RESULT_VAR} FALSE PARENT_SCOPE)
     return()
   endif()
-  string(REGEX MATCHALL "__gfx[0-9a-z]+__" _guard_archs "${GUARD}")
+  string(REGEX MATCHALL "__gfx[0-9a-z_]+__" _guard_archs "${GUARD}")
+  string(REPLACE "-" "_" _gpu_macro "${GPU_TARGET}")
   if(NOT _guard_archs)
     set(${RESULT_VAR} TRUE PARENT_SCOPE)
     return()
   endif()
   foreach(_ga ${_guard_archs})
     string(REGEX REPLACE "^__(.+)__$" "\\1" _arch "${_ga}")
-    if("${_arch}" STREQUAL "${GPU_TARGET}")
+    if("${_arch}" STREQUAL "${_gpu_macro}")
       set(${RESULT_VAR} TRUE PARENT_SCOPE)
       return()
     endif()
diff --git a/projects/rccl/src/algorithms/dda/all_gather/all_gather_dda_fabric_ll128.h b/projects/rccl/src/algorithms/dda/all_gather/all_gather_dda_fabric_ll128.h
index a933cefd77..bd77ac7461 100644
--- a/projects/rccl/src/algorithms/dda/all_gather/all_gather_dda_fabric_ll128.h
+++ b/projects/rccl/src/algorithms/dda/all_gather/all_gather_dda_fabric_ll128.h
@@ -105,7 +105,7 @@ __launch_bounds__(1024)
     ddaLL128PollWire(gatherSlot + s * (size_t)kDdaLL128WireWordsPerSlice + 2 * lane, vr, flag, lane);
     ddaLL128StoreRegs<int8_t>(dstBytes + dataByte, vr, eltInSlice, lane, flagLane);
   }
-#if defined(__gfx1250__)
+#if (defined(__gfx1250__) || defined(__gfx1250_strict__))
   asm volatile("s_wait_storecnt 0x0" ::: "memory");
 #endif
   __syncthreads();
