diff --git a/projects/hip-tests/catch/include/hip_test_kernels.hh b/projects/hip-tests/catch/include/hip_test_kernels.hh
index 837803a..4c6dfd7 100644
--- a/projects/hip-tests/catch/include/hip_test_kernels.hh
+++ b/projects/hip-tests/catch/include/hip_test_kernels.hh
@@ -40,7 +40,7 @@ template <typename T> __global__ void addCount(const T* A_d, T* C_d, size_t NELE
 
   // Deliberately do this in an inefficient way to increase kernel runtime
   if (i < NELEM) {
-    for (int i = 0; i < count; i++) {
+    for (int iteration = 0; iteration < count; iteration++) {
       C_d[i] = A_d[i];
       atomicAdd(C_d + i, count);
     }
@@ -54,8 +54,10 @@ __global__ void addCountReverse(const T* A_d, T* C_d, int64_t NELEM, int count)
 
   // Deliberately do this in an inefficient way to increase kernel runtime
   if (i < NELEM) {
-    for (int i = 0; i < count; i++) {
-      C_d[i] = A_d[i] + (T)count;
+    // Keep every delay-loop store observable without sharing another thread's element.
+    volatile T* output = C_d + i;
+    for (int iteration = 0; iteration < count; iteration++) {
+      *output = A_d[i] + (T)count;
     }
   }
 }
