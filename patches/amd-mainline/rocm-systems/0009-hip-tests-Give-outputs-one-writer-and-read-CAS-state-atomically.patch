diff --git a/projects/hip-tests/catch/unit/deviceLib/anyAll.cc b/projects/hip-tests/catch/unit/deviceLib/anyAll.cc
index 85cca33..4011c60 100644
--- a/projects/hip-tests/catch/unit/deviceLib/anyAll.cc
+++ b/projects/hip-tests/catch/unit/deviceLib/anyAll.cc
@@ -10,13 +10,17 @@
 __global__ void warpvote(int* device_any, int* device_all, int pshift) {
   int tid = threadIdx.x + blockIdx.x * blockDim.x;
 #if HT_AMD
-  device_any[threadIdx.x >> pshift] = __any(tid - 77);
-  device_all[threadIdx.x >> pshift] = __all(tid - 77);
+  const int any_result = __any(tid - 77);
+  const int all_result = __all(tid - 77);
 #else
   unsigned mask = 0xFFFFFFFF;
-  device_any[threadIdx.x >> pshift] = __any_sync(mask, tid - 77);
-  device_all[threadIdx.x >> pshift] = __all_sync(mask, tid - 77);
+  const int any_result = __any_sync(mask, tid - 77);
+  const int all_result = __all_sync(mask, tid - 77);
 #endif
+  if ((threadIdx.x & ((1u << pshift) - 1)) == 0) {
+    device_any[threadIdx.x >> pshift] = any_result;
+    device_all[threadIdx.x >> pshift] = all_result;
+  }
 }
 
 
