From 17232a28759e0e88e775dc97f7808d8cab2043eb Mon Sep 17 00:00:00 2001
From: idubinov <igor.dubinov@amd.com>
Date: Tue, 10 Nov 2026 15:27:14 +0000
Subject: [PATCH] Guard feature-gated AMDGCN builtins with is_invocable for
 amdgcnspirv

On amdgcnspirv __has_builtin() is true for every AMDGCN builtin (the
target GPU is only known at JIT time), so clang rejects calls to
feature-gated builtins (MFMA/SMFMAC/WMMA/async-LDS/global atomic fadd)
that are guarded by __has_builtin() alone. Add a
__builtin_amdgcn_is_invocable() guard (falls back to true when the
predicate builtin is unavailable).

- rocprofiler-compute: sample/rocflop.cpp, sample/mega_kernel,
  sample/wmma_gemm_fp16
- hip-tests: catch/unit/memory/hipHostRegister.cc
---
 .../catch/unit/memory/hipHostRegister.cc      |  16 +-
 .../sample/mega_kernel/mega_kernel.hip        | 192 ++++++++++--------
 .../rocprofiler-compute/sample/rocflop.cpp    | 166 ++++++++-------
 .../sample/wmma_gemm_fp16/wmma_gemm_fp16.hip  | 111 +++++-----
 4 files changed, 265 insertions(+), 220 deletions(-)

diff --git a/projects/hip-tests/catch/unit/memory/hipHostRegister.cc b/projects/hip-tests/catch/unit/memory/hipHostRegister.cc
index 851ae7748d..6f376210cc 100644
--- a/projects/hip-tests/catch/unit/memory/hipHostRegister.cc
+++ b/projects/hip-tests/catch/unit/memory/hipHostRegister.cc
@@ -38,16 +38,26 @@ template <typename T> __global__ void Inc(T* Ad) {
 }
 
 #if HT_AMD
+// On amdgcnspirv __has_builtin() is true for every AMDGCN builtin (the GPU is
+// only known at JIT time), so clang requires an is_invocable guard as well.
+#if __has_builtin(__builtin_amdgcn_is_invocable)
+#define HOST_REGISTER_IS_INVOCABLE(builtin) __builtin_amdgcn_is_invocable(builtin)
+#else
+#define HOST_REGISTER_IS_INVOCABLE(builtin) true
+#endif
+
 __global__ void AtomicFAddKernelKernel(float* data, size_t n) {
   size_t i = blockDim.x * blockIdx.x + threadIdx.x;
   if (i < n) {
 #if __has_builtin(__builtin_amdgcn_global_atomic_fadd_f32)
-    __builtin_amdgcn_global_atomic_fadd_f32(data, 1.0f);
-#else
+    if (HOST_REGISTER_IS_INVOCABLE(__builtin_amdgcn_global_atomic_fadd_f32)) {
+      __builtin_amdgcn_global_atomic_fadd_f32(data, 1.0f);
+      return;
+    }
+#endif
     if (i == 0) {
       *data = -1.0;
     }
-#endif
   }
 }
 #endif
diff --git a/projects/rocprofiler-compute/sample/mega_kernel/mega_kernel.hip b/projects/rocprofiler-compute/sample/mega_kernel/mega_kernel.hip
index 72641530d8..600c02272d 100644
--- a/projects/rocprofiler-compute/sample/mega_kernel/mega_kernel.hip
+++ b/projects/rocprofiler-compute/sample/mega_kernel/mega_kernel.hip
@@ -122,6 +122,15 @@
 
 #include "mega_kernel_types.h"
 
+// On amdgcnspirv __has_builtin() is true for every AMDGCN builtin (the GPU is
+// only known at JIT time), so clang requires an is_invocable guard as well.
+// Use nested ifs: clang only honors the first is_invocable in an && chain.
+#if __has_builtin(__builtin_amdgcn_is_invocable)
+#define MEGA_KERNEL_IS_INVOCABLE(builtin) __builtin_amdgcn_is_invocable(builtin)
+#else
+#define MEGA_KERNEL_IS_INVOCABLE(builtin) true
+#endif
+
 // ============================================================================
 // NPI TOOLCHAIN WORKAROUND: gfx1250 fallback detection
 // ============================================================================
@@ -2671,104 +2680,114 @@ __device__ void test_async_lds_operations([[maybe_unused]] float* global_src, fl
                                           TestResults* results, int lane_id, int tid) {
     bool passed = true;
 
-#if __has_builtin(__builtin_amdgcn_global_load_async_to_lds_b32)
-    // MI350 (gfx950) / gfx1250: Full async LDS load/store support
-    // global_load_async_to_lds_b8/b32/b64/b128: Load from global to LDS asynchronously
-    // global_store_async_from_lds_b8/b32/b64/b128: Store from LDS to global asynchronously
-
-    // Initialize global source with test pattern
-    if (tid < 64) {
-        // First, copy test data to global memory
-        global_src[tid] = (float)(tid * 10 + 1);
-    }
-
-    // Initialize async barrier counter per block for gfx1250
-    if (threadIdx.x == 0) {
-        async_barrier_counter = 0;
-    }
-    __syncthreads();
-
-    // Perform async load from global to LDS
-    // Only first thread in each block issues the async load for this test
-    if (threadIdx.x == 0) {
-        // Cast pointers to appropriate address spaces
-        // address_space(1) = global, address_space(3) = local/LDS
-        typedef int __attribute__((ext_vector_type(4))) vint4;
+#if __has_builtin(__builtin_amdgcn_global_load_async_to_lds_b128) && \
+    __has_builtin(__builtin_amdgcn_global_store_async_from_lds_b128)
+    if (MEGA_KERNEL_IS_INVOCABLE(__builtin_amdgcn_global_load_async_to_lds_b128)) {
+        if (MEGA_KERNEL_IS_INVOCABLE(__builtin_amdgcn_global_store_async_from_lds_b128)) {
+            // MI350 (gfx950) / gfx1250: Full async LDS load/store support
+            // global_load_async_to_lds_b8/b32/b64/b128: Load from global to LDS asynchronously
+            // global_store_async_from_lds_b8/b32/b64/b128: Store from LDS to global asynchronously
+
+            // Initialize global source with test pattern
+            if (tid < 64) {
+                // First, copy test data to global memory
+                global_src[tid] = (float)(tid * 10 + 1);
+            }
 
-        // Load 16 bytes (4 ints) asynchronously from global to LDS
-        __builtin_amdgcn_global_load_async_to_lds_b128(
-            ((__attribute__((address_space(1))) vint4*)global_src),
-            ((__attribute__((address_space(3))) vint4*)async_lds_buffer),
-            0 /* offset */, 0 /* cache policy */);
-    }
+            // Initialize async barrier counter per block for gfx1250
+            if (threadIdx.x == 0) {
+                async_barrier_counter = 0;
+            }
+            __syncthreads();
+
+            // Perform async load from global to LDS
+            // Only first thread in each block issues the async load for this test
+            if (threadIdx.x == 0) {
+                // Cast pointers to appropriate address spaces
+                // address_space(1) = global, address_space(3) = local/LDS
+                typedef int __attribute__((ext_vector_type(4))) vint4;
+
+                // Load 16 bytes (4 ints) asynchronously from global to LDS
+                __builtin_amdgcn_global_load_async_to_lds_b128(
+                    ((__attribute__((address_space(1))) vint4*)global_src),
+                    ((__attribute__((address_space(3))) vint4*)async_lds_buffer),
+                    0 /* offset */, 0 /* cache policy */);
+            }
 
 #if defined(__gfx1250__)
-    // GFX1250: Use DS atomic async barrier for synchronization
-    // This signals that this thread has reached the barrier point
-    // The barrier counter is atomically incremented
-    if (__has_builtin(__builtin_amdgcn_ds_atomic_async_barrier_arrive_b64)) {
-        __builtin_amdgcn_ds_atomic_async_barrier_arrive_b64(
-            ((__attribute__((address_space(3))) long*)&async_barrier_counter));
-    }
+            // GFX1250: Use DS atomic async barrier for synchronization
+            // This signals that this thread has reached the barrier point
+            // The barrier counter is atomically incremented
+            if (__has_builtin(__builtin_amdgcn_ds_atomic_async_barrier_arrive_b64)) {
+                __builtin_amdgcn_ds_atomic_async_barrier_arrive_b64(
+                    ((__attribute__((address_space(3))) long*)&async_barrier_counter));
+            }
 
-    // Wait for async operations to complete
-    // On gfx1250, use s_wait_asynccnt for async LDS operations
-    __builtin_amdgcn_s_wait_asynccnt(0);  // Wait for async copy operations
+            // Wait for async operations to complete
+            // On gfx1250, use s_wait_asynccnt for async LDS operations
+            __builtin_amdgcn_s_wait_asynccnt(0);  // Wait for async copy operations
 #else
-    // Other architectures: Use unified s_waitcnt
-    WAITCNT_ALL();  // Wait for all memory operations
+            // Other architectures: Use unified s_waitcnt
+            WAITCNT_ALL();  // Wait for all memory operations
 #endif
-    __syncthreads();
-
-    // Verify the data was loaded correctly to LDS
