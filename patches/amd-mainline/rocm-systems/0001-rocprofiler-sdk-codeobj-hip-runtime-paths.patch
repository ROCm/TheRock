From 6227a820d8de9a6468654723b57f41c6728b9095 Mon Sep 17 00:00:00 2001
From: Ethan Wee <ethan.wee@amd.com>
Date: Mon, 26 Oct 2026 12:29:13 +0000
Subject: [PATCH] fix(rocprofiler-sdk): pass HIP runtime paths to codeobj test

---
 .../source/lib/tests/codeobj/CMakeLists.txt           | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/projects/rocprofiler-sdk/source/lib/tests/codeobj/CMakeLists.txt b/projects/rocprofiler-sdk/source/lib/tests/codeobj/CMakeLists.txt
index 71428c386c..b5760abe57 100644
--- a/projects/rocprofiler-sdk/source/lib/tests/codeobj/CMakeLists.txt
+++ b/projects/rocprofiler-sdk/source/lib/tests/codeobj/CMakeLists.txt
@@ -36,6 +36,15 @@ find_program(
     PATHS ${ROCM_PATH} ENV ROCM_PATH /opt/rocm
     PATH_SUFFIXES bin llvm/bin NO_CACHE)
 
+# The aggregate dist root does not contain the HIP runtime used by amdclang++.
+# Derive the runtime root from the HIP package selected by the super-project.
+set(CODEOBJ_ROCM_PATH "${ROCM_PATH}")
+if(DEFINED hip_DIR)
+    get_filename_component(CODEOBJ_ROCM_PATH "${hip_DIR}/../../.." ABSOLUTE)
+endif()
+set(CODEOBJ_ROCM_DEVICE_LIB_PATH
+    "${CODEOBJ_ROCM_PATH}/lib/llvm/amdgcn/bitcode")
+
 # The arch only matters for compilation, not execution -- the test only parses DWARF debug
 # info from the resulting ELF.  Any valid arch works here.
 set(_SYNCKERNEL_ARCH "gfx90a")
@@ -47,6 +56,8 @@ add_custom_command(
     OUTPUT "${_SYNCKERNEL_BIN}"
     COMMAND
         ${CODEOBJ_AMDCLANGPP} -x hip -ggdb --offload-arch=${_SYNCKERNEL_ARCH}
+        --rocm-path=${CODEOBJ_ROCM_PATH}
+        --rocm-device-lib-path=${CODEOBJ_ROCM_DEVICE_LIB_PATH}
         --offload-device-only -c -fno-gpu-rdc -o "${_SYNCKERNEL_BUNDLE}"
         "${_SYNCKERNEL_SRC}"
     COMMAND
-- 
2.25.1

