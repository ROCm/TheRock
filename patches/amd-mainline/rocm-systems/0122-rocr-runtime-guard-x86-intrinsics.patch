From 0dd211a40de1d9647fb6cf506917e9bf759f663b Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Fri, 3 Jul 2026 19:12:18 +0000
Subject: [PATCH] Guard x86 intrinsics for non-x86 architectures

Guard _mm_sfence, _mm_mfence, _mm_pause, and _mm_clflush calls
behind architecture checks for x86 and ppc64le. On ppc64le, GCC
compatibility headers translate these to PowerPC equivalents.
---
 .../runtime/hsa-runtime/core/inc/amd_gpu_agent.h            | 4 ++++
 .../runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp      | 4 ++++
 .../runtime/hsa-runtime/core/runtime/amd_blit_kernel.cpp    | 2 ++
 .../runtime/hsa-runtime/core/runtime/amd_blit_sdma.cpp      | 4 ++++
 .../runtime/hsa-runtime/core/runtime/intercept_queue.cpp    | 6 ++++++
 projects/rocr-runtime/runtime/hsa-runtime/core/util/locks.h | 2 ++
 projects/rocr-runtime/runtime/hsa-runtime/core/util/utils.h | 2 ++
 7 files changed, 24 insertions(+)

diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_gpu_agent.h b/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_gpu_agent.h
index a141d354c97..21b35909c9a 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_gpu_agent.h
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/inc/amd_gpu_agent.h
@@ -474,9 +474,13 @@ class GpuAgent : public GpuAgentInt {
   /// @brief Force a WC flush on PCIe devices by doing a write and then read-back
   __forceinline void PcieWcFlush(void *ptr, size_t size) const {
     if (!xgmi_cpu_gpu_) {
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
       _mm_sfence();
+#endif
       *((uint8_t*)ptr + size - 1) = *((uint8_t*)ptr + size - 1);
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
       _mm_mfence();
+#endif
       auto readback = *(reinterpret_cast<volatile uint8_t*>(ptr) + size - 1);
       UNUSED(readback);
     }
diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp
index 801327ed975..88bb1696561 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_aql_queue.cpp
@@ -485,7 +485,9 @@ void AqlQueue::StoreRelaxed(hsa_signal_value_t value) {
     HSAKMT_CALL(hsaKmtQueueRingDoorbell(queue_id_, value));
   } else {
     // Hardware doorbell supports AQL semantics.
+    #if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
     _mm_sfence();
+    #endif
     *(signal_.hardware_doorbell_ptr) = uint64_t(value);
     /* signal_ is allocated as uncached so we do not need read-back to flush WC */
   }
@@ -1717,7 +1719,9 @@ void AqlQueue::ExecutePM4(uint32_t* cmd_data, size_t cmd_size_b, hsa_fence_scope
   memcpy(&queue_slot[1], &slot_data[1], slot_size_b - sizeof(uint32_t));
   if (IsDeviceMemRingBuf() && needsPcieOrdering()) {
     // Ensure the packet body is written as header may get reordered when writing over PCIE
+    #if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
     _mm_sfence();
+    #endif
   }
   atomic::Store(&queue_slot[0], slot_data[0], std::memory_order_release);
 
diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_kernel.cpp b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_kernel.cpp
index 94958c0cafd..80b5fdaf37e 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_kernel.cpp
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_kernel.cpp
@@ -919,7 +919,9 @@ void BlitKernel::PopulateQueue(uint64_t index, uint64_t code_handle, void* args,
   std::atomic_thread_fence(std::memory_order_release);
   if (queue_->IsDeviceMemRingBuf() && queue_->needsPcieOrdering()) {
     // Ensure the packet body is written as header may get reordered when writing over PCIE
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
     _mm_sfence();
+#endif
   }
 #if defined(__linux__)
   __atomic_store_n(&(queue_buffer[index & queue_bitmask_].full_header),
diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_sdma.cpp b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_sdma.cpp
index e82cc512209..82cf3d7b74b 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_sdma.cpp
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/amd_blit_sdma.cpp
@@ -1988,7 +1988,9 @@ char* BlitSdma<useGCR, scopeFields>::AcquireWriteAddress(uint32_t cmd_size, uint
 
     // CAS failed -- reuse the observed value directly, skip redundant atomic Load.
     curr_index = observed;
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
     _mm_pause();
+#endif
   }
 
   return nullptr;
@@ -2063,7 +2065,9 @@ void BlitSdma<useGCR, scopeFields>::PadRingToEnd(uint64_t curr_index) {
   // Check whether the engine has finished using this region.
   if (CanWriteUpto(new_index) == false) {
     // Engine hasn't freed this region yet.  Pause briefly.
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
     _mm_pause();
+#endif
     return;
   }
 
diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/intercept_queue.cpp b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/intercept_queue.cpp
index 51dc02642a5..3de15c448f1 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/intercept_queue.cpp
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/runtime/intercept_queue.cpp
@@ -270,7 +270,9 @@ uint64_t InterceptQueue::Submit(const AqlPacket* packets, uint64_t count) {
       ring[barrier & mask].barrier_and.completion_signal = Signal::Convert(retry_doorbell_);
       if (wrapped->IsDeviceMemRingBuf() && needsPcieOrdering()) {
         // Ensure the packet body is written as header may get reordered when writing over PCIE
+        #if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
         _mm_sfence();
+        #endif
       }
       // Release-publish the header, then ring the doorbell.
       atomic::Store(&ring[barrier & mask].barrier_and.header, kBarrierHeader,
@@ -314,7 +316,9 @@ uint64_t InterceptQueue::Submit(const AqlPacket* packets, uint64_t count) {
       if (write_index != 0) {
         if (wrapped->IsDeviceMemRingBuf() && needsPcieOrdering()) {
           // Ensure the packet body is written as header may get reordered when writing over PCIE
+          #if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
           _mm_sfence();
+          #endif
         }
         atomic::Store(&ring[write & mask].packet.header, packets[first_written_packet_index].packet.header,
                       std::memory_order_release);
@@ -415,7 +419,9 @@ void InterceptQueue::StoreRelaxed(hsa_signal_value_t value) {
 
     if (IsDeviceMemRingBuf() && needsPcieOrdering()) {
       // Ensure the packet body is written as header may get reordered when writing over PCIE
+      #if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
       _mm_sfence();
+      #endif
     }
   }
   i = next_packet_;
diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/util/locks.h b/projects/rocr-runtime/runtime/hsa-runtime/core/util/locks.h
index 133dd06f0b7..33ccce4ae38 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/util/locks.h
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/util/locks.h
@@ -72,7 +72,9 @@ class HybridMutex {
     while (!lock_.compare_exchange_strong(old, 1)) {
       cnt--;
       if (cnt > maxSpinIterPause) {
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
         _mm_pause();
+#endif
       } else if (cnt-- > maxSpinIterYield) {
         os::YieldThread();
       } else {
diff --git a/projects/rocr-runtime/runtime/hsa-runtime/core/util/utils.h b/projects/rocr-runtime/runtime/hsa-runtime/core/util/utils.h
index f6b06d3a463..b2ac5e5cabb 100644
--- a/projects/rocr-runtime/runtime/hsa-runtime/core/util/utils.h
+++ b/projects/rocr-runtime/runtime/hsa-runtime/core/util/utils.h
@@ -449,7 +449,9 @@ inline void FlushCpuCache(const void* base, size_t offset, size_t len) {
   cur += offset;
   uintptr_t lastline = (uintptr_t)(cur + len - 1) | (cacheline_size - 1);
   do {
+#if defined(__x86_64__) || defined(__i386__) || defined(__powerpc64__) || defined(__PPC64__)
     _mm_clflush((const void*)cur);
+#endif
     cur += cacheline_size;
   } while (cur <= (const char*)lastline);
 }
