From e68041cef0766671ce76e9be6be405c3cc1e563a Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Tue, 28 Jul 2026 14:11:43 +0000
Subject: [PATCH] dyninst: fix missing cstdint for ppc64le stackwalk build

Dyninst's stackwalk/src/ppc-swk.C uses uint32_t/uint64_t without
including <cstdint>. Since GCC 13, libstdc++ no longer transitively
provides these types through other headers. This only affects ppc64le
builds since ppc-swk.C is only compiled on POWER targets.

Rather than patching the Dyninst submodule (which git-am cannot reach
across submodule boundaries), inject the header via compiler flag on
the stackwalk target.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 projects/rocprofiler-systems/cmake/Packages.cmake | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/projects/rocprofiler-systems/cmake/Packages.cmake b/projects/rocprofiler-systems/cmake/Packages.cmake
index 8fbd35e838..7f66b1dc07 100644
--- a/projects/rocprofiler-systems/cmake/Packages.cmake
+++ b/projects/rocprofiler-systems/cmake/Packages.cmake
@@ -492,6 +492,13 @@ if(ROCPROFSYS_BUILD_DYNINST)
     )
 
     add_subdirectory(external/dyninst EXCLUDE_FROM_ALL)
+
+    # Dyninst ppc-swk.C uses uint32_t/uint64_t without including <cstdint>.
+    # Rather than patching the submodule, inject the header via compiler flag.
+    if(TARGET stackwalk AND CMAKE_SYSTEM_PROCESSOR MATCHES "ppc64")
+        target_compile_options(stackwalk PRIVATE -include cstdint)
+    endif()
+
     rocprofiler_systems_restore_variables(
         PIC VARIABLES CMAKE_POSITION_INDEPENDENT_CODE CMAKE_INSTALL_RPATH
         CMAKE_BUILD_RPATH CMAKE_INSTALL_RPATH_USE_LINK_PATH
