From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sahil Faizal <sahil.faizal@amd.com>
Date: Wed, 11 Nov 2026 03:11:58 -0800
Subject: [PATCH] rccl: Instrument custom device-linker builds with CSAN

The RCCLDEV assembly-extract pipeline bypasses CMAKE_CXX_FLAGS and silently
loses TheRock's concurrency sanitizer flags. The published gfx942 artifacts
from TheRock run 42977786346 contain no CSAN symbols in any of their 114
AMDGPU KPACK payloads. The main device ELF retains 24159 symbols and HSA
ABI4; this is missing device instrumentation rather than host stripping.
The build log confirms RCCLDEV is enabled without sanitizer flags.

For THEROCK_SANITIZER=CSAN, use the configured compiler and propagate CSAN
flags to the custom HIP compilation paths. Resolve its packaged device
runtime and pass it through a separate --csan-rt driver option only for the
raw device link. Supply the bare processor to lld's LTO plugin so it can
compile that archive. Mixed HIP links continue to use Clang's automatic
runtime selection, avoiding duplicate runtime definitions. Other sanitizer
modes and existing profile-runtime linking retain their behavior.

Add driver regression cases for option parsing, command construction,
combined profile/CSAN runtimes, missing archives, and dispatcher compilation.
Host validation: all 27 driver tests pass. A real gfx942 one-kernel compile
and --csan-rt device link produces CSAN instrumentation references in the
native object, defined runtime symbols in the final ELF, no unresolved
CSAN symbols, and unchanged AMDGPU HSA ABI4. This bounded test validates
the linking mechanism; it does not replace component CI validation.

Source: ROCm/rocm-systems bd1130f9f838cfffd24f41fd3052968fb7cae4e0
Reproduction: https://github.com/ROCm/TheRock/actions/runs/42977786346
Carry temporarily in TheRock pending upstream RCCL review.
---
 projects/rccl/cmake/DeviceLinker.cmake             | 35 +++++++++--
 projects/rccl/tools/rccl-device-compile            | 37 +++++++----
 .../test_runner/tests/test_device_compile.py       | 73 ++++++++++++++++++++++
 3 files changed, 130 insertions(+), 15 deletions(-)

diff --git a/projects/rccl/cmake/DeviceLinker.cmake b/projects/rccl/cmake/DeviceLinker.cmake
index afe0eb9..c4aac2e 100644
--- a/projects/rccl/cmake/DeviceLinker.cmake
+++ b/projects/rccl/cmake/DeviceLinker.cmake
@@ -19,12 +19,12 @@ message(STATUS "Device Linker: assembly-extract pipeline enabled (RCCLDEV langua
 list(APPEND CMAKE_MODULE_PATH "${PROJECT_SOURCE_DIR}/cmake")
 enable_language(RCCLDEV)
 
-# Device coverage requires the same ROCm 7.15+ compiler selected for the
-# main build, including its packaged device profile runtime.
+# Device instrumentation requires the compiler selected for the main build,
+# including its packaged device profile or CSAN runtime.
 get_filename_component(_dl_compiler_dir "${CMAKE_CXX_COMPILER}" DIRECTORY)
-if(ENABLE_FULL_COVERAGE)
+if(ENABLE_FULL_COVERAGE OR THEROCK_SANITIZER STREQUAL "CSAN")
   set(DL_CLANG "${CMAKE_CXX_COMPILER}")
-  message(STATUS "Device Linker: DL_CLANG pinned to CMAKE_CXX_COMPILER for device coverage = ${DL_CLANG}")
+  message(STATUS "Device Linker: DL_CLANG pinned to CMAKE_CXX_COMPILER for device instrumentation = ${DL_CLANG}")
 else()
   find_program(DL_CLANG NAMES amdclang++ clang++
     HINTS "${_dl_compiler_dir}" "${ROCM_PATH}/bin" REQUIRED)
@@ -102,6 +102,27 @@ if(_rccl_copts)
     list(APPEND DL_INHERITED_FLAGS "${_opt}")
   endforeach()
 endif()
+# The custom language does not inherit CMAKE_CXX_FLAGS, where TheRock injects
+# sanitizer flags. Instrument each HIP compile, including standalone fat objects.
+# Only the raw device link needs an explicit runtime; mixed HIP links use Clang's
+# normal runtime selection and must not receive a second archive.
+set(DL_CSAN_FLAGS "")
+set(DL_DEVICE_CSAN_RT "")
+if(THEROCK_SANITIZER STREQUAL "CSAN")
+  set(DL_CSAN_FLAGS -fsanitize=concurrency -fno-omit-frame-pointer)
+  list(APPEND DL_INHERITED_FLAGS ${DL_CSAN_FLAGS})
+  execute_process(COMMAND "${DL_CLANG}" --print-resource-dir
+    OUTPUT_VARIABLE _dl_resource_dir OUTPUT_STRIP_TRAILING_WHITESPACE
+    RESULT_VARIABLE _dl_resource_result ERROR_VARIABLE _dl_resource_error)
+  if(NOT _dl_resource_result EQUAL 0)
+    message(FATAL_ERROR
+      "Device Linker: cannot query the CSAN compiler resource directory: ${_dl_resource_error}")
+  endif()
+  set(DL_DEVICE_CSAN_RT "${_dl_resource_dir}/lib/amdgcn-amd-amdhsa/libclang_rt.csan.a")
+  if(NOT EXISTS "${DL_DEVICE_CSAN_RT}")
+    message(FATAL_ERROR "Device Linker: device CSAN runtime is missing: '${DL_DEVICE_CSAN_RT}'")
+  endif()
+endif()
 message(STATUS "Device Linker: inherited compile options: ${DL_INHERITED_FLAGS}")
 
 # The --link step is the one consumer that cannot take a -fvisibility= option:
@@ -521,6 +542,10 @@ foreach(DL_GPU_TARGET ${DL_GPU_TARGETS})
   endif()
 
   set(_dl_profile_rt_arg "")
+  set(_dl_csan_rt_arg "")
+  if(DL_DEVICE_CSAN_RT)
+    set(_dl_csan_rt_arg "--csan-rt=${DL_DEVICE_CSAN_RT}")
+  endif()
   if(DL_DEVICE_PROFILE_RT)
     set(_dl_profile_rt_arg "--profile-rt=${DL_DEVICE_PROFILE_RT}")
   endif()
@@ -536,6 +561,7 @@ foreach(DL_GPU_TARGET ${DL_GPU_TARGETS})
       --dispatcher=${HIPIFY_DIR}/src/device/common.cu.cpp
       ${_rocshmem_bitcode_arg}
       ${_dl_profile_rt_arg}
+      ${_dl_csan_rt_arg}
       ${_link_def_flags}
       ${_link_inc_flags}
       ${DL_OPT_FLAGS}
@@ -602,6 +628,7 @@ foreach(DL_GPU_TARGET ${DL_GPU_TARGETS})
         ${_link_inc_flags}
         -x hip --offload-device-only --offload-arch=${DL_TARGET_ID}
         ${DL_HIP_COMPILER_FLAGS}
+        ${DL_CSAN_FLAGS}
         -gline-tables-only
         -std=c++17 ${DL_OPT_FLAGS}
         -emit-llvm -S
diff --git a/projects/rccl/tools/rccl-device-compile b/projects/rccl/tools/rccl-device-compile
index 4024ce3..1caacc0 100755
--- a/projects/rccl/tools/rccl-device-compile
+++ b/projects/rccl/tools/rccl-device-compile
@@ -591,10 +591,10 @@ def device_compile_cmd(clang, target_id, forwarded_flags, asm_out, source):
     ]
 
 
-def build_link_cmd(lld, output, rsp_path, arch, profile_rt):
+def build_link_cmd(lld, output, rsp_path, arch, profile_rt, csan_rt=None):
     """Assemble the ld.lld argv for the per-arch device.elf link.
 
-    When a device profile-runtime archive is given (ENABLE_FULL_COVERAGE), it
+    When a device profile or CSAN runtime archive is given, it
     is appended together with --plugin-opt=mcpu=<arch> so lld's LTO codegen of
     the bitcode archive targets amdgcn-amd-amdhsa for this arch instead of the
     host triple (otherwise lld errors out with "incompatible mach").
@@ -603,19 +603,26 @@ def build_link_cmd(lld, output, rsp_path, arch, profile_rt):
     rather than the full target ID. lld's LTO plugin does not parse target
     IDs.
 
-    CMake EXISTS-checks the archive before passing --profile-rt
+    CMake EXISTS-checks the archives before passing --profile-rt / --csan-rt
     (cmake/DeviceLinker.cmake), so a missing archive here means the driver was
     hand-invoked; fail loudly instead of falling through to a link that leaves
-    __llvm_profile_runtime / __start___llvm_prf_* unresolved as an opaque lld
-    dump.
+    __llvm_profile_runtime / __start___llvm_prf_* or __csan_* unresolved as
+    an opaque lld dump.
     """
     link_cmd = [lld, '-shared', '-o', output, f'@{rsp_path}']
-    if profile_rt:
-        if not os.path.exists(profile_rt):
+    runtimes = []
+    for option, archive, name in (
+            ('--profile-rt', profile_rt, 'profile'),
+            ('--csan-rt', csan_rt, 'CSAN')):
+        if not archive:
+            continue
+        if not os.path.exists(archive):
             raise SystemExit(
-                f"ERROR: --profile-rt={profile_rt} not found; cannot resolve "
-                f"the device profile runtime for {arch}")
-        link_cmd.extend([f'--plugin-opt=mcpu={arch}', profile_rt])
+                f"ERROR: {option}={archive} not found; cannot resolve "
+                f"the device {name} runtime for {arch}")
+        runtimes.append(archive)
+    if runtimes:
+        link_cmd.extend([f'--plugin-opt=mcpu={arch}'] + runtimes)
     return link_cmd
 
 
@@ -629,6 +636,7 @@ def do_link(args, forwarded_flags):
     keep_temps = args.keep_temps
     rocshmem_bitcode = getattr(args, 'rocshmem_bitcode', None)
     profile_rt = getattr(args, 'profile_rt', None)
+    csan_rt = getattr(args, 'csan_rt', None)
 
     if not dispatcher:
         raise SystemExit("ERROR: --link requires --dispatcher=<source>")
@@ -718,7 +726,8 @@ def do_link(args, forwarded_flags):
         # from the per-arch libclang_rt.profile.a (see build_link_cmd for the
         # --plugin-opt=mcpu rationale). lld pulls in only the members referenced
         # by the instrumented TUs; host-only members stay unreferenced.
-        link_cmd = build_link_cmd(lld, output, rsp_path, arch, profile_rt)
+        link_cmd = build_link_cmd(lld, output, rsp_path, arch, profile_rt,
+                                  csan_rt)
         run(link_cmd, f"link device.elf for {arch}")
 
     finally:
@@ -771,6 +780,11 @@ def parse_compiler_flags(argv):
         elif arg == '--profile-rt' and i + 1 < len(argv):
             our_args.extend([arg, argv[i + 1]])
             i += 1
+        elif arg.startswith('--csan-rt='):
+            our_args.append(arg)
+        elif arg == '--csan-rt' and i + 1 < len(argv):
+            our_args.extend([arg, argv[i + 1]])
+            i += 1
         elif arg == '-o' and i + 1 < len(argv):
             our_args.extend(['-o', argv[i + 1]])
             i += 1
@@ -829,6 +843,7 @@ def main():
     parser.add_argument('--dispatcher', default=None)
     parser.add_argument('--rocshmem-bitcode', default=None, dest='rocshmem_bitcode')
     parser.add_argument('--profile-rt', default=None, dest='profile_rt')
+    parser.add_argument('--csan-rt', default=None, dest='csan_rt')
     parser.add_argument('-o', '--output', required=False)
     parser.add_argument('--keep-temps', action='store_true')
     parser.add_argument('--version', action='store_true')
diff --git a/projects/rccl/tools/scripts/test_runner/tests/test_device_compile.py b/projects/rccl/tools/scripts/test_runner/tests/test_device_compile.py
index bd4054c..47519ae 100644
--- a/projects/rccl/tools/scripts/test_runner/tests/test_device_compile.py
+++ b/projects/rccl/tools/scripts/test_runner/tests/test_device_compile.py
@@ -110,6 +110,17 @@ class DropLocalNoDeadStripTest(unittest.TestCase):
 
 
 class ParseCompilerFlagsTest(unittest.TestCase):
+    def test_csan_rt_is_not_forwarded_or_treated_as_an_object(self):
+        for option in (["--csan-rt=/opt/rt/libclang_rt.csan.a"],
+                       ["--csan-rt", "/opt/rt/libclang_rt.csan.a"]):
+            with self.subTest(option=option):
+                our, forwarded, sources = driver.parse_compiler_flags(
+                    ["--link"] + option + ["-fsanitize=concurrency", "a.o"])
+
+                self.assertEqual(our, ["--link"] + option)
+                self.assertEqual(forwarded, ["-fsanitize=concurrency"])
+                self.assertEqual(sources, ["a.o"])
+
     def test_profile_rt_joined_form_is_our_arg(self):
         our, forwarded, sources = driver.parse_compiler_flags(
             ["--link", "--profile-rt=/opt/rt/libclang_rt.profile.a", "a.o"]
@@ -130,6 +141,27 @@ class ParseCompilerFlagsTest(unittest.TestCase):
 
 
 class BuildLinkCmdTest(unittest.TestCase):
+    def test_csan_runtime_and_optional_profile_runtime_share_mcpu(self):
+        with tempfile.TemporaryDirectory() as temp_dir:
+            csan = Path(temp_dir) / "libclang_rt.csan.a"
+            profile = Path(temp_dir) / "libclang_rt.profile.a"
+            csan.touch()
+            profile.touch()
+            for profile_rt in (None, str(profile)):
+                with self.subTest(profile_rt=profile_rt):
+                    cmd = driver.build_link_cmd(
+                        "ld.lld", "device.elf", "objs.rsp", "gfx942",
+                        profile_rt, str(csan))
+                    archives = ([profile_rt] if profile_rt else []) + [str(csan)]
+                    self.assertEqual(cmd, ["ld.lld", "-shared", "-o",
+                                          "device.elf", "@objs.rsp",
+                                          "--plugin-opt=mcpu=gfx942"] + archives)
+
+    def test_missing_csan_runtime_reports_the_correct_option(self):
+        with self.assertRaisesRegex(SystemExit, "--csan-rt=.*device CSAN"):
+            driver.build_link_cmd("ld.lld", "device.elf", "objs.rsp",
+                                  "gfx942", None, "/nonexistent/csan.a")
+
     def test_without_profile_rt_omits_mcpu(self):
         cmd = driver.build_link_cmd("ld.lld", "device.elf", "objs.rsp",
                                     "gfx942", None)
@@ -205,6 +237,47 @@ class TargetIdTest(unittest.TestCase):
 
         self.assertEqual(args.target_id, "gfx942")
 
+    def test_main_passes_csan_runtime_to_link(self):
+        args = self._main_with(
+            ["--link", "--arch=gfx942", "--csan-rt=/opt/rt/csan.a",
+             "--dispatcher=common.cu.cpp", "-o", "device.elf", "kernel.o"],
+            mode="link")
+
+        self.assertEqual(args.csan_rt, "/opt/rt/csan.a")
+        self.assertEqual(args.objects, ["kernel.o"])
+
+    def test_link_instruments_dispatcher_and_links_csan_runtime(self):
+        calls = []
+
+        def fake_run(cmd, description=""):
+            calls.append(cmd)
+            if "-S" in cmd:
+                Path(cmd[cmd.index("-o") + 1]).write_text("")
+
+        with tempfile.TemporaryDirectory() as temp_dir:
+            obj = Path(temp_dir) / "kernel.o"
+            obj.touch()
+            (obj.with_suffix(".resources.json")).write_text(
+                '{"vgpr_count": 8, "agpr_count": 0, "sgpr_count": 16}')
+            csan = Path(temp_dir) / "libclang_rt.csan.a"
+            csan.touch()
+            args = argparse.Namespace(
+                clang="clang", arch="gfx942", target_id="gfx942",
+                objects=[str(obj)], output=str(Path(temp_dir) / "device.elf"),
+                dispatcher="common.cu.cpp", keep_temps=False,
+                csan_rt=str(csan))
+
+            with unittest.mock.patch.object(driver, "discover_tools",
+                                            return_value=("clang", "ld.lld")), \
+                    unittest.mock.patch.object(driver, "run", fake_run):
+                driver.do_link(args, ["-fsanitize=concurrency"])
+
+        compile_cmd, assemble_cmd, link_cmd = calls
+        self.assertIn("-fsanitize=concurrency", compile_cmd)
+        self.assertNotIn(str(csan), compile_cmd)
+        self.assertNotIn(str(csan), assemble_cmd)
+        self.assertEqual(link_cmd[-2:], ["--plugin-opt=mcpu=gfx942", str(csan)])
+
     def test_does_not_overwrite_an_explicit_value(self):
         args = self._main_with(["--compile", "--arch=gfx942",
                                 "--target-id=gfx942:xnack+",
