From 1e58d4364f7b040bea23e1c83dfe2c25868262ca Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Fri, 21 Aug 2026 21:03:09 +0000
Subject: [PATCH] rocjitsu: suppress GCC false-positive warnings on ppc64le

GCC 14+ on ppc64le emits false-positive -Wmaybe-uninitialized and
-Wstringop-overflow warnings in std::variant move operations and
std::construct_at, which are promoted to errors by -Werror. Suppress
these on ppc64le, consistent with the existing -Wno-uninitialized
suppression for similar GCC 14+ false positives.
---
 emulation/rocjitsu/CMakeLists.txt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/emulation/rocjitsu/CMakeLists.txt b/emulation/rocjitsu/CMakeLists.txt
index a8ddda566eb..340b71f80e3 100644
--- a/emulation/rocjitsu/CMakeLists.txt
+++ b/emulation/rocjitsu/CMakeLists.txt
@@ -56,6 +56,9 @@ if(
     AND CMAKE_CXX_COMPILER_VERSION VERSION_GREATER_EQUAL "14"
 )
     add_compile_options(-Wno-uninitialized)
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "ppc64")
+        add_compile_options(-Wno-maybe-uninitialized -Wno-stringop-overflow)
+    endif()
 endif()
 
 # HSA/KFD headers (local copies from rocr-runtime).
-- 
