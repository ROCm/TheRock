From ae49166c4f492c3d0991fde254c47b8ec84c9418 Mon Sep 17 00:00:00 2001
From: therockbot <therockbot@amd.com>
Date: Mon, 2 Nov 2026 15:59:26 +0000
Subject: [PATCH] fix(rocjitsu): suppress GCC -Wstringop-overflow false
 positives on ppc64le

GCC 13/14 on ppc64le emits false-positive -Wstringop-overflow for
std::array and std::optional element access when the loop bound or
index cannot be statically proven in-range after inlining at -O3.
Multiple sites are affected across the library and tests.

Add -Wno-error=stringop-overflow guarded to GCC on ppc64 targets in
both rj_configure_target.cmake and rj_add_object_library.cmake.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../rocjitsu/cmake/rj_add_object_library.cmake      | 13 +++++++++++++
 emulation/rocjitsu/cmake/rj_configure_target.cmake  | 13 +++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/emulation/rocjitsu/cmake/rj_add_object_library.cmake b/emulation/rocjitsu/cmake/rj_add_object_library.cmake
index 3a1dd2ae839..2057db75dfa 100644
--- a/emulation/rocjitsu/cmake/rj_add_object_library.cmake
+++ b/emulation/rocjitsu/cmake/rj_add_object_library.cmake
@@ -29,6 +29,19 @@ function(_rj_configure_object_library name)
                 PRIVATE -Wno-error=maybe-uninitialized
             )
         endif()
+        # GCC 13/14 on ppc64le emits false-positive -Wstringop-overflow
+        # for std::array and std::optional element access when the loop
+        # bound or index cannot be statically proven in-range after
+        # inlining (tensor_dma.h, memory_wait_scoreboard.cpp, etc.).
+        if(
+            CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
+            AND CMAKE_SYSTEM_PROCESSOR MATCHES "ppc64"
+        )
+            target_compile_options(
+                ${name}
+                PRIVATE -Wno-error=stringop-overflow
+            )
+        endif()
     endif()
 endfunction()
 
diff --git a/emulation/rocjitsu/cmake/rj_configure_target.cmake b/emulation/rocjitsu/cmake/rj_configure_target.cmake
index 041295fc2dc..34770e22882 100644
--- a/emulation/rocjitsu/cmake/rj_configure_target.cmake
+++ b/emulation/rocjitsu/cmake/rj_configure_target.cmake
@@ -93,6 +93,19 @@ function(rj_configure_target target)
                     PRIVATE -Wno-error=maybe-uninitialized
                 )
             endif()
+            # GCC 13/14 on ppc64le emits false-positive -Wstringop-overflow
+            # for std::array and std::optional element access when the loop
+            # bound or index cannot be statically proven in-range after
+            # inlining (tensor_dma.h, memory_wait_scoreboard.cpp, etc.).
+            if(
+                CMAKE_CXX_COMPILER_ID STREQUAL "GNU"
+                AND CMAKE_SYSTEM_PROCESSOR MATCHES "ppc64"
+            )
+                target_compile_options(
+                    ${target}
+                    PRIVATE -Wno-error=stringop-overflow
+                )
+            endif()
         endif()
     endif()
     if(ARG_HIDDEN)
-- 
