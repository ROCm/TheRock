From 8d105e38415e59b1b41351b7e3b3d6a0de9fda23 Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Mon, 27 Jul 2026 19:00:26 +0000
Subject: [PATCH] rdc: add ppc64le support

- Gate x86-specific compiler flags (-m64, -msse, -msse2) and library
  paths on x86_64 architecture.
- Default BUILD_ESMI to OFF on non-x86_64 since ESMI (CPU telemetry)
  is x86-only. Guard fetch_cpu_field_ behind ENABLE_ESMI_LIB.
- Guard x86intrin.h include and add ppc64le timebase support in
  RdcPerfTimer via __ppc_get_timebase_freq().

Co-Authored-By: Claude <noreply@anthropic.com>
---
 projects/rdc/CMakeLists.txt                      | 16 +++++++++++++---
 projects/rdc/example/CMakeLists.txt              |  5 ++++-
 .../include/rdc_lib/impl/RdcMetricFetcherImpl.h  |  2 ++
 .../rdc/rdc_libs/rdc/src/RdcMetricFetcherImpl.cc |  6 ++++++
 projects/rdc/rdc_libs/rdc/src/RdcPerfTimer.cc    | 10 ++++++++++
 5 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/projects/rdc/CMakeLists.txt b/projects/rdc/CMakeLists.txt
index 810c651d63..186a0f69b0 100755
--- a/projects/rdc/CMakeLists.txt
+++ b/projects/rdc/CMakeLists.txt
@@ -60,7 +60,10 @@ set_property(
 )
 
 # Set compile flags
-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra -m64 -msse -msse2")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra")
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|i.86")
+  string(APPEND CMAKE_CXX_FLAGS " -m64 -msse -msse2")
+endif()
 set(CMAKE_CXX_FLAGS_DEBUG
     "${CMAKE_CXX_FLAGS_DEBUG} -O0 -ggdb -DDEBUG"
     CACHE STRING
@@ -122,7 +125,11 @@ option(BUILD_EXAMPLES "Build examples" OFF)
 # Enable shared libraries for gtest
 option(BUILD_SHARED_LIBS "Build shared library (.so) or not." ON)
 
-option(BUILD_ESMI "Enable AMDSMI ESMI Library" ON)
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|i.86")
+  option(BUILD_ESMI "Enable AMDSMI ESMI Library" ON)
+else()
+  option(BUILD_ESMI "Enable AMDSMI ESMI Library" OFF)
+endif()
 if(BUILD_ESMI)
     add_definitions("-DENABLE_ESMI_LIB=1")
 endif()
@@ -167,7 +174,10 @@ set(GRPC_DESIRED_VERSION 1.78.1 CACHE STRING "GRPC desired package version.")
 
 # add package search paths
 list(APPEND CMAKE_PREFIX_PATH ${GRPC_ROOT} /usr/local)
-set(CMAKE_LIBRARY_PATH ${CMAKE_LIBRARY_PATH} /usr/lib64 /usr/lib/x86_64-linux-gnu)
+set(CMAKE_LIBRARY_PATH ${CMAKE_LIBRARY_PATH} /usr/lib64)
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64")
+  list(APPEND CMAKE_LIBRARY_PATH /usr/lib/x86_64-linux-gnu)
+endif()
 
 # configure packaging
 # cpack version is populated with CMAKE_PROJECT_VERSION implicitly
diff --git a/projects/rdc/example/CMakeLists.txt b/projects/rdc/example/CMakeLists.txt
index 378a200581..d119142247 100755
--- a/projects/rdc/example/CMakeLists.txt
+++ b/projects/rdc/example/CMakeLists.txt
@@ -32,7 +32,10 @@ option(CMAKE_VERBOSE_MAKEFILE "Enable verbose output" ON)
 option(CMAKE_EXPORT_COMPILE_COMMANDS "Export compile commands for linters and autocompleters" ON)
 
 # Set compile flags
-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra -m64 -msse -msse2")
+set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra")
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64|i.86")
+  string(APPEND CMAKE_CXX_FLAGS " -m64 -msse -msse2")
+endif()
 set(CMAKE_CXX_FLAGS_DEBUG
     "${CMAKE_CXX_FLAGS_DEBUG} -O0 -ggdb -DDEBUG"
     CACHE STRING
diff --git a/projects/rdc/include/rdc_lib/impl/RdcMetricFetcherImpl.h b/projects/rdc/include/rdc_lib/impl/RdcMetricFetcherImpl.h
index 8e6a38fcb2..78387186d0 100644
--- a/projects/rdc/include/rdc_lib/impl/RdcMetricFetcherImpl.h
+++ b/projects/rdc/include/rdc_lib/impl/RdcMetricFetcherImpl.h
@@ -97,7 +97,9 @@ class RdcMetricFetcherImpl final : public RdcMetricFetcher {
                                 amdsmi_processor_handle& processor_handle);
   rdc_status_t fetch_gpu_partition_field_(uint32_t gpu_index, rdc_field_t field_id,
                                           rdc_field_value* value);
+#ifdef ENABLE_ESMI_LIB
   rdc_status_t fetch_cpu_field_(uint32_t gpu_index, rdc_field_t field_id, rdc_field_value* value);
+#endif
 
   bool async_fetching = false;
 
diff --git a/projects/rdc/rdc_libs/rdc/src/RdcMetricFetcherImpl.cc b/projects/rdc/rdc_libs/rdc/src/RdcMetricFetcherImpl.cc
index 54253d652d..376b723206 100644
--- a/projects/rdc/rdc_libs/rdc/src/RdcMetricFetcherImpl.cc
+++ b/projects/rdc/rdc_libs/rdc/src/RdcMetricFetcherImpl.cc
@@ -1538,6 +1538,7 @@ rdc_status_t RdcMetricFetcherImpl::fetch_gpu_partition_field_(uint32_t gpu_index
   }
 }
 
+#ifdef ENABLE_ESMI_LIB
 rdc_status_t RdcMetricFetcherImpl::fetch_cpu_field_(uint32_t gpu_index, rdc_field_t field_id,
                                                     rdc_field_value* value) {
   amdsmi_processor_handle processor_handle = {};
@@ -1739,6 +1740,7 @@ rdc_status_t RdcMetricFetcherImpl::fetch_cpu_field_(uint32_t gpu_index, rdc_fiel
 
   return Smi2RdcError(static_cast<amdsmi_status_t>(value->status));
 }
+#endif  // ENABLE_ESMI_LIB
 
 rdc_status_t RdcMetricFetcherImpl::fetch_smi_field(uint32_t gpu_index, rdc_field_t field_id,
                                                    rdc_field_value* value) {
@@ -1798,7 +1800,11 @@ rdc_status_t RdcMetricFetcherImpl::fetch_smi_field(uint32_t gpu_index, rdc_field
   value->status = AMDSMI_STATUS_NOT_SUPPORTED;
   if (info.device_type == RDC_DEVICE_TYPE_CPU) {
     // don't care about partition for CPUs
+    #ifdef ENABLE_ESMI_LIB
     status = fetch_cpu_field_(gpu_index, field_id, value);
+    #else
+    status = RDC_ST_NOT_SUPPORTED;
+    #endif
   } else if (info.entity_role == RDC_DEVICE_ROLE_PARTITION_INSTANCE) {
     status = fetch_gpu_partition_field_(gpu_index, field_id, value);
   } else if (info.device_type == RDC_DEVICE_TYPE_GPU) {
diff --git a/projects/rdc/rdc_libs/rdc/src/RdcPerfTimer.cc b/projects/rdc/rdc_libs/rdc/src/RdcPerfTimer.cc
index 47277bcc56..9785cba07a 100644
--- a/projects/rdc/rdc_libs/rdc/src/RdcPerfTimer.cc
+++ b/projects/rdc/rdc_libs/rdc/src/RdcPerfTimer.cc
@@ -22,7 +22,11 @@ THE SOFTWARE.
 
 #include "rdc_lib/RdcPerfTimer.h"
 
+#if defined(__x86_64__) || defined(__i386__)
 #include <x86intrin.h>
+#elif defined(__powerpc64__)
+#include <sys/platform/ppc.h>
+#endif
 
 namespace amd {
 namespace rdc {
@@ -141,6 +145,7 @@ uint64_t RdcPerfTimer::CoarseTimestampUs() {
 }
 
 uint64_t RdcPerfTimer::MeasureTSCFreqHz() {
+#if defined(__x86_64__) || defined(__i386__)
   // Make a coarse interval measurement of TSC ticks for 1 gigacycles.
   unsigned int unused;
   uint64_t tscTicksEnd;
@@ -158,6 +163,11 @@ uint64_t RdcPerfTimer::MeasureTSCFreqHz() {
   uint64_t coarseIntervalNs = (coarseEndUs - coarseBeginUs) * 1000;
   uint64_t tscIntervalTicks = tscTicksEnd - tscTicksBegin;
   return (tscIntervalTicks * 10 + (coarseIntervalNs / 2)) / coarseIntervalNs;
+#elif defined(__powerpc64__)
+  return __ppc_get_timebase_freq() / 100000000;
+#else
+#error "Unsupported architecture"
+#endif
 }
 
 }  // namespace rdc
-- 
