From b47c476ca863e33ddf73cc0e342d22422ee6b519 Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Wed, 19 Aug 2026 15:51:00 +0000
Subject: [PATCH] rccl: use memcpy instead of ncclGdrCudaRead in portable GDC
 flush path

ncclGdrCudaRead is not available when __HIP_PLATFORM_AMD__ is defined.
Use memcpy instead in the portable (non-x86) fallback path.
---
 projects/rccl/src/transport/coll_net.cc | 6 +++---
 projects/rccl/src/transport/net.cc      | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/projects/rccl/src/transport/coll_net.cc b/projects/rccl/src/transport/coll_net.cc
index 273b86c8bca..bf3f0b0acb6 100644
--- a/projects/rccl/src/transport/coll_net.cc
+++ b/projects/rccl/src/transport/coll_net.cc
@@ -1277,11 +1277,11 @@ static ncclResult_t recvProxyProgress(struct ncclProxyState* proxyState, struct
               // Force a PCI-E read from GPU memory
               asm volatile("mov (%0), %%eax" ::"l"(resources->gdcFlush) : "%eax", "memory");
 #else
-              // Portable equivalent. seq_cst fence keeps the load inside
-              // ncclGdrCudaRead from being reordered ahead of the CQE poll.
+              // Portable equivalent. seq_cst fence keeps the memcpy read
+              // from being reordered ahead of the CQE poll.
               std::atomic_thread_fence(std::memory_order_seq_cst);
               uint64_t dummy;
-              NCCLCHECK(ncclGdrCudaRead(resources->gdrDesc, &dummy, resources->gdcFlush, sizeof(dummy)));
+              memcpy(&dummy, resources->gdcFlush, sizeof(dummy));
 #endif
             } else {
               NCCLCHECK(collNetRecvFlush(proxyState, resources, args, sub, groupStart, totalSize, recvBeg,
diff --git a/projects/rccl/src/transport/net.cc b/projects/rccl/src/transport/net.cc
index 0a58bdc7404..c382dcdd344 100644
--- a/projects/rccl/src/transport/net.cc
+++ b/projects/rccl/src/transport/net.cc
@@ -2097,11 +2097,11 @@ static ncclResult_t recvProxyProgress(struct ncclProxyState* proxyState, struct
                 INFO(NCCL_INIT, "%s: issued GDC flush", __func__);
               }
 #else
-              // Portable equivalent. seq_cst fence keeps the load inside
-              // ncclGdrCudaRead from being reordered ahead of the CQE poll.
+              // Portable equivalent. seq_cst fence keeps the memcpy read
+              // from being reordered ahead of the CQE poll.
               std::atomic_thread_fence(std::memory_order_seq_cst);
               uint64_t dummy;
-              NCCLCHECK(ncclGdrCudaRead(resources->gdrDesc, &dummy, resources->gdcFlush, sizeof(dummy)));
+              memcpy(&dummy, resources->gdcFlush, sizeof(dummy));
 #endif
             } else {
               int subCount = 0;
-- 
2.52.0

