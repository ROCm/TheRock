From 2d2b780a335cce339b14d84490b7acd9de6cb985 Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Thu, 20 Aug 2026 17:55:08 +0000
Subject: [PATCH] rccl: add ncclGdrCudaRead to the HIP/AMD GDR wrapper

The NCCL v2.30.7 sync introduced a portable (non-x86) GDC flush path
that calls ncclGdrCudaRead, but this function was never implemented in
the __HIP_PLATFORM_AMD__ branch of gdrwrap.h. This causes a build
failure on any non-x86 AMD/HIP platform.

Add the missing function, consistent with ncclGdrCudaCopy which also
uses a plain memcpy since the AMD path allocates CPU-accessible
fine-grained device memory rather than using gdrcopy.
---
 projects/rccl/src/include/gdrwrap.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/projects/rccl/src/include/gdrwrap.h b/projects/rccl/src/include/gdrwrap.h
index 2db5241434a..a40bf82a533 100644
--- a/projects/rccl/src/include/gdrwrap.h
+++ b/projects/rccl/src/include/gdrwrap.h
@@ -249,6 +249,11 @@ static ncclResult_t ncclGdrCudaCopy(void *gdrHandle, T* dst, T* src, size_t nele
   return ncclSuccess;
 }
 
+static ncclResult_t ncclGdrCudaRead(void* gdrHandle, void* dst, const void* src, size_t size) {
+  memcpy(dst, src, size);
+  return ncclSuccess;
+}
+
 static ncclResult_t ncclGdrCudaFree(void* gdrHandle, struct ncclMemManager* manager) {
   gdr_mem_desc_t *md = (gdr_mem_desc_t*)gdrHandle;
   NCCLCHECK(ncclCudaFree(md->gdrDevMem, manager));
-- 
2.52.0

