-
 FILE *
 dd_get_file_stream(struct dd_screen *dscreen, unsigned apitrace_call_number)
 {
diff --git a/src/gallium/auxiliary/driver_ddebug/dd_util.c b/src/gallium/auxiliary/driver_ddebug/dd_util.c
new file mode 100644
index 00000000000..a074aba466b
--- /dev/null
+++ b/src/gallium/auxiliary/driver_ddebug/dd_util.c
@@ -0,0 +1,116 @@
