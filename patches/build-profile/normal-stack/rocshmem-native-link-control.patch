From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sahil Faizal <safaizal@amd.com>
Date: Sat, 31 Oct 2026 00:00:00 +0000
Subject: [PATCH] rocshmem: control final native device link concurrency only

Keep compilation, architecture coverage, dependencies and default behavior
unchanged. A controlled TheRock experiment compares this option at 1 and 2.

---
--- a/projects/rocshmem/CMakeLists.txt
+++ b/projects/rocshmem/CMakeLists.txt
@@ -63,6 +63,28 @@
 option(BUILD_UNIT_TESTS "Build the unit tests (Requires MPI)" OFF)
 option(BUILD_TESTS_ONLY "Build only tests. Used to link against rocSHMEM in a ROCm Release" OFF)
 option(BUILD_TOOLS "Build binary tools (e.g., rocshmem_info)" ON)
+
+# Limit this control to final native executable device links. The HIP-wide
+# HIP_CLANG_NUM_PARALLEL_JOBS control also changes compilation options.
+set(ROCSHMEM_NATIVE_LINK_JOBS "1" CACHE STRING
+    "Parallel architecture groups in native executable device links")
+if(NOT ROCSHMEM_NATIVE_LINK_JOBS MATCHES "^[1-9][0-9]*$")
+  message(FATAL_ERROR "ROCSHMEM_NATIVE_LINK_JOBS must be a positive integer")
+endif()
+
+function(_rocshmem_set_native_link_jobs target)
+  if(ROCSHMEM_NATIVE_LINK_JOBS GREATER 1)
+    if(NOT HIP_CLANG_SUPPORTS_PARALLEL_JOBS)
+      message(FATAL_ERROR "ROCSHMEM_NATIVE_LINK_JOBS requires HIP --offload-jobs support")
+    endif()
+    if(DEFINED HIP_CLANG_NUM_PARALLEL_JOBS AND HIP_CLANG_NUM_PARALLEL_JOBS GREATER 1)
+      message(FATAL_ERROR "Use ROCSHMEM_NATIVE_LINK_JOBS with HIP_CLANG_NUM_PARALLEL_JOBS=1")
+    endif()
+    target_link_options(${target} PRIVATE
+      "--offload-jobs=${ROCSHMEM_NATIVE_LINK_JOBS}")
+  endif()
+endfunction()
+
 option(BUILD_CTESTS "Register tests with CTest for tier-based execution" ON)
 
 option(BUILD_LOCAL_GPU_TARGET_ONLY "Build only for GPUs detected on this machine" OFF)
--- a/projects/rocshmem/tools/CMakeLists.txt
+++ b/projects/rocshmem/tools/CMakeLists.txt
@@ -30,3 +30,5 @@
   PRIVATE
     roc::rocshmem
 )
+
+_rocshmem_set_native_link_jobs(rocshmem_info)
--- a/projects/rocshmem/tests/functional_tests/CMakeLists.txt
+++ b/projects/rocshmem/tests/functional_tests/CMakeLists.txt
@@ -127,6 +127,8 @@
     hiprtc
 )
 
+_rocshmem_set_native_link_jobs(${PROJECT_NAME})
+
 ###############################################################################
 # ASAN SETTINGS
 ###############################################################################
