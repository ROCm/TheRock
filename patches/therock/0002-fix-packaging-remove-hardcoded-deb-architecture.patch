From 91789ce492e4b8e2e95053ccc3f825c836afc102 Mon Sep 17 00:00:00 2001
From: benrichard-amd <ben.richard@amd.com>
Date: Wed, 4 Nov 2026 20:44:34 +0000
Subject: [PATCH] fix(packaging): remove hardcoded amd64 Architecture from DEB
 packaging

package.json hardcodes Architecture: amd64 in all entries, which
produces incorrect DEB packages on non-x86 hosts. Remove the field
and add _deb_host_arch() to deb_package.py using dpkg --print-architecture
with a fallback map from platform.machine().

Co-Authored-By: Claude <noreply@anthropic.com>
---
 build_tools/packaging/linux/deb_package.py | 22 +++++-
 build_tools/packaging/linux/package.json   | 82 ----------------------
 2 files changed, 21 insertions(+), 83 deletions(-)

diff --git a/build_tools/packaging/linux/deb_package.py b/build_tools/packaging/linux/deb_package.py
index b44999dd8..f9bf048f9 100644
--- a/build_tools/packaging/linux/deb_package.py
+++ b/build_tools/packaging/linux/deb_package.py
@@ -21,6 +21,26 @@ from _therock_utils.log_utils import TheRockLogger
 
 logger = TheRockLogger(__name__)
 
+
+def _deb_host_arch():
+    """Return the Debian architecture name for the current host.
+
+    Uses dpkg if available (canonical), otherwise maps platform.machine().
+    """
+    try:
+        return subprocess.check_output(
+            ["dpkg", "--print-architecture"], text=True
+        ).strip()
+    except (FileNotFoundError, subprocess.CalledProcessError):
+        import platform
+        _DEB_ARCH_MAP = {
+            "x86_64": "amd64",
+            "aarch64": "arm64",
+            "ppc64le": "ppc64el",
+        }
+        machine = platform.machine()
+        return _DEB_ARCH_MAP.get(machine, machine)
+
 # Setup paths
 SCRIPT_DIR = Path(__file__).resolve().parent
 
@@ -340,7 +360,7 @@ def generate_control_file(pkg_info, deb_dir, config: PackageConfig):
         "source": pkg_name,
         "depends": depends,
         "pkg_name": pkg_name,
-        "arch": pkg_info.get("Architecture"),
+        "arch": pkg_info.get("Architecture") or _deb_host_arch(),
         "description_short": pkg_info.get("Description_Short"),
         "description_long": pkg_info.get("Description_Long"),
         "homepage": pkg_info.get("Homepage"),
