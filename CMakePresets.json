{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux-release-package",
      "displayName": "Linux release packages",
      "description": "Ninja generator, default compiler, RelWithDebInfo for most subprojects",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "amd-llvm_BUILD_TYPE": "Release",
        "therock-host-blas_BUILD_TYPE": "Release",
        "therock-SuiteSparse_BUILD_TYPE": "Release",
        "THEROCK_SPLIT_DEBUG_INFO": "ON",
        "THEROCK_MINIMAL_DEBUG_INFO": "ON",
        "THEROCK_QUIET_INSTALL": "OFF",
        "THEROCK_FLAG_STAMP_LIBRARY_GIT_VERSIONS": "ON"
      }
    },
    {
      "name": "linux-asan-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "amd-llvm_BUILD_TYPE": "Release",
        "therock-host-blas_BUILD_TYPE": "Release",
        "therock-SuiteSparse_BUILD_TYPE": "Release",
        "THEROCK_SANITIZER": "ASAN",
        "amd-llvm_SANITIZER": "OFF",
        "amd-comgr_SANITIZER": "ASAN",
        "hipcc_SANITIZER": "OFF",
        "hipify_SANITIZER": "OFF",
        "aqlprofile_SANITIZER": "OFF",
        "rocprof-trace-decoder_SANITIZER": "OFF",
        "roctracer_SANITIZER": "OFF",
        "THEROCK_FLAG_STAMP_LIBRARY_GIT_VERSIONS": "ON"
      },
      "description": "Hidden base for full ASAN variants. Sets all sanitizer flags and per-subproject overrides. Variants inherit this and only set CMAKE_BUILD_TYPE (and optionally debug flags)."
    },
    {
      "name": "linux-host-asan-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "amd-llvm_BUILD_TYPE": "Release",
        "therock-host-blas_BUILD_TYPE": "Release",
        "therock-SuiteSparse_BUILD_TYPE": "Release",
        "THEROCK_SANITIZER": "HOST_ASAN",
        "amd-llvm_SANITIZER": "OFF",
        "amd-comgr_SANITIZER": "HOST_ASAN",
        "hipcc_SANITIZER": "OFF",
        "hipify_SANITIZER": "OFF",
        "aqlprofile_SANITIZER": "OFF",
        "rocprof-trace-decoder_SANITIZER": "OFF",
        "roctracer_SANITIZER": "OFF",
        "THEROCK_FLAG_STAMP_LIBRARY_GIT_VERSIONS": "ON"
      },
      "description": "Hidden base for host-only ASAN variants. Like linux-asan-base but scopes instrumentation to host code only (no device-side, no xnack+ required)."
    },
    {
      "name": "linux-release-asan",
      "displayName": "Linux release ASAN build (no debug info)",
      "description": "CI builds: Release + full ASAN, no debug info. Inherits linux-asan-base.",
      "inherits": "linux-asan-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release-asan-debug",
      "displayName": "Linux release ASAN build with debug info",
      "description": "Nightly/release builds: RelWithDebInfo + full ASAN + -g1 -gdwarf-4 for stack traces. Inherits linux-asan-base.",
      "inherits": "linux-asan-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g1 -gdwarf-4",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g1 -gdwarf-4",
        "CMAKE_CXX_FLAGS": "-g1 -gdwarf-4",
        "CMAKE_C_FLAGS": "-g1 -gdwarf-4"
      }
    },
    {
      "name": "linux-release-host-asan",
      "displayName": "Linux release host-only ASAN build (no debug info)",
      "description": "CI builds: Release + host-only ASAN, no debug info. Inherits linux-host-asan-base.",
      "inherits": "linux-host-asan-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-release-host-asan-debug",
      "displayName": "Linux release host-only ASAN build with debug info",
      "description": "Nightly/release builds: RelWithDebInfo + host-only ASAN + -g1 -gdwarf-4 for stack traces. Inherits linux-host-asan-base.",
      "inherits": "linux-host-asan-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g1 -gdwarf-4",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g1 -gdwarf-4",
        "CMAKE_CXX_FLAGS": "-g1 -gdwarf-4",
        "CMAKE_C_FLAGS": "-g1 -gdwarf-4"
      }
    },
    {
      "name": "linux-release-tsan",
      "displayName": "Linux release tsan build",
      "description": "Ninja generator, default compiler, RelWithDebInfo and TSAN for most runtime subprojects",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "amd-llvm_BUILD_TYPE": "Release",
        "therock-host-blas_BUILD_TYPE": "Release",
        "therock-SuiteSparse_BUILD_TYPE": "Release",
        "THEROCK_SANITIZER": "TSAN",
        "amd-llvm_SANITIZER": "OFF",
        "amd-comgr_SANITIZER": "OFF",
        "hipcc_SANITIZER": "OFF",
        "hipify_SANITIZER": "OFF",
        "aqlprofile_SANITIZER": "OFF",
        "rocprof-trace-decoder_SANITIZER": "OFF",
        "rocprofiler-sdk_SANITIZER": "OFF",
        "roctracer_SANITIZER": "OFF",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g1 -gdwarf-4",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g1 -gdwarf-4",
        "CMAKE_CXX_FLAGS": "-g1 -gdwarf-4",
        "CMAKE_C_FLAGS": "-g1 -gdwarf-4",
        "THEROCK_FLAG_STAMP_LIBRARY_GIT_VERSIONS": "ON"
      }
    },
    {
      "name": "windows-base",
      "displayName": "Windows base preset",
      "description": "Ninja generator, MSVC (cl.exe), x64 architecture",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "architecture": {
        "value": "host=x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_LINKER": "link.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows release builds preset",
      "description": "Ninja generator, MSVC (cl.exe), x64 architecture, Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "THEROCK_FLAG_STAMP_LIBRARY_GIT_VERSIONS": "ON"
      },
      "inherits": [
        "windows-base"
      ]
    }
  ]
}
